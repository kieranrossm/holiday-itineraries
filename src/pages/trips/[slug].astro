---
import { sanityClient } from "sanity:client";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(`*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] { "slug": slug.current }`);
  return data.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const query = `*[_type == "trip" && slug.current == $slug][0] {
  title,
  startDate,
  heroIntro,
  heroWeatherForecast {
    enabled,
    locationName,
    coordinates
  },
  "heroImageUrl": heroImage.asset->url,
  sections[] {
    sectionTitle,
    sectionIntro,
    "sectionImageUrl": sectionImage.asset->url,
    layoutStyle,
    initialLoadState,
    weatherForecast {
      enabled,
      locationName,
      coordinates
    },
    places[] {
      placeName,
      time,
      endTime,
      category,
      area,
      shortDescription,
      info,
      practicalInfo,
      costStructure,
      bookingLogistics,
      paymentStatus,
      bookingUrl,
      websiteUrl,
      travelNote,
      "photoUrl": photo.asset->url,
      coordinates,
      transitDetails,
      hotelDetails
    }
  }
}`;

const trip = await sanityClient.fetch(query, { slug });

if (!trip) {
  return Astro.redirect("/404");
}

const EXCHANGE_RATES: Record<string, number> = {
  EUR: 0.85,
  CNY: 0.11,
  JPY: 0.0052,
  CHF: 0.88,
  GBP: 1.0,
};

const CURRENCY_SYMBOLS: Record<string, string> = {
  EUR: "€",
  CNY: "¥",
  JPY: "¥",
  CHF: "CHF ",
  GBP: "£",
};

const formatCost = (costObj: any) => {
  if (!costObj) return "";
  const { localAmount, currencyType, textFallback } = costObj;

  if (localAmount !== undefined && localAmount !== null) {
    const symbol = CURRENCY_SYMBOLS[currencyType] || "£";
    const localFormatted = `${symbol}${localAmount.toLocaleString("en-GB")}`;

    if (currencyType === "GBP") return localFormatted;

    const rate = EXCHANGE_RATES[currencyType] || 1;
    const gbpEquivalent = Math.round(localAmount * rate);
    return `${localFormatted} (£${gbpEquivalent.toLocaleString("en-GB")})`;
  }

  return textFallback || "";
};

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const formatInlineDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};

const getBookingActionCount = (section: any) => {
  return (section.places || []).filter((place: any) => place.bookingLogistics?.bookingStatus === "to-book").length;
};

const getSectionSummary = (section: any) => {
  const placeCount = section.places?.length || 0;
  const bookingActions = getBookingActionCount(section);

  if (placeCount === 0) return "Plans still taking shape";

  const itemLabel = placeCount === 1 ? "stop" : "stops";
  const bookingSummary = bookingActions === 0
    ? "No booking actions"
    : `${bookingActions} ${bookingActions === 1 ? "booking action" : "booking actions"}`;
  return `${placeCount} ${itemLabel} mapped • ${bookingSummary}`;
};

const getCategoryClass = (category: string | undefined) => {
  if (!category) return "other";
  return category.toLowerCase().replace(/[^a-z0-9]+/g, "-");
};

const isTransitCategory = (category: string | undefined) => {
  return category === "Transport" || category === "Transit";
};

const hasWeatherForecast = (forecast: any) => {
  return Boolean(forecast?.enabled && (forecast.locationName || forecast.coordinates?.lat !== undefined));
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{trip.title} | Trip Execution Plan</title>

    <style>
