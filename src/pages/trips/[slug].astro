---
import { sanityClient } from "sanity:client";

const weatherProjection = `
  weatherConfig {
    enabled,
    locationLabel,
    latitude,
    longitude,
    iconSet {
      "sunnyUrl": sunny.asset->url,
      "partlyCloudyUrl": partlyCloudy.asset->url,
      "cloudyUrl": cloudy.asset->url,
      "fogUrl": fog.asset->url,
      "drizzleUrl": drizzle.asset->url,
      "rainUrl": rain.asset->url,
      "heavyRainUrl": heavyRain.asset->url,
      "snowUrl": snow.asset->url,
      "thunderstormUrl": thunderstorm.asset->url
    }
  }
`;

const tripProjection = `{
  title,
  "slug": slug.current,
  startDate,
  heroIntro,
  "heroImageUrl": heroImage.asset->url,
  ${weatherProjection},
  sections[] {
    sectionTitle,
    sectionIntro,
    "sectionImageUrl": sectionImage.asset->url,
    layoutStyle,
    initialLoadState,
    ${weatherProjection},
    places[] {
      category,
      placeName,
      time,
      endTime,
      transitDetails {
        origin,
        destination,
        carrier,
        bookingDetailsText,
        airportParkingLogistics {
          status,
          locationInfo
        }
      },
      hotelDetails {
        roomType,
        checkInNotes
      },
      area,
      shortDescription,
      info,
      practicalInfo,
      costStructure {
        localAmount,
        currencyType,
        textFallback,
        cancellationPolicy,
        cancellationDeadline
      },
      bookingLogistics {
        bookingStatus,
        bookOnDate
      },
      paymentStatus,
      bookingUrl,
      websiteUrl,
      travelNote,
      "photoUrl": photo.asset->url,
      coordinates
    }
  }
}`;

export async function getStaticPaths() {
  const trips = await sanityClient.fetch(
    `*[_type == "trip" && defined(slug.current) && (!defined(displayStatus) || displayStatus == "visible")] | order(startDate asc) ${tripProjection}`
  );

  return trips.map((trip) => ({
    params: { slug: trip.slug },
    props: { trip },
  }));
}

const { trip } = Astro.props;

const formatDate = (dateString) => {
  if (!dateString) return "";

  const date = new Date(`${dateString}T00:00:00`);

  if (Number.isNaN(date.getTime())) {
    return dateString;
  }

  return date.toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const formatShortDate = (dateString) => {
  if (!dateString) return "";

  const date = new Date(`${dateString}T00:00:00`);

  if (Number.isNaN(date.getTime())) {
    return dateString;
  }

  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};

const slugify = (value = "") =>
  value
    .toString()
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const hasWeatherConfig = (weatherConfig) =>
  Boolean(
    weatherConfig?.enabled &&
      typeof weatherConfig.latitude === "number" &&
      typeof weatherConfig.longitude === "number"
  );

const getSectionSummary = (section) => {
  const places = Array.isArray(section?.places) ? section.places : [];
  const mappedStops = places.filter((place) => hasCoordinates(place)).length;
  const bookingActions = places.filter(
    (place) => place?.bookingLogistics?.bookingStatus === "to-book"
  ).length;

  return {
    totalStops: places.length,
    mappedStops,
    bookingActions,
  };
};

const hasCoordinates = (place) =>
  typeof place?.coordinates?.lat === "number" && typeof place?.coordinates?.lng === "number";

const getMapUrl = (coordinates) => {
  if (!coordinates || typeof coordinates.lat !== "number" || typeof coordinates.lng !== "number") {
    return "";
  }

  return `https://www.google.com/maps/search/?api=1&query=${coordinates.lat},${coordinates.lng}`;
};

const getCategoryIcon = (category) => {
  const icons = {
    Transit: "✈️",
    Transport: "✈️",
    Hotel: "🏨",
    Attraction: "🎟️",
    Museum: "🏛️",
    Food: "🍽️",
    Bar: "🍸",
    Walk: "🚶",
    Shopping: "🛍️",
    Viewpoint: "📷",
    Other: "✨",
  };

  return icons[category] || "📍";
};

const formatTimeRange = (place) => {
  if (place?.time && place?.endTime) return `${place.time} to ${place.endTime}`;
  if (place?.time) return place.time;
  if (place?.endTime) return `Until ${place.endTime}`;
  return "";
};

const formatCost = (costStructure) => {
  if (!costStructure) return "";
  if (costStructure.textFallback) return costStructure.textFallback;

  if (typeof costStructure.localAmount !== "number") {
    return "";
  }

  const symbols = {
    EUR: "€",
    CNY: "¥",
    JPY: "¥",
    CHF: "CHF ",
    GBP: "£",
  };

  const currency = costStructure.currencyType || "EUR";
  const symbol = symbols[currency] || `${currency} `;

  return `${symbol}${costStructure.localAmount.toLocaleString("en-GB")}`;
};

const getCancellationText = (costStructure) => {
  if (!costStructure?.cancellationPolicy) return "";

  if (costStructure.cancellationPolicy === "free") {
    const deadline = costStructure.cancellationDeadline
      ? ` until ${formatShortDate(costStructure.cancellationDeadline)}`
      : "";

    return `Free cancellation${deadline}`;
  }

  if (costStructure.cancellationPolicy === "non-refundable") {
    return "Non-refundable";
  }

  return "";
};

const getBookingStatus = (place) => {
  const status = place?.bookingLogistics?.bookingStatus || "not-needed";

  if (status === "booked") {
    return {
      label: "Booked",
      className: "status-good",
    };
  }

  if (status === "to-book") {
    const bookDate = place?.bookingLogistics?.bookOnDate
      ? ` from ${formatShortDate(place.bookingLogistics.bookOnDate)}`
      : "";

    return {
      label: `To book${bookDate}`,
      className: "status-warning",
    };
  }

  return {
    label: "No booking needed",
    className: "status-muted",
  };
};

const getPaymentStatus = (place) => {
  const status = place?.paymentStatus || "na";

  if (status === "paid") {
    return {
      label: "Paid",
      className: "status-good",
    };
  }

  if (status === "unpaid") {
    return {
      label: "Payment outstanding",
      className: "status-warning",
    };
  }

  return {
    label: "No payment needed",
    className: "status-muted",
  };
};

const sections = Array.isArray(trip?.sections) ? trip.sections : [];
const pageTitle = trip?.title ? `${trip.title} | Holiday Itineraries` : "Holiday Itinerary";
const pageDescription = trip?.heroIntro || "Detailed holiday itinerary.";
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #0f172a;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue: #1d4ed8;
        --blue-soft: #dbeafe;
        --green: #15803d;
        --green-soft: #dcfce7;
        --amber: #b45309;
        --amber-soft: #fef3c7;
        --shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        color: var(--ink);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background:
          radial-gradient(circle at top left, rgba(219, 234, 254, 0.8), transparent 34rem),
          var(--page-bg);
      }

      a {
        color: inherit;
      }

      img {
        display: block;
        max-width: 100%;
      }

      .page-shell {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 1.5rem 0 4rem;
      }

      .top-nav {
        margin-bottom: 1rem;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--muted);
        font-size: 0.95rem;
        font-weight: 750;
        text-decoration: none;
      }

      .back-link:hover {
        color: var(--blue);
      }

      .trip-hero {
        overflow: hidden;
        margin-bottom: 2rem;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        border: 1px solid var(--soft);
        border-radius: 32px;
        background: rgba(255, 255, 255, 0.88);
        box-shadow: var(--shadow);
      }

      .hero-eyebrow,
      .section-kicker {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 850;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero-title {
        max-width: 850px;
        margin: 0;
        font-size: clamp(2.6rem, 8vw, 5.5rem);
        line-height: 0.92;
        letter-spacing: -0.075em;
      }

      .departure-date {
        margin: 1rem 0 0;
        color: #334155;
        font-size: 1.05rem;
        font-weight: 750;
      }

      .hero-image {
        width: 100%;
        height: clamp(260px, 48vw, 520px);
        margin-top: 1.5rem;
        object-fit: cover;
        border-radius: 24px;
        background: var(--soft-2);
      }

      .hero-intro {
        max-width: 820px;
        margin: 1.4rem 0 0;
        color: #475569;
        font-size: clamp(1rem, 2vw, 1.18rem);
        line-height: 1.7;
      }

      .weather-card {
        margin-top: 1.4rem;
        padding: 1rem;
        border: 1px solid var(--soft);
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(219, 234, 254, 0.75), rgba(255, 255, 255, 0.95));
      }

      .weather-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: baseline;
        margin-bottom: 0.85rem;
      }

      .weather-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 850;
      }

      .weather-subtitle {
        margin: 0.15rem 0 0;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 650;
      }

      .weather-status {
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 700;
        text-align: right;
      }

      .weather-days {
        display: grid;
        grid-template-columns: repeat(7, minmax(92px, 1fr));
        gap: 0.65rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .weather-day {
        min-height: 122px;
        padding: 0.75rem;
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.72);
      }

      .weather-date {
        color: #334155;
        font-size: 0.74rem;
        font-weight: 800;
      }

      .weather-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.1rem;
        height: 2.1rem;
        margin: 0.5rem 0;
        font-size: 1.55rem;
      }

      .weather-icon img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .weather-temp {
        font-size: 0.86rem;
        font-weight: 850;
      }

      .weather-label {
        margin-top: 0.25rem;
        color: var(--muted);
        font-size: 0.72rem;
        line-height: 1.25;
      }

      .sections-list {
        display: grid;
        gap: 2rem;
      }

      .trip-section {
        padding: clamp(1.2rem, 3vw, 2rem);
        border: 1px solid var(--soft);
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 12px 38px rgba(15, 23, 42, 0.05);
      }

      .section-heading {
        margin-bottom: 1rem;
      }

      .section-heading h2 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.4rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      .section-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.9rem;
      }

      .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.42rem 0.65rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        color: #475569;
        background: #fff;
        font-size: 0.82rem;
        font-weight: 750;
      }

      .section-image {
        width: 100%;
        height: clamp(220px, 38vw, 420px);
        object-fit: cover;
        border-radius: 22px;
        background: var(--soft-2);
      }

      .section-intro {
        margin-top: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid var(--soft);
        border-radius: 20px;
        background: #fff;
      }

      .section-intro p {
        max-width: 820px;
        margin: 0;
        color: #475569;
        font-size: 1rem;
        line-height: 1.7;
      }

      .plans-drawer {
        margin-top: 1.2rem;
        border: 1px solid var(--soft);
        border-radius: 22px;
        background: #fff;
        overflow: hidden;
      }

      .plans-drawer summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        cursor: pointer;
        font-weight: 850;
        list-style: none;
      }

      .plans-drawer summary::-webkit-details-marker {
        display: none;
      }

      .summary-count {
        color: var(--muted);
        font-size: 0.85rem;
        font-weight: 700;
      }

      .summary-chevron {
        display: inline-flex;
        transition: transform 0.2s ease;
      }

      .plans-drawer[open] .summary-chevron {
        transform: rotate(180deg);
      }

      .places-grid,
      .timeline-list {
        padding: 0 1.1rem 1.1rem;
      }

      .places-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      .timeline-list {
        display: grid;
        gap: 1rem;
      }

      .place-card {
        position: relative;
        padding: 1rem;
        border: 1px solid var(--soft);
        border-radius: 20px;
        background: var(--card-bg);
      }

      .timeline-list .place-card {
        padding-left: 1.25rem;
      }

      .timeline-list .place-card::before {
        content: "";
        position: absolute;
        top: 1.1rem;
        left: -0.45rem;
        width: 0.85rem;
        height: 0.85rem;
        border: 3px solid #fff;
        border-radius: 999px;
        background: var(--blue);
        box-shadow: 0 0 0 1px var(--blue);
      }

      .place-card-header {
        margin-bottom: 0.8rem;
      }

      .category-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
      }

      .category-pill,
      .time-pill,
      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.36rem 0.55rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 800;
      }

      .category-pill {
        color: #1e3a8a;
        background: var(--blue-soft);
      }

      .time-pill {
        color: #334155;
        background: var(--soft-2);
      }

      .place-card h3 {
        margin: 0;
        font-size: 1.35rem;
        line-height: 1.1;
        letter-spacing: -0.035em;
      }

      .place-area {
        margin: 0.35rem 0 0;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .place-image {
        width: 100%;
        height: 190px;
        object-fit: cover;
        margin-bottom: 0.9rem;
        border-radius: 16px;
        background: var(--soft-2);
      }

      .place-copy {
        display: grid;
        gap: 0.55rem;
        margin: 0.8rem 0;
      }

      .place-copy p {
        margin: 0;
        color: #475569;
        line-height: 1.55;
      }

      .info-box,
      .detail-box {
        margin-top: 0.8rem;
        padding: 0.85rem;
        border: 1px solid var(--soft);
        border-radius: 16px;
        background: var(--soft-2);
      }

      .info-box strong,
      .detail-box strong {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .info-box p,
      .detail-box p {
        margin: 0;
        color: #475569;
        line-height: 1.5;
      }

      .detail-list {
        display: grid;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
        color: #475569;
        font-size: 0.92rem;
      }

      .status-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.9rem;
      }

      .status-good {
        color: var(--green);
        background: var(--green-soft);
      }

      .status-warning {
        color: var(--amber);
        background: var(--amber-soft);
      }

      .status-muted {
        color: #475569;
        background: var(--soft-2);
      }

      .place-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 1rem;
      }

      .place-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.55rem 0.75rem;
        border-radius: 999px;
        color: #fff;
        background: var(--blue);
        font-size: 0.85rem;
        font-weight: 850;
        text-decoration: none;
      }

      .place-link.secondary {
        color: var(--blue);
        background: var(--blue-soft);
      }

      .empty-section,
      .empty-page {
        padding: 1.25rem;
        border: 1px dashed var(--soft);
        border-radius: 18px;
        color: var(--muted);
        background: #fff;
      }

      .empty-page {
        margin-top: 2rem;
        text-align: center;
      }

      @media (max-width: 860px) {
        .weather-days {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        .page-shell {
          width: min(100% - 1rem, 1120px);
          padding-top: 1rem;
        }

        .trip-hero,
        .trip-section {
          border-radius: 24px;
        }

        .weather-header,
        .plans-drawer summary {
          align-items: flex-start;
          flex-direction: column;
        }

        .weather-status {
          text-align: left;
        }

        .weather-days {
          grid-template-columns: 1fr;
        }

        .hero-title {
          letter-spacing: -0.055em;
        }
      }
    </style>
  </head>

  <body>
    <div class="page-shell">
      <nav class="top-nav" aria-label="Breadcrumb">
        <a href="/" class="back-link">← Back to All Itineraries</a>
      </nav>

      {trip ? (
        <main>
          <article>
            <header class="trip-hero">
              <p class="hero-eyebrow">Holiday itinerary</p>
              <h1 class="hero-title">{trip.title}</h1>

              {trip.startDate && (
                <p class="departure-date">Departure: {formatDate(trip.startDate)}</p>
              )}

              {trip.heroImageUrl && (
                <img
                  src={trip.heroImageUrl}
                  alt=""
                  class="hero-image"
                  loading="eager"
                />
              )}

              {trip.heroIntro && (
                <p class="hero-intro">{trip.heroIntro}</p>
              )}

              {hasWeatherConfig(trip.weatherConfig) && (
                <section
                  class="weather-card js-weather-card"
                  data-location={trip.weatherConfig.locationLabel || trip.title}
                  data-lat={trip.weatherConfig.latitude}
                  data-lon={trip.weatherConfig.longitude}
                  data-icon-sunny={trip.weatherConfig.iconSet?.sunnyUrl || ""}
                  data-icon-partly-cloudy={trip.weatherConfig.iconSet?.partlyCloudyUrl || ""}
                  data-icon-cloudy={trip.weatherConfig.iconSet?.cloudyUrl || ""}
                  data-icon-fog={trip.weatherConfig.iconSet?.fogUrl || ""}
                  data-icon-drizzle={trip.weatherConfig.iconSet?.drizzleUrl || ""}
                  data-icon-rain={trip.weatherConfig.iconSet?.rainUrl || ""}
                  data-icon-heavy-rain={trip.weatherConfig.iconSet?.heavyRainUrl || ""}
                  data-icon-snow={trip.weatherConfig.iconSet?.snowUrl || ""}
                  data-icon-thunderstorm={trip.weatherConfig.iconSet?.thunderstormUrl || ""}
                >
                  <div class="weather-header">
                    <div>
                      <h2 class="weather-title">
                        {trip.weatherConfig.locationLabel || trip.title} Weather
                      </h2>
                      <p class="weather-subtitle">Live 7-day forecast</p>
                    </div>
                    <p class="weather-status">Loading forecast...</p>
                  </div>
                  <ul class="weather-days" aria-live="polite"></ul>
                </section>
              )}
            </header>

            {sections.length > 0 ? (
              <div class="sections-list">
                {sections.map((section) => {
                  const places = Array.isArray(section.places) ? section.places : [];
                  const summary = getSectionSummary(section);
                  const sectionOpen = section.initialLoadState === "open";
                  const placeListClass = section.layoutStyle === "grid" ? "places-grid" : "timeline-list";

                  return (
                    <section class="trip-section" id={slugify(section.sectionTitle)}>
                      <header class="section-heading">
                        <p class="section-kicker">
                          {section.layoutStyle === "grid" ? "Browse section" : "Timeline section"}
                        </p>

                        <h2>{section.sectionTitle}</h2>

                        <div class="section-meta" aria-label="Section summary">
                          {summary.totalStops > 0 && (
                            <span class="meta-pill">
                              {summary.totalStops} {summary.totalStops === 1 ? "stop" : "stops"}
                            </span>
                          )}

                          {summary.mappedStops > 0 && (
                            <span class="meta-pill">
                              {summary.mappedStops} mapped
                            </span>
                          )}

                          {summary.bookingActions > 0 && (
                            <span class="meta-pill">
                              {summary.bookingActions} booking {summary.bookingActions === 1 ? "action" : "actions"}
                            </span>
                          )}

                          {summary.totalStops === 0 && (
                            <span class="meta-pill">Plans still taking shape</span>
                          )}
                        </div>
                      </header>

                      {section.sectionImageUrl && (
                        <img
                          src={section.sectionImageUrl}
                          alt=""
                          class="section-image"
                          loading="lazy"
                        />
                      )}

                      {section.sectionIntro && (
                        <div class="section-intro">
                          <p>{section.sectionIntro}</p>
                        </div>
                      )}

                      {hasWeatherConfig(section.weatherConfig) && (
                        <section
                          class="weather-card js-weather-card"
                          data-location={section.weatherConfig.locationLabel || section.sectionTitle}
                          data-lat={section.weatherConfig.latitude}
                          data-lon={section.weatherConfig.longitude}
                          data-icon-sunny={section.weatherConfig.iconSet?.sunnyUrl || ""}
                          data-icon-partly-cloudy={section.weatherConfig.iconSet?.partlyCloudyUrl || ""}
                          data-icon-cloudy={section.weatherConfig.iconSet?.cloudyUrl || ""}
                          data-icon-fog={section.weatherConfig.iconSet?.fogUrl || ""}
                          data-icon-drizzle={section.weatherConfig.iconSet?.drizzleUrl || ""}
                          data-icon-rain={section.weatherConfig.iconSet?.rainUrl || ""}
                          data-icon-heavy-rain={section.weatherConfig.iconSet?.heavyRainUrl || ""}
                          data-icon-snow={section.weatherConfig.iconSet?.snowUrl || ""}
                          data-icon-thunderstorm={section.weatherConfig.iconSet?.thunderstormUrl || ""}
                        >
                          <div class="weather-header">
                            <div>
                              <h3 class="weather-title">
                                {section.weatherConfig.locationLabel || section.sectionTitle} Weather
                              </h3>
                              <p class="weather-subtitle">Live 7-day forecast</p>
                            </div>
                            <p class="weather-status">Loading forecast...</p>
                          </div>
                          <ul class="weather-days" aria-live="polite"></ul>
                        </section>
                      )}

                      <details class="plans-drawer" open={sectionOpen}>
                        <summary>
                          <span>{places.length > 0 ? "Plans and stops" : "Plans still taking shape"}</span>
                          <span>
                            <span class="summary-count">
                              {places.length > 0
                                ? `${places.length} ${places.length === 1 ? "item" : "items"}`
                                : "Add stops in Sanity"}
                            </span>
                            <span class="summary-chevron" aria-hidden="true">⌄</span>
                          </span>
                        </summary>

                        {places.length > 0 ? (
                          <div class={placeListClass}>
                            {places.map((place) => {
                              const isTransit = place.category === "Transit" || place.category === "Transport";
                              const timeRange = formatTimeRange(place);
                              const booking = getBookingStatus(place);
                              const payment = getPaymentStatus(place);
                              const cost = formatCost(place.costStructure);
                              const cancellation = getCancellationText(place.costStructure);
                              const mapUrl = hasCoordinates(place) ? getMapUrl(place.coordinates) : "";

                              return (
                                <article class={`place-card ${isTransit ? "place-card-transit" : ""}`}>
                                  <header class="place-card-header">
                                    <div class="category-row">
                                      <span class="category-pill">
                                        {getCategoryIcon(place.category)} {place.category || "Plan"}
                                      </span>

                                      {timeRange && (
                                        <span class="time-pill">{timeRange}</span>
                                      )}
                                    </div>

                                    <h3>{place.placeName}</h3>

                                    {place.area && (
                                      <p class="place-area">{place.area}</p>
                                    )}
                                  </header>

                                  {place.photoUrl && (
                                    <img
                                      src={place.photoUrl}
                                      alt=""
                                      class="place-image"
                                      loading="lazy"
                                    />
                                  )}

                                  {(place.shortDescription || place.info) && (
                                    <div class="place-copy">
                                      {place.shortDescription && <p>{place.shortDescription}</p>}
                                      {place.info && <p>{place.info}</p>}
                                    </div>
                                  )}

                                  {place.practicalInfo && (
                                    <div class="info-box">
                                      <strong>Practical info</strong>
                                      <p>{place.practicalInfo}</p>
                                    </div>
                                  )}

                                  {isTransit && place.transitDetails && (
                                    <div class="detail-box">
                                      <strong>Journey details</strong>
                                      <ul class="detail-list">
                                        {place.transitDetails.origin && (
                                          <li>From: {place.transitDetails.origin}</li>
                                        )}

                                        {place.transitDetails.destination && (
                                          <li>To: {place.transitDetails.destination}</li>
                                        )}

                                        {place.transitDetails.carrier && (
                                          <li>Carrier / line: {place.transitDetails.carrier}</li>
                                        )}

                                        {place.transitDetails.bookingDetailsText && (
                                          <li>{place.transitDetails.bookingDetailsText}</li>
                                        )}

                                        {place.transitDetails.airportParkingLogistics?.status &&
                                          place.transitDetails.airportParkingLogistics.status !== "not-needed" && (
                                            <li>
                                              Parking: {place.transitDetails.airportParkingLogistics.status}
                                              {place.transitDetails.airportParkingLogistics.locationInfo
                                                ? `, ${place.transitDetails.airportParkingLogistics.locationInfo}`
                                                : ""}
                                            </li>
                                          )}
                                      </ul>
                                    </div>
                                  )}

                                  {place.category === "Hotel" && place.hotelDetails && (
                                    <div class="detail-box">
                                      <strong>Stay details</strong>
                                      <ul class="detail-list">
                                        {place.hotelDetails.roomType && (
                                          <li>Room: {place.hotelDetails.roomType}</li>
                                        )}

                                        {place.hotelDetails.checkInNotes && (
                                          <li>{place.hotelDetails.checkInNotes}</li>
                                        )}
                                      </ul>
                                    </div>
                                  )}

                                  {place.travelNote && (
                                    <div class="info-box">
                                      <strong>Getting there</strong>
                                      <p>{place.travelNote}</p>
                                    </div>
                                  )}

                                  <div class="status-row">
                                    <span class={`status-pill ${booking.className}`}>{booking.label}</span>
                                    <span class={`status-pill ${payment.className}`}>{payment.label}</span>

                                    {cost && (
                                      <span class="status-pill status-muted">{cost}</span>
                                    )}

                                    {cancellation && (
                                      <span class="status-pill status-muted">{cancellation}</span>
                                    )}
                                  </div>

                                  {(place.bookingUrl || place.websiteUrl || mapUrl) && (
                                    <div class="place-links">
                                      {place.bookingUrl && (
                                        <a
                                          href={place.bookingUrl}
                                          class="place-link"
                                          target="_blank"
                                          rel="noreferrer"
                                        >
                                          Booking link ↗
                                        </a>
                                      )}

                                      {place.websiteUrl && (
                                        <a
                                          href={place.websiteUrl}
                                          class="place-link secondary"
                                          target="_blank"
                                          rel="noreferrer"
                                        >
                                          Official site ↗
                                        </a>
                                      )}

                                      {mapUrl && (
                                        <a
                                          href={mapUrl}
                                          class="place-link secondary"
                                          target="_blank"
                                          rel="noreferrer"
                                        >
                                          Open map ↗
                                        </a>
                                      )}
                                    </div>
                                  )}
                                </article>
                              );
                            })}
                          </div>
                        ) : (
                          <div class="empty-section">
                            No stops have been added to this section yet.
                          </div>
                        )}
                      </details>
                    </section>
                  );
                })}
              </div>
            ) : (
              <div class="empty-page">
                No trip sections have been added yet.
              </div>
            )}
          </article>
        </main>
      ) : (
        <main class="empty-page">
          <h1>Itinerary not found</h1>
          <p>This trip is missing or hidden.</p>
        </main>
      )}
    </div>

    <script is:inline>
      const weatherCodeLookup = {
        0: { label: "Clear", key: "sunny", emoji: "☀️" },
        1: { label: "Mainly clear", key: "partlyCloudy", emoji: "🌤️" },
        2: { label: "Partly cloudy", key: "partlyCloudy", emoji: "⛅" },
        3: { label: "Cloudy", key: "cloudy", emoji: "☁️" },
        45: { label: "Fog", key: "fog", emoji: "🌫️" },
        48: { label: "Rime fog", key: "fog", emoji: "🌫️" },
        51: { label: "Light drizzle", key: "drizzle", emoji: "🌦️" },
        53: { label: "Drizzle", key: "drizzle", emoji: "🌦️" },
        55: { label: "Heavy drizzle", key: "drizzle", emoji: "🌧️" },
        56: { label: "Freezing drizzle", key: "drizzle", emoji: "🌧️" },
        57: { label: "Freezing drizzle", key: "drizzle", emoji: "🌧️" },
        61: { label: "Light rain", key: "rain", emoji: "🌧️" },
        63: { label: "Rain", key: "rain", emoji: "🌧️" },
        65: { label: "Heavy rain", key: "heavyRain", emoji: "🌧️" },
        66: { label: "Freezing rain", key: "rain", emoji: "🌧️" },
        67: { label: "Freezing rain", key: "heavyRain", emoji: "🌧️" },
        71: { label: "Light snow", key: "snow", emoji: "🌨️" },
        73: { label: "Snow", key: "snow", emoji: "🌨️" },
        75: { label: "Heavy snow", key: "snow", emoji: "❄️" },
        77: { label: "Snow grains", key: "snow", emoji: "❄️" },
        80: { label: "Rain showers", key: "rain", emoji: "🌦️" },
        81: { label: "Rain showers", key: "rain", emoji: "🌧️" },
        82: { label: "Heavy showers", key: "heavyRain", emoji: "🌧️" },
        85: { label: "Snow showers", key: "snow", emoji: "🌨️" },
        86: { label: "Heavy snow showers", key: "snow", emoji: "❄️" },
        95: { label: "Thunderstorm", key: "thunderstorm", emoji: "⛈️" },
        96: { label: "Thunderstorm", key: "thunderstorm", emoji: "⛈️" },
        99: { label: "Thunderstorm", key: "thunderstorm", emoji: "⛈️" },
      };

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const formatForecastDate = (dateString) => {
        const date = new Date(`${dateString}T00:00:00`);

        if (Number.isNaN(date.getTime())) {
          return dateString;
        }

        return new Intl.DateTimeFormat("en-GB", {
          weekday: "short",
          day: "numeric",
          month: "short",
        }).format(date);
      };

      const getWeatherInfo = (code) => {
        const numericCode = Number(code);
        return weatherCodeLookup[numericCode] || {
          label: "Forecast",
          key: "partlyCloudy",
          emoji: "🌤️",
        };
      };

      const getCustomIconUrl = (card, key) => {
        const iconMap = {
          sunny: card.dataset.iconSunny,
          partlyCloudy: card.dataset.iconPartlyCloudy,
          cloudy: card.dataset.iconCloudy,
          fog: card.dataset.iconFog,
          drizzle: card.dataset.iconDrizzle,
          rain: card.dataset.iconRain,
          heavyRain: card.dataset.iconHeavyRain,
          snow: card.dataset.iconSnow,
          thunderstorm: card.dataset.iconThunderstorm,
        };

        return iconMap[key] || "";
      };

      const renderWeatherCard = async (card) => {
        const status = card.querySelector(".weather-status");
        const list = card.querySelector(".weather-days");
        const latitude = card.dataset.lat;
        const longitude = card.dataset.lon;

        if (!latitude || !longitude || !list || !status) {
          return;
        }

        try {
          const params = new URLSearchParams({
            latitude,
            longitude,
            daily: "weather_code,temperature_2m_max,temperature_2m_min",
            timezone: "auto",
            forecast_days: "7",
          });

          const response = await fetch(`https://api.open-meteo.com/v1/forecast?${params.toString()}`);

          if (!response.ok) {
            throw new Error("Weather request failed");
          }

          const data = await response.json();
          const daily = data.daily || {};
          const dates = daily.time || [];

          if (!dates.length) {
            throw new Error("No forecast days returned");
          }

          list.innerHTML = dates
            .map((dateString, index) => {
              const weatherInfo = getWeatherInfo(daily.weather_code?.[index]);
              const iconUrl = getCustomIconUrl(card, weatherInfo.key);
              const maxTemp = Math.round(daily.temperature_2m_max?.[index]);
              const minTemp = Math.round(daily.temperature_2m_min?.[index]);

              const iconMarkup = iconUrl
                ? `<img src="${escapeHtml(iconUrl)}" alt="${escapeHtml(weatherInfo.label)}" loading="lazy" />`
                : `<span aria-hidden="true">${weatherInfo.emoji}</span>`;

              return `
                <li class="weather-day">
                  <div class="weather-date">${escapeHtml(formatForecastDate(dateString))}</div>
                  <div class="weather-icon">${iconMarkup}</div>
                  <div class="weather-temp">${escapeHtml(maxTemp)}° / ${escapeHtml(minTemp)}°C</div>
                  <div class="weather-label">${escapeHtml(weatherInfo.label)}</div>
                </li>
              `;
            })
            .join("");

          status.textContent = "Updated live";
        } catch (error) {
          status.textContent = "Forecast unavailable";
          list.innerHTML = `
            <li class="weather-day">
              <div class="weather-date">Weather</div>
              <div class="weather-icon"><span aria-hidden="true">🌤️</span></div>
              <div class="weather-temp">Unavailable</div>
              <div class="weather-label">Check again later</div>
            </li>
          `;
        }
      };

      document.querySelectorAll(".js-weather-card").forEach(renderWeatherCard);
    </script>
  </body>
</html>
