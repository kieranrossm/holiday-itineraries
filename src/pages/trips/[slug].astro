---
import { sanityClient } from "sanity:client";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(`*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] { "slug": slug.current }`);
  return data.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const query = `*[_type == "trip" && slug.current == $slug][0] {
  title,
  startDate,
  heroIntro,
  "heroImageUrl": heroImage.asset->url,
  sections[] {
    sectionTitle,
    sectionIntro,
    layoutStyle,
    places[] {
      placeName,
      time,
      endTime,
      category,
      area,
      shortDescription,
      info,
      practicalInfo,
      costStructure,
      bookingLogistics,
      paymentStatus,
      bookingUrl,
      websiteUrl,
      travelNote,
      "photoUrl": photo.asset->url,
      coordinates,
      transitDetails,
      hotelDetails
    }
  }
}`;

const trip = await sanityClient.fetch(query, { slug });

if (!trip) {
  return Astro.redirect("/404");
}

const EXCHANGE_RATES: Record<string, number> = {
  EUR: 0.85,
  CNY: 0.11,
  JPY: 0.0052,
  CHF: 0.88,
  GBP: 1.0
};

const CURRENCY_SYMBOLS: Record<string, string> = {
  EUR: "€",
  CNY: "¥",
  JPY: "¥",
  CHF: "CHF ",
  GBP: "£"
};

const formatCost = (costObj: any) => {
  if (!costObj) return "";
  const { localAmount, currencyType, textFallback } = costObj;
  
  if (localAmount !== undefined && localAmount !== null) {
    const symbol = CURRENCY_SYMBOLS[currencyType] || "£";
    const localFormatted = `${symbol}${localAmount.toLocaleString("en-GB")}`;
    
    if (currencyType === "GBP") return localFormatted;
    
    const rate = EXCHANGE_RATES[currencyType] || 1;
    const gbpEquivalent = Math.round(localAmount * rate);
    return `${localFormatted} (£${gbpEquivalent.toLocaleString("en-GB")})`;
  }
  
  return textFallback || "";
};

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const formatInlineDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{trip.title} | Trip Execution Plan</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --purple-bg: #f3e8ff;
        --purple-ink: #6b21a8;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
        color: var(--ink);
        background: var(--page-bg);
      }

      .back-nav { margin-bottom: 2rem; }
      .back-button { text-decoration: none; font-weight: 700; color: var(--muted); font-size: 0.95rem; }
      .back-button:hover { color: var(--ink); }

      .trip-header {
        margin-bottom: 3.5rem;
        border: 1px solid var(--soft);
        border-radius: 28px;
        background: #ffffff;
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.05);
        overflow: hidden;
      }

      .trip-hero-image { width: 100%; height: clamp(240px, 35vw, 400px); object-fit: cover; display: block; }
      .trip-header-content { padding: 2rem; }
      .trip-header h1 { margin: 0 0 0.75rem; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; letter-spacing: -0.05em; }
      .trip-date { margin: 0; color: var(--muted); font-weight: 650; }
      .hero-intro { max-width: 760px; margin: 1.25rem 0 0; color: #475569; line-height: 1.7; white-space: pre-line; }

      .section-container { margin-bottom: 4.5rem; }
      .section-header { margin-bottom: 2rem; }
      .section-header h2 { margin: 0 0 0.5rem; font-size: clamp(1.5rem, 4vw, 2.2rem); letter-spacing: -0.04em; }
      .section-header p { margin: 0; color: var(--muted); line-height: 1.6; }

      .places-container { width: 100%; }
      .place-card { position: relative; background: var(--card-bg); border: 1px solid var(--soft); border-radius: 22px; overflow: hidden; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04); }
      .place-image { width: 100%; height: 260px; object-fit: cover; display: block; }
      .place-content { padding: 1.5rem; }
      .place-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem; }

      .time-badge, .category-badge, .area-badge, .payment-badge, .booking-badge { display: inline-flex; align-items: center; padding: 0.3rem 0.7rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; line-height: 1; }
      .time-badge { background: var(--blue-bg); color: var(--blue-ink); }
      .category-badge { background: var(--amber-bg); color: var(--amber-ink); }
      .category-badge.transport { background: var(--purple-bg); color: var(--purple-ink); }
      .area-badge { background: var(--green-bg); color: var(--green-ink); }
      
      .payment-badge.paid { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.unpaid { background: var(--rose-bg); color: var(--rose-ink); }
      
      /* New Lifecycle State Badges */
      .booking-badge.to-book { background: var(--amber-bg); color: var(--amber-ink); border: 1px dashed var(--amber-ink); }
      .booking-badge.booked { background: var(--blue-bg); color: var(--blue-ink); }

      .place-card h3 { margin: 0.5rem 0; font-size: 1.35rem; line-height: 1.2; letter-spacing: -0.02em; }
      .short-description { margin: 0.5rem 0; font-weight: 600; color: var(--ink); line-height: 1.5; }
      .place-info { margin: 1rem 0 0; color: #475569; line-height: 1.65; white-space: pre-line; }

      .logistics-block { background: var(--soft-2); padding: 1rem; border-radius: 12px; margin: 1rem 0; font-size: 0.9rem; border: 1px solid var(--soft); }
      .logistics-title { font-weight: 800; text-transform: uppercase; font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; letter-spacing: 0.05em; }
      .logistics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; }

      .detail-list { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--soft); font-size: 0.95rem; }
      .detail-list p { margin: 0.5rem 0; color: #475569; }

      .place-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
      .place-links a, .copy-coords-btn { display: inline-flex; align-items: center; padding: 0.55rem 1rem; border-radius: 999px; background: var(--ink); color: #ffffff; text-decoration: none; font-weight: 700; font-size: 0.85rem; border: none; cursor: pointer; }
      .place-links a:hover, .copy-coords-btn:hover { background: #334155; }
      .copy-coords-btn { background: transparent; color: var(--ink); border: 1px solid var(--soft); }
      .copy-coords-btn:hover { background: var(--soft-2); }

      .layout-grid .places-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
      
      .layout-timeline .places-container { display: flex; flex-direction: column; gap: 2.5rem; border-left: 3px solid #cbd5e1; padding-left: 2rem; margin-left: 0.5rem; }
      .layout-timeline .place-card::before {
        content: ""; position: absolute; left: -2.65rem; top: 1.75rem; width: 1rem; height: 1rem; background: #3b82f6; border-radius: 50%; border: 4px solid var(--page-bg);
      }

      @media (max-width: 720px) {
        .layout-timeline .places-container { margin-left: 0.25rem; padding-left: 1.25rem; }
        .layout-timeline .place-card::before { left: -1.9rem; }
      }
    </style>
  </head>
  <body>
    <nav class="back-nav">
      <a href="/" class="back-button">← Back to All Itineraries</a>
    </nav>

    <main>
      <article class="trip-wrapper">
        <header class="trip-header">
          {trip.heroImageUrl && (
            <img src={trip.heroImageUrl} alt="" class="trip-hero-image" />
          )}
          <div class="trip-header-content">
            <h1>{trip.title}</h1>
            {trip.startDate && (
              <p class="trip-date"><strong>Departure:</strong> {formatDate(trip.startDate)}</p>
            )}
            {trip.heroIntro && <p class="hero-intro">{trip.heroIntro}</p>}
          </div>
        </header>

        {trip.sections && trip.sections.map((section: any) => (
          <section class={`section-container layout-${section.layoutStyle || "timeline"}`}>
            <header class="section-header">
              <h2>{section.sectionTitle}</h2>
              {section.sectionIntro && <p>{section.sectionIntro}</p>}
            </header>

            {section.places && section.places.length > 0 && (
              <div class="places-container">
                {section.places.map((place: any) => (
                  <article class="place-card">
                    {place.photoUrl && (
                      <img src={place.photoUrl} alt={place.placeName} class="place-image" loading="lazy" />
                    )}

                    <div class="place-content">
                      <div class="place-meta">
                        {place.time && (
                          <span class="time-badge">
                            {place.time}{place.endTime ? ` - ${place.endTime}` : ""}
                          </span>
                        )}
                        {place.category && (
                          <span class={`category-badge ${place.category.toLowerCase()}`}>
                            {place.category}
                          </span>
                        )}
                        {place.area && <span class="area-badge">{place.area}</span>}
                        
                        {/* --- RENDERING MATRIX: EXPLICIT PAYMENT COUPLING --- */}
                        {place.paymentStatus === "paid" && <span class="payment-badge paid">✓ Paid</span>}
                        {place.paymentStatus === "unpaid" && <span class="payment-badge unpaid">⚠️ Unpaid</span>}

                        {/* --- RENDERING MATRIX: DETAILED BOOKING LIFECYCLE --- */}
                        {place.bookingLogistics?.bookingStatus === "to-book" && (
                          <span class="booking-badge to-book">
                            ⏳ To Book {place.bookingLogistics.bookOnDate ? `(On ${formatInlineDate(place.bookingLogistics.bookOnDate)})` : ""}
                          </span>
                        )}
                        {place.bookingLogistics?.bookingStatus === "booked" && (
                          <span class="booking-badge booked">✓ Booked</span>
                        )}
                      </div>

                      <h3>{place.placeName}</h3>
                      {place.shortDescription && <p class="short-description">{place.shortDescription}</p>}
                      
                      {place.category === "Transport" && place.transitDetails && (
                        <div class="logistics-block">
                          <div class="logistics-title">Connection Parameters</div>
                          <div class="logistics-grid">
                            {place.transitDetails.origin && <p><strong>From:</strong> {place.transitDetails.origin}</p>}
                            {place.transitDetails.destination && <p><strong>To:</strong> {place.transitDetails.destination}</p>}
                            {place.transitDetails.carrier && <p><strong>Carrier:</strong> {place.transitDetails.carrier}</p>}
                            {place.transitDetails.reference && <p><strong>Ref:</strong> {place.transitDetails.reference}</p>}
                            {place.transitDetails.seatAssignment && <p><strong>Seat/Class:</strong> {place.transitDetails.seatAssignment}</p>}
                          </div>
                        </div>
                      )}

                      {place.category === "Hotel" && place.hotelDetails && (
                        <div class="logistics-block">
                          <div class="logistics-title">Accommodation Logistics</div>
                          <div class="logistics-grid">
                            {place.hotelDetails.bookingRef && <p><strong>Booking Ref:</strong> {place.hotelDetails.bookingRef}</p>}
                            {place.hotelDetails.roomType && <p><strong>Room:</strong> {place.hotelDetails.roomType}</p>}
                            {place.hotelDetails.checkInNotes && <p><strong>Notes:</strong> {place.hotelDetails.checkInNotes}</p>}
                          </div>
                        </div>
                      )}

                      {place.info && <p class="place-info">{place.info}</p>}

                      {(place.costStructure || place.practicalInfo || place.travelNote || place.bookingLogistics) && (
                        <div class="detail-list">
                          {formatCost(place.costStructure) && (
                            <p><strong>Price:</strong> {formatCost(place.costStructure)}</p>
                          )}
                          {place.practicalInfo && <p><strong>Good to know:</strong> {place.practicalInfo}</p>}
                          {place.travelNote && <p><strong>Getting there:</strong> {place.travelNote}</p>}
                          
                          {/* Text summary display mapping configuration */}
                          {place.bookingLogistics?.bookingStatus === "to-book" && (
                            <p><strong>Booking:</strong> Required {place.bookingLogistics.bookOnDate ? `- Window opens ${formatInlineDate(place.bookingLogistics.bookOnDate)}` : ""}</p>
                          )}
                          {place.bookingLogistics?.bookingStatus === "booked" && (
                            <p><strong>Booking:</strong> Confirmed</p>
                          )}
                        </div>
                      )}

                      <div class="place-links">
                        {place.bookingUrl && <a href={place.bookingUrl} target="_blank" rel="noreferrer">Book</a>}
                        {place.websiteUrl && <a href={place.websiteUrl} target="_blank" rel="noreferrer">Website</a>}
                        
                        {place.coordinates && (
                          <button 
                            class="copy-coords-btn" 
                            data-lat={place.coordinates.lat} 
                            data-lng={place.coordinates.lng}
                            onclick={`
                              navigator.clipboard.writeText('${place.coordinates.lat},${place.coordinates.lng}');
                              this.innerText = 'Copied!';
                              setTimeout(() => this.innerText = '📋 Copy Coords', 1500);
                            `}
                          >
                            📋 Copy Coords
                          </button>
                        )}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>
        ))}
      </article>
    </main>
  </body>
</html>
