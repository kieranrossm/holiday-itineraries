        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --purple-bg: #f3e8ff;
        --purple-ink: #6b21a8;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
        --slate-bg: #e2e8f0;
        --slate-ink: #334155;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
        padding: 2rem 1rem 4rem;
        color: var(--ink);
        background: var(--page-bg);
      }

      .back-nav,
      .trip-wrapper {
        max-width: 1120px;
        margin-left: auto;
        margin-right: auto;
      }

      .back-nav { margin-bottom: 2rem; }
      .back-button { text-decoration: none; font-weight: 700; color: var(--muted); font-size: 0.95rem; }
      .back-button:hover { color: var(--ink); }

      .trip-header {
        margin-bottom: 3.5rem;
        border: 1px solid var(--soft);
        border-radius: 28px;
        background: #ffffff;
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.05);
        overflow: hidden;
      }

      .trip-hero-image {
        width: 100%;
        aspect-ratio: 21 / 9;
        max-height: 460px;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .trip-header-content { padding: clamp(1.5rem, 4vw, 2.25rem); }
      .trip-header h1 { margin: 0 0 0.75rem; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; letter-spacing: -0.05em; }
      .trip-date { margin: 0; color: var(--muted); font-weight: 650; }
      .hero-intro { max-width: 820px; margin: 1.25rem 0 0; color: #475569; line-height: 1.7; white-space: pre-line; }

      /* Visual Layout Grid Configuration */
      .weather-forecast-card {
        margin-top: 1.5rem;
        padding: 1.25rem;
        border-radius: 16px;
        background: #1e293b;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      }

      .weather-forecast-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      }

      .weather-eyebrow {
        color: #38bdf8;
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .weather-location {
        color: #ffffff;
        font-size: 1.25rem;
        font-weight: 800;
      }

      .weather-source-note {
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .weather-status {
        color: #ffffff;
        font-weight: 600;
      }

      .weather-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        background: #0f172a;
        padding: 6px;
        border-radius: 8px;
      }

      .weather-day {
        background: #0284c7;
        color: #ffffff;
        padding: 0.85rem 0.15rem 0 0.15rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        min-height: auto;
        box-shadow: none;
        border: none;
        border-radius: 4px;
        overflow: hidden;
      }

      .hero-weather .weather-days .weather-day.is-primary {
        grid-row: auto;
        background: #0284c7; 
        padding: 0.85rem 0.15rem 0 0.15rem;
        border-radius: 4px;
      }

      .weather-day-name {
        display: block;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.4rem;
      }

      .weather-date {
        display: none;
      }

      .weather-icon-frame {
        display: block;
        width: auto;
        height: auto;
        background: transparent !important;
        box-shadow: none !important;
        margin: 0.25rem 0;
      }

      .hero-weather .weather-day.is-primary .weather-icon-frame {
        width: auto;
        height: auto;
        margin: 0.25rem 0;
      }

      .weather-icon {
        font-size: 2.25rem !important;
        line-height: 1;
      }

      .weather-condition {
        display: block;
        color: #ffffff;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        line-height: 1.2;
        min-height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.2rem;
        letter-spacing: -0.01em;
      }

      .weather-temp {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        margin-top: auto;
      }

      .weather-temp-high {
        color: #ffffff;
        font-size: 1.95rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        line-height: 1;
      }

      .weather-temp-low {
        display: block;
        width: 100%;
        background: #ffffff;
        color: #1e293b;
        font-size: 1.1rem;
        font-weight: 800;
        padding: 0.4rem 0;
        margin-top: 0.25rem;
      }

      .weather-rain {
        display: none;
      }

      .section-container {
        margin-bottom: 3rem;
        border: 1px solid var(--soft);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.7);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        padding: 1.25rem;
      }

      .section-static-header {
        padding: 0.25rem 0.25rem 0.75rem;
      }

      .section-static-header h2 {
        margin: 0;
        font-size: clamp(1.45rem, 4vw, 2.1rem);
        letter-spacing: -0.04em;
      }

      .section-kicker {
        display: block;
        margin-top: 0.4rem;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 650;
      }

      .section-banner-image {
        width: 100%;
        aspect-ratio: 21 / 7;
        object-fit: cover;
        object-position: center;
        border-radius: 20px;
        margin: 0.25rem 0 1rem;
        border: 1px solid var(--soft);
        background: var(--soft-2);
        display: block;
      }

      .section-drawer {
        margin-top: 0.75rem;
      }

      .section-drawer-summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        font-weight: 800;
      }

      .section-drawer-summary::-webkit-details-marker { display: none; }

      .section-drawer-label {
        font-size: 0.9rem;
      }

      .label-open { display: none; }
      .section-drawer[open] .label-closed { display: none; }
      .section-drawer[open] .label-open { display: inline; }

      .section-chevron {
        width: 1.85rem;
        height: 1.85rem;
        border-radius: 999px;
        display: inline-grid;
        place-items: center;
        color: var(--ink);
        background: var(--soft-2);
        border: 1px solid var(--soft);
        transition: transform 180ms ease, background 180ms ease;
      }

      .section-drawer[open] .section-chevron {
        transform: rotate(90deg);
        background: #ffffff;
      }

      .section-body {
        padding: 1.25rem 0 0;
      }

      .section-intro-panel {
        margin: 0 0 1.5rem;
        padding: 1.2rem 1.35rem;
        border: 1px solid var(--soft);
        border-radius: 18px;
        background: #ffffff;
        color: #475569;
        line-height: 1.7;
        white-space: pre-line;
      }

      .section-intro-panel p { margin: 0; }

      .empty-section-note {
        margin: 0;
        padding: 1rem 1.2rem;
        border: 1px dashed var(--soft);
        border-radius: 16px;
        color: var(--muted);
        background: var(--soft-2);
        font-weight: 650;
      }

      .places-container { width: 100%; }

      .place-card {
        position: relative;
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .place-image-wrap {
        width: 100%;
        overflow: hidden;
        background: var(--soft-2);
      }

      .place-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .place-content { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
      .place-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem; }

      .time-badge,
      .category-badge,
      .area-badge,
      .payment-badge,
      .booking-badge,
      .cancellation-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
        line-height: 1;
      }

      .time-badge { background: var(--blue-bg); color: var(--blue-ink); }
      .category-badge { background: var(--amber-bg); color: var(--amber-ink); }
      .category-badge.transport,
      .category-badge.transit { background: var(--purple-bg); color: var(--purple-ink); }
      .area-badge { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.paid { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.unpaid { background: var(--rose-bg); color: var(--rose-ink); }
      .booking-badge.to-book { background: var(--amber-bg); color: var(--amber-ink); border: 1px dashed var(--amber-ink); }
      .booking-badge.booked { background: var(--blue-bg); color: var(--blue-ink); }
      .cancellation-badge.free { background: var(--green-bg); color: var(--green-ink); }
      .cancellation-badge.non-refundable { background: var(--slate-bg); color: var(--slate-ink); }

      .place-card h3 { margin: 0.5rem 0; font-size: 1.35rem; line-height: 1.2; letter-spacing: -0.02em; }
