---
import { sanityClient } from "sanity:client";
import {
  getCategoryClass,
  getDecisionStateClass,
  getDecisionStateLabel,
  getPriceLabel,
} from "../../lib/itineraryLabels";
import {
  formatCost,
  formatDate,
  formatInlineDate,
  getOpeningHourRows,
  getPluralLabel,
} from "../../lib/formatters";
import {
  getCoordinateMapUrl,
  getFoodMapPoints,
  getFoodStaticMapUrl,
  getSectionMapId,
  getStaticMapUrl,
  getTripMapPoints,
} from "../../lib/maps";
import { countsAsDashboardStop, isTransitCategory } from "../../lib/itineraryStats";
import { getSectionScanItems, getSectionSummary } from "../../lib/sectionSummaries";
import { tripDetailQuery, visibleTripSlugsQuery } from "../../lib/tripQueries";
import { getSharedWeatherIconSet, hasWeatherConfig } from "../../lib/weather";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(visibleTripSlugsQuery);
  return data.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const trip = await sanityClient.fetch(tripDetailQuery, { slug });

if (!trip) {
  return Astro.redirect("/404");
}

const googleMapsStaticApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_STATIC_API_KEY || "";

const tripSections = trip.sections || [];
const sharedWeatherIconSet = getSharedWeatherIconSet(trip);
const tripPlaces = tripSections.flatMap((section: any) => section.places || []);
const tripFoods = tripSections.flatMap((section: any) => section.foodShortlist || []);
const tripStops = tripSections.flatMap((section: any) => (
  (section.places || []).filter((place: any) => countsAsDashboardStop(place, section.sectionTitle))
));
const tripBookingActions = tripPlaces.filter((place: any) => place.bookingLogistics?.bookingStatus === "to-book");
const tripUnpaidItems = tripPlaces.filter((place: any) => (
  place.paymentStatus === "unpaid" &&
  place.bookingLogistics?.bookingStatus === "booked"
));
const tripBookedItems = [
  ...tripPlaces.filter((place: any) => place.bookingLogistics?.bookingStatus === "booked"),
  ...tripFoods.filter((food: any) => food.bookingStatus === "booked"),
];
const tripMapPoints = getTripMapPoints(tripSections);
const tripStaticMapUrl = getStaticMapUrl(tripMapPoints, googleMapsStaticApiKey);

const timingStatusLabels: Record<string, string> = {
  confirmed: "Confirmed",
  estimated: "Estimated",
  flexible: "Flexible",
  "opening-hours-dependent": "Opening-hours dependent",
};

const hasText = (value: unknown) => typeof value === "string" && value.trim().length > 0;

const getPlaceScheduleBadge = (place: any) => {
  const schedule = place.schedule || {};

  if (hasText(schedule.startTime)) {
    return `${schedule.startTime}${hasText(schedule.endTime) ? ` - ${schedule.endTime}` : ""}`;
  }

  if (hasText(schedule.suggestedTime)) {
    return schedule.suggestedTime;
  }

  return "";
};

const hasPlaceScheduleDetails = (place: any) => {
  const schedule = place.schedule || {};

  return [
    schedule.date,
    schedule.startTime,
    schedule.endTime,
    schedule.duration,
    schedule.suggestedTime,
    schedule.timingStatus,
    schedule.timingNote,
  ].some(hasText);
};

const getTimingStatusLabel = (status: unknown) => (
  hasText(status) ? timingStatusLabels[String(status)] || String(status) : ""
);

---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{trip.title} | Trip Execution Plan</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --purple-bg: #f3e8ff;
        --purple-ink: #6b21a8;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
        --slate-bg: #e2e8f0;
        --slate-ink: #334155;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
        padding: 2rem 1rem 4rem;
        color: var(--ink);
        background: var(--page-bg);
      }

      .back-nav,
      .trip-wrapper {
        max-width: 1120px;
        margin-left: auto;
        margin-right: auto;
      }

      .back-nav { margin-bottom: 2rem; }
      .back-button { text-decoration: none; font-weight: 700; color: var(--muted); font-size: 0.95rem; }
      .back-button:hover { color: var(--ink); }

      .trip-header {
        margin-bottom: 3.5rem;
        border: 1px solid var(--soft);
        border-radius: 28px;
        background: #ffffff;
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.05);
        overflow: hidden;
      }

      .trip-hero-image {
        width: 100%;
        aspect-ratio: 21 / 9;
        max-height: 460px;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .trip-header-content { padding: clamp(1.5rem, 4vw, 2.25rem); }
      .trip-header-title-block { padding-bottom: clamp(1.25rem, 3vw, 2rem); }
      .trip-header-after-image { padding-top: clamp(1.25rem, 3vw, 2rem); }
      .trip-header-after-image .hero-intro:first-child { margin-top: 0; }

      .trip-header h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1;
        letter-spacing: -0.05em;
      }

      .trip-date { margin: 0; color: var(--muted); font-weight: 650; }
      .hero-intro { max-width: 820px; margin: 1.25rem 0 0; color: #475569; line-height: 1.7; white-space: pre-line; }

      .weather-card {
        margin-top: 1.5rem;
        border: 1px solid #dbe3ef;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
        overflow: hidden;
      }

      .section-weather-card {
        margin-top: 1rem;
      }

      .trip-dashboard {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
        gap: 1rem;
        margin: -1.5rem 0 3rem;
      }

      .trip-dashboard.no-dashboard-map {
        grid-template-columns: 1fr;
      }

      .dashboard-panel {
        border: 1px solid var(--soft);
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
        overflow: hidden;
      }

      .dashboard-summary {
        padding: 1.25rem;
      }

      .dashboard-eyebrow {
        margin: 0 0 0.45rem;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .dashboard-title {
        margin: 0;
        color: var(--ink);
        font-size: clamp(1.35rem, 3vw, 1.9rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
      }

      .dashboard-intro {
        margin: 0.65rem 0 0;
        color: #475569;
        line-height: 1.55;
        font-size: 0.95rem;
      }

      .dashboard-metrics {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
        margin-top: 1rem;
      }

      .dashboard-metric {
        min-width: 0;
        padding: 0.85rem;
        border: 1px solid var(--soft);
        border-radius: 16px;
        background: var(--soft-2);
      }

      .dashboard-metric strong {
        display: block;
        color: var(--ink);
        font-size: 1.35rem;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .dashboard-metric span {
        display: block;
        margin-top: 0.35rem;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 800;
      }

      .dashboard-actions {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--soft);
        display: grid;
        gap: 0.65rem;
      }

      .dashboard-action-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        color: #334155;
        font-size: 0.9rem;
        font-weight: 750;
      }

      .dashboard-action-row span:last-child {
        color: var(--muted);
        text-align: right;
        white-space: nowrap;
      }

      .dashboard-map-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid var(--soft);
      }

      .dashboard-map-header h2 {
        margin: 0;
        color: var(--ink);
        font-size: 1.05rem;
        letter-spacing: -0.02em;
      }

      .dashboard-map-count {
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .dashboard-map-empty {
        margin: 0;
        padding: 1.25rem;
        color: var(--muted);
        font-weight: 750;
      }

      .dashboard-note {
        margin: 1rem 0 0;
        padding: 0.85rem 1rem;
        border: 1px dashed var(--soft);
        border-radius: 14px;
        background: var(--soft-2);
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 750;
      }

      .dashboard-map-panel {
        margin: 0;
        border: 0;
        border-radius: 0;
      }

      .weather-card-header {
        display: flex;
        justify-content: space-between;
        gap: 1.25rem;
        align-items: center;
        padding: 1.2rem 1.35rem;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
      }

      .weather-title-wrap {
        min-width: 0;
      }

      .weather-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.15;
      }

      .weather-subtitle {
        display: block;
        margin-top: 0.35rem;
        color: #64748b;
        font-size: 0.85rem;
        font-weight: 750;
      }

      .weather-summary {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.45rem;
        color: #0f172a;
        font-size: 0.84rem;
        font-weight: 850;
        text-align: right;
      }

      .weather-summary span {
        display: inline-flex;
        align-items: center;
        min-height: 1.8rem;
        padding: 0.35rem 0.65rem;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #ffffff;
        white-space: nowrap;
      }

      .weather-loading,
      .weather-error {
        padding: 1rem 1.35rem;
        color: #64748b;
        font-weight: 750;
        font-size: 0.9rem;
      }

      .weather-error {
        color: #9f1239;
        background: #ffe4e6;
      }

      .weather-days {
        display: grid;
        grid-template-columns: repeat(7, minmax(132px, 1fr));
        gap: 0.75rem;
        padding: 1rem;
        overflow-x: auto;
        background: #f8fafc;
      }

      .weather-day {
        min-width: 132px;
        padding: 1rem 0.8rem;
        text-align: center;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
      }

      .weather-day-name {
        margin: 0 0 0.65rem;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 900;
      }

      .weather-icon-wrap {
        width: 92px;
        height: 92px;
        margin: 0 auto 0.6rem;
        display: grid;
        place-items: center;
      }

      .weather-icon {
        width: 92px;
        height: 92px;
        display: block;
        object-fit: cover;
        border-radius: 18px;
      }

      .weather-icon-fallback {
        font-size: 4.15rem;
        line-height: 1;
      }

      .weather-precip {
        margin: 0.2rem 0 0.45rem;
        color: #1d4ed8;
        font-size: 0.9rem;
        font-weight: 900;
      }

      .weather-temp {
        margin: 0;
        color: #0f172a;
        font-size: 0.98rem;
        font-weight: 900;
      }

      .weather-provider {
        display: block;
        padding: 0.8rem 1.35rem 0.95rem;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 800;
        border-top: 1px solid #e2e8f0;
        background: #ffffff;
      }

      .weather-days :global(.weather-day) {
        min-width: 132px;
        padding: 1rem 0.8rem;
        text-align: center;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
      }

      .weather-days :global(.weather-day-name) {
        margin: 0 0 0.65rem;
        color: #0f172a;
        font-size: 0.9rem;
        font-weight: 900;
      }

      .weather-days :global(.weather-icon-wrap) {
        width: 92px;
        height: 92px;
        margin: 0 auto 0.6rem;
        display: grid;
        place-items: center;
      }

      .weather-days :global(.weather-icon) {
        width: 92px;
        height: 92px;
        display: block;
        object-fit: cover;
        border-radius: 18px;
      }

      .weather-days :global(.weather-icon-fallback) {
        font-size: 4.15rem;
        line-height: 1;
      }

      .weather-days :global(.weather-precip) {
        margin: 0.2rem 0 0.45rem;
        color: #1d4ed8;
        font-size: 0.9rem;
        font-weight: 900;
      }

      .weather-days :global(.weather-temp) {
        margin: 0;
        color: #0f172a;
        font-size: 0.98rem;
        font-weight: 900;
      }

      @media (max-width: 720px) {
        .trip-dashboard {
          grid-template-columns: 1fr;
          margin-top: -1.25rem;
        }

        .dashboard-metrics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .dashboard-map-header {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.35rem;
        }

        .weather-card-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.85rem;
          padding: 1rem;
        }

        .weather-summary {
          justify-content: flex-start;
          text-align: left;
        }

        .weather-days {
          grid-template-columns: repeat(7, minmax(118px, 1fr));
          gap: 0.65rem;
          padding: 0.8rem;
        }

        .weather-day {
          min-width: 118px;
          padding: 0.9rem 0.65rem;
        }

        .weather-icon-wrap,
        .weather-icon {
          width: 80px;
          height: 80px;
        }

        .weather-icon-fallback {
          font-size: 3.55rem;
        }

        .weather-days :global(.weather-day) {
          min-width: 118px;
          padding: 0.9rem 0.65rem;
        }

        .weather-days :global(.weather-icon-wrap),
        .weather-days :global(.weather-icon) {
          width: 80px;
          height: 80px;
        }

        .weather-days :global(.weather-icon-fallback) {
          font-size: 3.55rem;
        }
      }

      .section-container {
        margin-bottom: 3rem;
        border: 1px solid var(--soft);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.7);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        padding: 1.25rem;
      }

      .section-static-header {
        padding: 0.25rem 0.25rem 0.75rem;
      }

      .section-static-header h2 {
        margin: 0;
        font-size: clamp(1.45rem, 4vw, 2.1rem);
        letter-spacing: -0.04em;
      }

      .section-kicker {
        display: block;
        margin-top: 0.4rem;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 650;
      }

      .section-scan {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 0.8rem;
      }

      .section-scan-chip {
        display: inline-flex;
        align-items: center;
        min-height: 1.8rem;
        padding: 0.35rem 0.65rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
      }

      .section-banner-image {
        width: 100%;
        aspect-ratio: 21 / 7;
        object-fit: cover;
        object-position: center;
        border-radius: 20px;
        margin: 0.25rem 0 0;
        border: 1px solid var(--soft);
        background: var(--soft-2);
        display: block;
      }

      .section-drawer {
        margin-top: 1rem;
      }

      .section-drawer-summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        font-weight: 800;
      }

      .section-drawer-summary::-webkit-details-marker { display: none; }

      .section-drawer-label {
        font-size: 0.9rem;
      }

      .label-open { display: none; }
      .section-drawer[open] .label-closed { display: none; }
      .section-drawer[open] .label-open { display: inline; }

      .section-chevron {
        width: 1.85rem;
        height: 1.85rem;
        border-radius: 999px;
        display: inline-grid;
        place-items: center;
        color: var(--ink);
        background: var(--soft-2);
        border: 1px solid var(--soft);
        transition: transform 180ms ease, background 180ms ease;
      }

      .section-drawer[open] .section-chevron {
        transform: rotate(90deg);
        background: #ffffff;
      }

      .section-body {
        padding: 1.25rem 0 0;
      }

      .section-intro-panel {
        margin: 1rem 0 0;
        padding: 1.2rem 1.35rem;
        border: 1px solid var(--soft);
        border-radius: 18px;
        background: #ffffff;
        color: #475569;
        line-height: 1.7;
        white-space: pre-line;
      }

      .section-intro-panel p { margin: 0; }

      .empty-section-note {
        margin: 0;
        padding: 1rem 1.2rem;
        border: 1px dashed var(--soft);
        border-radius: 16px;
        color: var(--muted);
        background: var(--soft-2);
        font-weight: 650;
      }

      .places-container { width: 100%; }

      .place-card {
        position: relative;
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .place-image-wrap {
        width: 100%;
        overflow: hidden;
        background: var(--soft-2);
      }

      .place-content .place-image-wrap {
        margin: 1rem 0;
        border: 1px solid var(--soft);
        border-radius: 16px;
      }

      .place-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .place-content .place-image {
        border-radius: 16px;
      }

      .place-content {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }

      .place-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem; }

      .time-badge,
      .category-badge,
      .area-badge,
      .decision-badge,
      .payment-badge,
      .booking-badge,
      .cancellation-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
        line-height: 1;
      }

      .time-badge { background: var(--blue-bg); color: var(--blue-ink); }
      .category-badge { background: var(--amber-bg); color: var(--amber-ink); }
      .category-badge.transport,
      .category-badge.transit { background: var(--purple-bg); color: var(--purple-ink); }
      .area-badge { background: var(--green-bg); color: var(--green-ink); }
      .decision-badge { background: var(--slate-bg); color: var(--slate-ink); }
      .decision-badge.must-do { background: #dcfce7; color: #166534; }
      .decision-badge.weather-dependent { background: #fef3c7; color: #92400e; }
      .decision-badge.maybe,
      .decision-badge.backup { background: #dbeafe; color: #1d4ed8; }
      .decision-badge.avoid-if-tired { background: #ffe4e6; color: #9f1239; }
      .payment-badge.paid { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.unpaid { background: var(--rose-bg); color: var(--rose-ink); }
      .booking-badge.to-book { background: var(--amber-bg); color: var(--amber-ink); border: 1px dashed var(--amber-ink); }
      .booking-badge.booked { background: var(--blue-bg); color: var(--blue-ink); }
      .cancellation-badge.free { background: var(--green-bg); color: var(--green-ink); }
      .cancellation-badge.non-refundable { background: var(--slate-bg); color: var(--slate-ink); }

      .place-card h3 { margin: 0.5rem 0; font-size: 1.35rem; line-height: 1.2; letter-spacing: -0.02em; }
      .short-description { margin: 0.5rem 0; font-weight: 600; color: var(--ink); line-height: 1.5; }
      .place-info { margin: 1rem 0 0; color: #475569; line-height: 1.65; white-space: pre-line; }

      .logistics-block { background: var(--soft-2); padding: 1rem; border-radius: 12px; margin: 1rem 0; font-size: 0.9rem; border: 1px solid var(--soft); }
      .logistics-title { font-weight: 800; text-transform: uppercase; font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; letter-spacing: 0.05em; }
      .logistics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; }
      .logistics-grid p { margin: 0.35rem 0; }

      .detail-list { margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--soft); font-size: 0.95rem; }
      .detail-list p { margin: 0.5rem 0; color: #475569; }

      .place-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
      .place-links a {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: var(--ink);
        color: #ffffff;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        border: none;
        cursor: pointer;
      }

      .place-links a:hover { background: #334155; }

      .food-shortlist {
        margin-top: 1.25rem;
        padding: 1.2rem;
        border: 1px solid var(--soft);
        border-radius: 20px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 10px 26px rgba(15, 23, 42, 0.04);
      }

      .food-shortlist-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-end;
        margin-bottom: 1rem;
      }

      .food-shortlist-title {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
      }

      .food-shortlist-count {
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 800;
        white-space: nowrap;
      }

      .food-shortlist-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .food-map-view {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2rem;
        padding: 0.42rem 0.8rem;
        border-radius: 999px;
        background: var(--ink);
        color: #ffffff;
        border: 0;
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
      }

      .food-map-view:hover {
        background: #334155;
      }

      .food-map-panel {
        margin-bottom: 1rem;
        overflow: hidden;
        border: 1px solid var(--soft);
        border-radius: 16px;
        background: #ffffff;
      }

      .food-map-panel[hidden] {
        display: none;
      }

      .food-map {
        position: relative;
        overflow: hidden;
        width: 100%;
        background: #e2e8f0;
        aspect-ratio: 16 / 9;
      }

      .food-map-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .food-map-tools {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0.85rem;
        border-top: 1px solid var(--soft);
        background: #ffffff;
      }

      .food-location-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2rem;
        padding: 0.42rem 0.8rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
      }

      .food-location-btn:hover {
        background: var(--soft-2);
      }

      .food-location-btn:disabled {
        cursor: wait;
        opacity: 0.7;
      }

      .food-map-status {
        min-width: 0;
        margin: 0;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 750;
        text-align: right;
      }

      @media (max-width: 560px) {
        .dashboard-metrics {
          grid-template-columns: 1fr;
        }

        .dashboard-action-row {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.25rem;
        }

        .dashboard-action-row span:last-child {
          text-align: left;
        }

        .food-map-tools {
          flex-direction: column;
          align-items: stretch;
        }

        .food-map-status {
          text-align: left;
        }
      }

      .food-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
        gap: 1rem;
        align-items: start;
      }

      .food-card {
        position: relative;
        display: grid;
        grid-template-columns: 184px 1fr;
        min-height: 0;
        overflow: hidden;
        border: 1px solid var(--soft);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
      }

      .food-image-wrap {
        height: 184px;
        background: linear-gradient(135deg, #e2e8f0, #f8fafc);
      }

      .food-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .food-image-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 900;
      }

      .food-card-content {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 1rem;
      }

      .food-card h3 {
        margin: 0.65rem 0 0.35rem;
        font-size: 1.12rem;
        line-height: 1.25;
        letter-spacing: -0.02em;
      }

      .food-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }

      .food-badge {
        display: inline-flex;
        align-items: center;
        min-height: 1.55rem;
        padding: 0.24rem 0.55rem;
        border-radius: 999px;
        background: #ffffff;
        color: var(--slate-ink);
        border: 1px solid var(--soft);
        font-size: 0.72rem;
        font-weight: 850;
      }

      .food-badge.booking-needed { background: var(--amber-bg); color: var(--amber-ink); border-color: #fcd34d; }
      .food-badge.booked { background: var(--green-bg); color: var(--green-ink); border-color: #86efac; }
      .food-badge.price { background: #0f172a; color: #ffffff; border-color: #0f172a; letter-spacing: 0.04em; }

      .food-note {
        margin: 0.4rem 0 0;
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .food-hours-details {
        margin: 0.65rem 0 0;
      }

      .food-hours-details summary {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 1.75rem;
        padding: 0.28rem 0.65rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        cursor: pointer;
        font-size: 0.76rem;
        font-weight: 850;
        list-style: none;
      }

      .food-hours-details summary::-webkit-details-marker {
        display: none;
      }

      .food-hours-details summary::after {
        content: "›";
        color: var(--muted);
        font-size: 1rem;
        line-height: 1;
        transform: rotate(90deg);
      }

      .food-hours-details[open] summary::after {
        transform: rotate(-90deg);
      }

      .food-hours {
        display: grid;
        gap: 0.18rem;
        margin: 0.45rem 0 0;
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--soft);
        border-radius: 12px;
        background: #f8fafc;
        color: #475569;
        font-size: 0.78rem;
        line-height: 1.25;
      }

      .food-hours-row {
        display: grid;
        grid-template-columns: 2.2rem 1fr;
        gap: 0.45rem;
      }

      .food-hours-day {
        color: var(--ink);
        font-weight: 850;
      }

      .food-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 0.95rem;
      }

      .food-links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2rem;
        padding: 0.42rem 0.75rem;
        border-radius: 999px;
        border: 1px solid var(--soft);
        background: #ffffff;
        color: var(--ink);
        text-decoration: none;
        font-weight: 800;
        font-size: 0.78rem;
      }

      .food-links a:hover {
        background: var(--soft-2);
      }

      .food-links a[href*="maps"],
      .food-links a[href*="goo.gl"] {
        background: var(--ink);
        color: #ffffff;
        border-color: var(--ink);
      }

      .food-links a[href*="maps"]:hover,
      .food-links a[href*="goo.gl"]:hover {
        background: #334155;
      }

      .layout-grid .places-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .layout-grid .places-container[data-place-count="4"] {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .layout-grid .place-card {
        border-radius: 22px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid var(--soft);
      }

      .layout-grid .place-image { height: auto; }

      .layout-timeline .places-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-left: 3px solid #cbd5e1;
        padding-left: 2rem;
        margin-left: 0.5rem;
      }

      .layout-timeline .place-card {
        display: block;
        box-shadow: none;
      }

      .layout-timeline .place-card::before {
        content: "";
        position: absolute;
        left: -2.65rem;
        top: 1.45rem;
        width: 1rem;
        height: 1rem;
        background: #3b82f6;
        border-radius: 50%;
        border: 4px solid var(--page-bg);
        z-index: 2;
      }

      .layout-timeline .category-transport,
      .layout-timeline .category-transit {
        border-left: 4px solid var(--blue-ink);
      }

      .layout-timeline .category-transport .place-image-wrap,
      .layout-timeline .category-transit .place-image-wrap {
        display: none;
      }

      .layout-timeline .category-transport .place-content,
      .layout-timeline .category-transit .place-content {
        padding: 1.25rem;
      }

      .layout-timeline .place-card h3 { margin-top: 0; }

      @media (max-width: 720px) {
        body { padding: 1rem 0.75rem 3rem; }
        .section-container { padding: 1rem; }
        .section-drawer-summary { padding: 0.8rem 1rem; }
        .section-body { padding: 0 1rem 1rem; }
        .section-banner-image { aspect-ratio: 16 / 7; border-radius: 16px; }
        .layout-timeline .places-container { margin-left: 0.25rem; padding-left: 1.25rem; }
        .layout-timeline .place-card::before { left: -1.9rem; }
        .layout-grid .places-container { grid-template-columns: 1fr; }
        .layout-grid .places-container[data-place-count="4"] { grid-template-columns: 1fr; }
        .food-shortlist-header { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
        .food-shortlist-actions { justify-content: flex-start; }
        .food-grid { grid-template-columns: 1fr; }
        .food-card { grid-template-columns: 1fr; }
        .food-image-wrap { height: 178px; }
        .food-card-content { padding: 1rem; }
        .food-note { -webkit-line-clamp: 3; }

        .weather-card-header {
          flex-direction: column;
          gap: 0.75rem;
        }

        .weather-summary {
          justify-content: flex-start;
          text-align: left;
        }

        .weather-days {
          grid-template-columns: repeat(7, minmax(104px, 1fr));
        }

        .weather-day {
          min-width: 104px;
          padding: 0.85rem 0.6rem 0.95rem;
        }

        .weather-icon-wrap,
        .weather-icon {
          width: 72px;
          height: 72px;
        }

        .weather-icon-fallback {
          font-size: 3.05rem;
        }

        .weather-days :global(.weather-day) {
          min-width: 104px;
          padding: 0.85rem 0.6rem 0.95rem;
        }

        .weather-days :global(.weather-icon-wrap),
        .weather-days :global(.weather-icon) {
          width: 72px;
          height: 72px;
        }

        .weather-days :global(.weather-icon-fallback) {
          font-size: 3.05rem;
        }
      }
    </style>
  </head>
  <body>
    <nav class="back-nav">
      <a href="/" class="back-button">← Back to All Itineraries</a>
    </nav>

    <main>
      <article class="trip-wrapper">
        <header class="trip-header">
          <div class="trip-header-content trip-header-title-block">
            <h1>{trip.title}</h1>
            {trip.startDate && (
              <p class="trip-date"><strong>Departure:</strong> {formatDate(trip.startDate)}</p>
            )}
          </div>

          {trip.heroImageUrl && (
            <img src={trip.heroImageUrl} alt={`${trip.title} hero image`} class="trip-hero-image" />
          )}

          {(trip.heroIntro || hasWeatherConfig(trip.weatherConfig)) && (
            <div class="trip-header-content trip-header-after-image">
              {trip.heroIntro && <p class="hero-intro">{trip.heroIntro}</p>}

              {hasWeatherConfig(trip.weatherConfig) && (
                <section
                  class="weather-card"
                  data-weather-bar
                  data-weather-location={trip.weatherConfig.locationLabel || trip.title}
                  data-weather-lat={trip.weatherConfig.latitude}
                  data-weather-lng={trip.weatherConfig.longitude}
                  aria-label={`7 day weather forecast for ${trip.weatherConfig.locationLabel || trip.title}`}
                >
                  <div class="weather-card-header">
                    <div class="weather-title-wrap">
                      <h2 class="weather-title">{trip.weatherConfig.locationLabel || trip.title} Weather</h2>
                      <span class="weather-subtitle">7 day forecast from today</span>
                    </div>
                    <div class="weather-summary" data-weather-summary>
                      <span>Loading forecast.</span>
                    </div>
                  </div>

                  <div class="weather-loading" data-weather-loading>Fetching weather forecast.</div>
                  <div class="weather-days" data-weather-days hidden></div>
                  <small class="weather-provider">Weather data provided by Open-Meteo</small>

                  <script is:inline type="application/json" class="weather-icon-set" set:html={JSON.stringify(sharedWeatherIconSet)}></script>
                </section>
              )}
            </div>
          )}
        </header>

        <section class={`trip-dashboard ${tripStaticMapUrl ? "" : "no-dashboard-map"}`} aria-label="Trip dashboard">
          <div class="dashboard-panel dashboard-summary">
            <p class="dashboard-eyebrow">Trip dashboard</p>
            <h2 class="dashboard-title">Plan status at a glance</h2>
            <p class="dashboard-intro">
              Quick view of visitable stops, food options, mapped locations, booking actions, and confirmed items in this trip.
            </p>

            <div class="dashboard-metrics">
              <div class="dashboard-metric">
                <strong>{tripSections.length}</strong>
                <span>{getPluralLabel(tripSections.length, "section", "sections")}</span>
              </div>
              <div class="dashboard-metric">
                <strong>{tripStops.length}</strong>
                <span>{getPluralLabel(tripStops.length, "planned stop", "planned stops")}</span>
              </div>
              <div class="dashboard-metric">
                <strong>{tripFoods.length}</strong>
                <span>{getPluralLabel(tripFoods.length, "food option", "food options")}</span>
              </div>
              <div class="dashboard-metric">
                <strong>{tripMapPoints.length}</strong>
                <span>{getPluralLabel(tripMapPoints.length, "mapped location", "mapped locations")}</span>
              </div>
            </div>

            {!tripStaticMapUrl && (
              <p class="dashboard-note">Add coordinates to stops or restaurants to show the trip map here.</p>
            )}

            <div class="dashboard-actions" aria-label="Trip actions">
              <div class="dashboard-action-row">
                <span>Booking actions</span>
                <span>{tripBookingActions.length}</span>
              </div>
              <div class="dashboard-action-row">
                <span>Outstanding payments</span>
                <span>{tripUnpaidItems.length}</span>
              </div>
              <div class="dashboard-action-row">
                <span>Confirmed bookings</span>
                <span>{tripBookedItems.length}</span>
              </div>
            </div>
          </div>

          {tripStaticMapUrl && (
          <section class="dashboard-panel" aria-label="Trip map">
            <header class="dashboard-map-header">
              <h2>Trip map</h2>
              <span class="dashboard-map-count">{tripMapPoints.length} {getPluralLabel(tripMapPoints.length, "point", "points")}</span>
            </header>

            <div
              class="food-map-panel dashboard-map-panel"
              data-nearby-map-panel
              data-nearby-map-points={JSON.stringify(tripMapPoints)}
            >
              <div class="food-map">
                <img
                  src={tripStaticMapUrl}
                  data-nearby-map-image
                  data-base-map-url={tripStaticMapUrl}
                  alt={`${trip.title} trip map`}
                  class="food-map-image"
                  loading="lazy"
                />
              </div>
              <div class="food-map-tools">
                <button class="food-location-btn" type="button" data-nearby-location-button>
                  Show my location
                </button>
                <p class="food-map-status" data-nearby-location-status>
                  Adds you if you are within 6km of these mapped places.
                </p>
              </div>
            </div>
          </section>
          )}
        </section>

        {trip.sections && trip.sections.map((section: any, sectionIndex: number) => {
          const placeCount = section.places?.length || 0;
          const foodShortlist = section.foodShortlist || [];
          const foodShortlistCount = foodShortlist.length;
          const foodMapPoints = getFoodMapPoints(foodShortlist);
          const foodStaticMapUrl = getFoodStaticMapUrl(foodMapPoints, googleMapsStaticApiKey);
          const foodMapId = getSectionMapId(section.sectionTitle, sectionIndex);
          const shouldOpen = section.initialLoadState === "open";
          const sectionScanItems = getSectionScanItems(section);

          return (
            <section class={`section-container layout-${section.layoutStyle || "timeline"}`}>
              <header class="section-static-header">
                <h2>{section.sectionTitle}</h2>
                <span class={`section-kicker ${placeCount === 0 && foodShortlistCount === 0 ? "is-empty" : ""}`}>{getSectionSummary(section)}</span>
                {sectionScanItems.length > 0 && (
                  <div class="section-scan" aria-label={`${section.sectionTitle} quick scan`}>
                    {sectionScanItems.map((item: string) => (
                      <span class="section-scan-chip">{item}</span>
                    ))}
                  </div>
                )}
              </header>

              {section.sectionImageUrl && (
                <img
                  src={section.sectionImageUrl}
                  alt={`${section.sectionTitle} location view`}
                  class="section-banner-image"
                  loading="lazy"
                />
              )}

              {section.sectionIntro && (
                <div class="section-intro-panel">
                  <p>{section.sectionIntro}</p>
                </div>
              )}

              {hasWeatherConfig(section.weatherConfig) && (
                <section
                  class="weather-card section-weather-card"
                  data-weather-bar
                  data-weather-location={section.weatherConfig.locationLabel || section.sectionTitle}
                  data-weather-lat={section.weatherConfig.latitude}
                  data-weather-lng={section.weatherConfig.longitude}
                  aria-label={`7 day weather forecast for ${section.weatherConfig.locationLabel || section.sectionTitle}`}
                >
                  <div class="weather-card-header">
                    <div class="weather-title-wrap">
                      <h3 class="weather-title">{section.weatherConfig.locationLabel || section.sectionTitle} Weather</h3>
                      <span class="weather-subtitle">7 day forecast from today</span>
                    </div>
                    <div class="weather-summary" data-weather-summary>
                      <span>Loading forecast.</span>
                    </div>
                  </div>

                  <div class="weather-loading" data-weather-loading>Fetching weather forecast.</div>
                  <div class="weather-days" data-weather-days hidden></div>
                  <small class="weather-provider">Weather data provided by Open-Meteo</small>

                  <script is:inline type="application/json" class="weather-icon-set" set:html={JSON.stringify(sharedWeatherIconSet)}></script>
                </section>
              )}

              <details class="section-drawer" open={shouldOpen}>
                <summary class="section-drawer-summary">
                  <span class="section-drawer-label">
                    <span class="label-closed">View plans</span>
                    <span class="label-open">Hide plans</span>
                  </span>
                  <span class="section-chevron" aria-hidden="true">›</span>
                </summary>

                <div class="section-body">
                  {placeCount > 0 ? (
                    <div class="places-container" data-place-count={placeCount}>
                      {section.places.map((place: any) => (
                        <article class={`place-card category-${getCategoryClass(place.category)}`}>
                          <div class="place-content">
                            <div class="place-meta">
                              {getPlaceScheduleBadge(place) && (
                                <span class="time-badge">
                                  {getPlaceScheduleBadge(place)}
                                </span>
                              )}

                              {place.category && (
                                <span class={`category-badge ${getCategoryClass(place.category)}`}>
                                  {place.category}
                                </span>
                              )}

                              {place.area && <span class="area-badge">{place.area}</span>}
                              {getDecisionStateLabel(place.decisionStatus) && (
                                <span class={`decision-badge ${getDecisionStateClass(place.decisionStatus)}`}>
                                  {getDecisionStateLabel(place.decisionStatus)}
                                </span>
                              )}

                              {place.paymentStatus === "paid" && <span class="payment-badge paid">✓ Paid</span>}
                              {place.paymentStatus === "unpaid" && place.bookingLogistics?.bookingStatus === "booked" && <span class="payment-badge unpaid">⚠️ Unpaid</span>}

                              {place.bookingLogistics?.bookingStatus === "to-book" && (
                                <span class="booking-badge to-book">
                                  ⏳ To Book {place.bookingLogistics.bookOnDate ? `(On ${formatInlineDate(place.bookingLogistics.bookOnDate)})` : ""}
                                </span>
                              )}

                              {place.bookingLogistics?.bookingStatus === "booked" && (
                                <span class="booking-badge booked">✓ Booked</span>
                              )}

                              {place.costStructure?.cancellationPolicy === "free" && (
                                <span class="cancellation-badge free">
                                  🟢 Free Cancellation {place.costStructure.cancellationDeadline ? `until ${formatInlineDate(place.costStructure.cancellationDeadline)}` : ""}
                                </span>
                              )}

                              {place.costStructure?.cancellationPolicy === "non-refundable" && (
                                <span class="cancellation-badge non-refundable">❌ Non-refundable</span>
                              )}
                            </div>

                            <h3>{place.placeName}</h3>

                            {place.photoUrl && !isTransitCategory(place.category) && (
                              <div class="place-image-wrap">
                                <img
                                  src={place.photoUrl}
                                  alt={place.placeName || ""}
                                  class="place-image"
                                  loading="lazy"
                                />
                              </div>
                            )}

                            {place.shortDescription && <p class="short-description">{place.shortDescription}</p>}

                            {isTransitCategory(place.category) && place.transitDetails && (
                              <div class="logistics-block">
                                <div class="logistics-title">Journey Details</div>
                                <div class="logistics-grid">
                                  {place.transitDetails.origin && <p><strong>From:</strong> {place.transitDetails.origin}</p>}
                                  {place.transitDetails.destination && <p><strong>To:</strong> {place.transitDetails.destination}</p>}
                                  {place.transitDetails.carrier && <p><strong>Carrier:</strong> {place.transitDetails.carrier}</p>}
                                  {place.transitDetails.reference && <p><strong>Ref:</strong> {place.transitDetails.reference}</p>}
                                  {place.transitDetails.seatAssignment && <p><strong>Seat/Class:</strong> {place.transitDetails.seatAssignment}</p>}
                                </div>

                                {place.transitDetails.airportParkingLogistics && place.transitDetails.airportParkingLogistics.status !== "not-needed" && (
                                  <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--soft);">
                                    <p>
                                      <strong>Airport Parking:</strong>
                                      {place.transitDetails.airportParkingLogistics.status === "booked" ? " ✅ Booked" : " ⏳ Required / To Book"}
                                      {place.transitDetails.airportParkingLogistics.locationInfo ? ` - ${place.transitDetails.airportParkingLogistics.locationInfo}` : ""}
                                    </p>
                                  </div>
                                )}

                                {place.transitDetails.bookingDetailsText && (
                                  <div style="margin-top: 0.5rem; font-style: italic; color: var(--muted); font-size: 0.85rem;">
                                    <strong>Booking notes:</strong> {place.transitDetails.bookingDetailsText}
                                  </div>
                                )}
                              </div>
                            )}

                            {place.category === "Hotel" && place.hotelDetails && (
                              <div class="logistics-block">
                                <div class="logistics-title">Stay Details</div>
                                <div class="logistics-grid">
                                  {place.hotelDetails.bookingRef && <p><strong>Booking Ref:</strong> {place.hotelDetails.bookingRef}</p>}
                                  {place.hotelDetails.roomType && <p><strong>Room:</strong> {place.hotelDetails.roomType}</p>}
                                  {place.hotelDetails.checkInNotes && <p><strong>Notes:</strong> {place.hotelDetails.checkInNotes}</p>}
                                </div>
                              </div>
                            )}

                            {place.info && <p class="place-info">{place.info}</p>}

                            {(hasPlaceScheduleDetails(place) || place.costStructure || place.practicalInfo || place.travelNote || place.bookingLogistics) && (
                              <div class="detail-list">
                                {hasPlaceScheduleDetails(place) && (
                                  <>
                                    {hasText(place.schedule?.date) && <p><strong>Date:</strong> {formatInlineDate(place.schedule.date)}</p>}
                                    {(hasText(place.schedule?.startTime) || hasText(place.schedule?.endTime)) && (
                                      <p>
                                        <strong>Time:</strong>
                                        {hasText(place.schedule?.startTime) ? ` ${place.schedule.startTime}` : ""}
                                        {hasText(place.schedule?.endTime) ? ` - ${place.schedule.endTime}` : ""}
                                      </p>
                                    )}
                                    {hasText(place.schedule?.duration) && <p><strong>Duration:</strong> {place.schedule.duration}</p>}
                                    {hasText(place.schedule?.suggestedTime) && <p><strong>Suggested time:</strong> {place.schedule.suggestedTime}</p>}
                                    {getTimingStatusLabel(place.schedule?.timingStatus) && <p><strong>Timing status:</strong> {getTimingStatusLabel(place.schedule.timingStatus)}</p>}
                                    {hasText(place.schedule?.timingNote) && <p><strong>Timing note:</strong> {place.schedule.timingNote}</p>}
                                  </>
                                )}

                                {formatCost(place.costStructure) && (
                                  <p><strong>Price:</strong> {formatCost(place.costStructure)}</p>
                                )}

                                {place.practicalInfo && <p><strong>Good to know:</strong> {place.practicalInfo}</p>}
                                {place.travelNote && <p><strong>Getting there:</strong> {place.travelNote}</p>}

                                {place.bookingLogistics?.bookingStatus === "to-book" && (
                                  <p><strong>Booking:</strong> Required {place.bookingLogistics.bookOnDate ? `- Window opens ${formatInlineDate(place.bookingLogistics.bookOnDate)}` : ""}</p>
                                )}

                                {place.bookingLogistics?.bookingStatus === "booked" && (
                                  <p><strong>Booking:</strong> Confirmed</p>
                                )}
                              </div>
                            )}

                            <div class="place-links">
                              {place.bookingUrl && <a href={place.bookingUrl} target="_blank" rel="noreferrer">Book</a>}
                              {place.websiteUrl && <a href={place.websiteUrl} target="_blank" rel="noreferrer">Website</a>}

                              {getCoordinateMapUrl(place.coordinates) && (
                                <a href={getCoordinateMapUrl(place.coordinates)} target="_blank" rel="noreferrer">Show map</a>
                              )}
                            </div>
                          </div>
                        </article>
                      ))}
                    </div>
                  ) : foodShortlistCount === 0 ? (
                    <p class="empty-section-note">Plans still taking shape for this section.</p>
                  ) : null}

                  {foodShortlistCount > 0 && (
                <aside class="food-shortlist" aria-label={`${section.sectionTitle} food and drink shortlist`}>
                  <header class="food-shortlist-header">
                    <h3 class="food-shortlist-title">Food & drink shortlist</h3>
                    <div class="food-shortlist-actions">
                      <span class="food-shortlist-count">{foodShortlistCount} {foodShortlistCount === 1 ? "option" : "options"}</span>
                      {foodStaticMapUrl && (
                        <button class="food-map-view" type="button" data-food-map-toggle={foodMapId} aria-controls={foodMapId} aria-expanded="false">
                          Map view
                        </button>
                      )}
                    </div>
                  </header>

                  {foodStaticMapUrl && (
                    <div
                      class="food-map-panel"
                      id={foodMapId}
                      data-nearby-map-panel
                      data-nearby-map-points={JSON.stringify(foodMapPoints)}
                      hidden
                    >
                      <div class="food-map">
                        <img
                          src={foodStaticMapUrl}
                          data-nearby-map-image
                          data-base-map-url={foodStaticMapUrl}
                          alt={`${section.sectionTitle} restaurant map`}
                          class="food-map-image"
                          loading="lazy"
                        />
                      </div>
                      <div class="food-map-tools">
                        <button class="food-location-btn" type="button" data-nearby-location-button>
                          Show my location
                        </button>
                        <p class="food-map-status" data-nearby-location-status>
                          Adds you if you are within 6km of these places.
                        </p>
                      </div>
                    </div>
                  )}

                  <div class="food-grid">
                    {foodShortlist.map((food: any) => (
                      <article class="food-card">
                        {(() => {
                          const openingHourRows = getOpeningHourRows(food.openingHours);
                          const mapHref = food.mapUrl || getCoordinateMapUrl(food.coordinates);

                          return (
                            <>
                        <div class="food-image-wrap">
                          {food.imageUrl ? (
                            <img src={food.imageUrl} alt={food.name || ""} class="food-image" loading="lazy" />
                          ) : (
                            <div class="food-image-placeholder" aria-hidden="true">Food</div>
                          )}
                        </div>

                        <div class="food-card-content">
                          <div class="food-meta">
                            {getPriceLabel(food.priceVibe) && <span class="food-badge price">{getPriceLabel(food.priceVibe)}</span>}
                            {food.foodType && <span class="food-badge">{food.foodType}</span>}
                            {food.area && <span class="food-badge">{food.area}</span>}
                            {getDecisionStateLabel(food.decisionStatus) && (
                              <span class={`food-badge decision-badge ${getDecisionStateClass(food.decisionStatus)}`}>
                                {getDecisionStateLabel(food.decisionStatus)}
                              </span>
                            )}
                            {food.bookingStatus === "consider-booking" && <span class="food-badge booking-needed">Consider booking</span>}
                            {food.bookingStatus === "booked" && <span class="food-badge booked">Booked</span>}
                          </div>

                          <h3>{food.name}</h3>

                          {food.shortNote && <p class="food-note">{food.shortNote}</p>}

                          {openingHourRows.length > 0 && (
                            <details class="food-hours-details">
                              <summary>Hours</summary>
                              <div class="food-hours" aria-label={`${food.name} opening hours`}>
                                {openingHourRows.map(([day, hours]) => (
                                  <div class="food-hours-row">
                                    <span class="food-hours-day">{day}</span>
                                    <span>{hours}</span>
                                  </div>
                                ))}
                              </div>
                            </details>
                          )}

                          <div class="food-links">
                            {food.websiteUrl && <a href={food.websiteUrl} target="_blank" rel="noreferrer">Website</a>}
                            {mapHref && <a href={mapHref} target="_blank" rel="noreferrer">Map</a>}
                          </div>
                        </div>
                            </>
                          );
                        })()}
                      </article>
                    ))}
                  </div>
                </aside>
              )}
                </div>
              </details>
            </section>
          );
        })}
      </article>
    </main>

    <script is:inline type="module">
      const weatherBars = Array.from(document.querySelectorAll("[data-weather-bar]"));
      const forecastCache = new Map();

      const fallbackIcons = {
        sunny: "☀️",
        partlyCloudy: "🌤️",
        cloudy: "☁️",
        fog: "🌫️",
        drizzle: "🌦️",
        rain: "🌧️",
        heavyRain: "🌧️",
        snow: "❄️",
        thunderstorm: "⛈️",
      };

      const weatherLabels = {
        sunny: "Sunny",
        partlyCloudy: "Partly sunny",
        cloudy: "Cloudy",
        fog: "Fog",
        drizzle: "Drizzle",
        rain: "Rain",
        heavyRain: "Heavy rain",
        snow: "Snow",
        thunderstorm: "Thunderstorm",
      };

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");
      }

      const nearbyMapLocationLimitKm = 6;

      function getDistanceKm(first, second) {
        const earthRadiusKm = 6371;
        const toRadians = (degrees) => degrees * Math.PI / 180;
        const latDelta = toRadians(second.lat - first.lat);
        const lngDelta = toRadians(second.lng - first.lng);
        const firstLat = toRadians(first.lat);
        const secondLat = toRadians(second.lat);

        const a = Math.sin(latDelta / 2) ** 2
          + Math.cos(firstLat) * Math.cos(secondLat) * Math.sin(lngDelta / 2) ** 2;
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

        return earthRadiusKm * c;
      }

      function getNearestFoodDistanceKm(location, points) {
        if (!points.length) return Number.POSITIVE_INFINITY;

        return Math.min(...points.map((point) => getDistanceKm(location, point)));
      }

      function getCurrentPosition() {
        return new Promise((resolve, reject) => {
          if (!navigator.geolocation) {
            reject(new Error("Geolocation unavailable"));
            return;
          }

          navigator.geolocation.getCurrentPosition(resolve, reject, {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 60000,
          });
        });
      }

      function addCurrentLocationToMap(baseMapUrl, location) {
        const url = new URL(baseMapUrl);
        url.searchParams.append("markers", `color:blue|label:Y|${location.lat},${location.lng}`);
        return url.toString();
      }

      document.querySelectorAll("[data-nearby-map-panel]").forEach((panel) => {
        const locationButton = panel.querySelector("[data-nearby-location-button]");
        const status = panel.querySelector("[data-nearby-location-status]");
        const mapImage = panel.querySelector("[data-nearby-map-image]");

        if (!locationButton || !status || !mapImage) return;

        locationButton.addEventListener("click", async () => {
          let points = [];

          try {
            points = JSON.parse(panel.getAttribute("data-nearby-map-points") || "[]");
          } catch {
            points = [];
          }

          if (!points.length) {
            status.textContent = "No coordinates are available for this map.";
            return;
          }

          locationButton.disabled = true;
          status.textContent = "Checking your location...";

          try {
            const position = await getCurrentPosition();
            const location = {
              lat: position.coords.latitude,
              lng: position.coords.longitude,
            };
            const nearestDistanceKm = getNearestFoodDistanceKm(location, points);

            if (nearestDistanceKm > nearbyMapLocationLimitKm) {
              const distanceLabel = nearestDistanceKm < 10
                ? `${nearestDistanceKm.toFixed(1)}km`
                : `${Math.round(nearestDistanceKm)}km`;
              status.textContent = `You are ${distanceLabel} from the nearest place, so the map stayed focused here.`;
              mapImage.src = mapImage.getAttribute("data-base-map-url") || mapImage.src;
              return;
            }

            mapImage.src = addCurrentLocationToMap(mapImage.getAttribute("data-base-map-url") || mapImage.src, location);
            status.textContent = "Blue Y marker added for your location.";
          } catch {
            status.textContent = "Location was not available. Check browser permission and try again.";
          } finally {
            locationButton.disabled = false;
          }
        });
      });

      document.querySelectorAll("[data-food-map-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const panelId = button.getAttribute("data-food-map-toggle");
          const panel = panelId ? document.getElementById(panelId) : null;

          if (!panel) return;

          const isOpening = panel.hidden;
          panel.hidden = !isOpening;
          button.setAttribute("aria-expanded", String(isOpening));

          if (isOpening) {
            panel.scrollIntoView({ block: "nearest", behavior: "smooth" });
          }
        });
      });

      function getWeatherKey(code) {
        const numericCode = Number(code);

        if (numericCode === 0) return "sunny";
        if ([1, 2].includes(numericCode)) return "partlyCloudy";
        if (numericCode === 3) return "cloudy";
        if ([45, 48].includes(numericCode)) return "fog";
        if ([51, 53, 55, 56, 57].includes(numericCode)) return "drizzle";
        if ([61, 80].includes(numericCode)) return "rain";
        if ([63, 65, 66, 67, 81, 82].includes(numericCode)) return "heavyRain";
        if ([71, 73, 75, 77, 85, 86].includes(numericCode)) return "snow";
        if ([95, 96, 99].includes(numericCode)) return "thunderstorm";

        return "partlyCloudy";
      }

      function formatTemperature(value) {
        if (value === null || value === undefined || Number.isNaN(Number(value))) return "-";
        return `${Math.round(Number(value))}°`;
      }

      function formatPrecipitation(value) {
        if (value === null || value === undefined || Number.isNaN(Number(value))) return "-";
        return `${Math.round(Number(value))}%`;
      }

      function formatDayLabel(dateValue, index) {
        if (index === 0) return "Today";

        const date = new Date(`${dateValue}T12:00:00`);
        return new Intl.DateTimeFormat("en-GB", { weekday: "short" }).format(date);
      }

      function getIconHtml(iconSet, weatherKey, description) {
        const iconUrl = iconSet?.[`${weatherKey}Url`];

        if (iconUrl) {
          return `<img src="${escapeHtml(getWeatherIconImageUrl(iconUrl))}" alt="${escapeHtml(description)}" class="weather-icon" loading="lazy" />`;
        }

        return `<span class="weather-icon-fallback" aria-label="${escapeHtml(description)}" role="img">${fallbackIcons[weatherKey] || "🌤️"}</span>`;
      }

      function getWeatherIconImageUrl(iconUrl) {
        try {
          const url = new URL(iconUrl);
          if (url.hostname === "cdn.sanity.io") {
            url.searchParams.set("w", "184");
            url.searchParams.set("h", "184");
            url.searchParams.set("fit", "crop");
            url.searchParams.set("auto", "format");
          }
          return url.toString();
        } catch {
          return iconUrl;
        }
      }

      function readIconSet(card) {
        const iconSetElement = card.querySelector(".weather-icon-set");

        if (!iconSetElement?.textContent) {
          return {};
        }

        try {
          return JSON.parse(iconSetElement.textContent);
        } catch {
          return {};
        }
      }

      async function fetchForecast(latitude, longitude) {
        const cacheKey = `${latitude},${longitude}`;

        if (forecastCache.has(cacheKey)) {
          return forecastCache.get(cacheKey);
        }

        const params = new URLSearchParams({
          latitude,
          longitude,
          daily: "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max",
          timezone: "auto",
          forecast_days: "7",
        });

        const forecastPromise = fetch(`https://api.open-meteo.com/v1/forecast?${params.toString()}`).then((response) => {
          if (!response.ok) {
            throw new Error("Weather request failed");
          }

          return response.json();
        });

        forecastCache.set(cacheKey, forecastPromise);
        return forecastPromise;
      }

      function renderForecast(card, data, iconSet) {
        const daily = data?.daily;
        const summary = card.querySelector("[data-weather-summary]");
        const loading = card.querySelector("[data-weather-loading]");
        const daysContainer = card.querySelector("[data-weather-days]");

        if (!daily?.time?.length || !daysContainer || !summary) {
          throw new Error("Weather data was incomplete");
        }

        const firstWeatherKey = getWeatherKey(daily.weather_code?.[0]);
        const firstDescription = weatherLabels[firstWeatherKey] || "Forecast";

        summary.innerHTML = `
          <span>${escapeHtml(firstDescription)}</span>
          <span>High: ${formatTemperature(daily.temperature_2m_max?.[0])}</span>
          <span>Low: ${formatTemperature(daily.temperature_2m_min?.[0])}</span>
          <span>Precip: ${formatPrecipitation(daily.precipitation_probability_max?.[0])}</span>
        `;

        daysContainer.innerHTML = daily.time.slice(0, 7).map((dateValue, index) => {
          const weatherKey = getWeatherKey(daily.weather_code?.[index]);
          const description = weatherLabels[weatherKey] || "Forecast";
          const low = formatTemperature(daily.temperature_2m_min?.[index]);
          const high = formatTemperature(daily.temperature_2m_max?.[index]);
          const precipitation = formatPrecipitation(daily.precipitation_probability_max?.[index]);

          return `
            <article class="weather-day">
              <p class="weather-day-name">${escapeHtml(formatDayLabel(dateValue, index))}</p>
              <div class="weather-icon-wrap">
                ${getIconHtml(iconSet, weatherKey, description)}
              </div>
              <p class="weather-precip">${escapeHtml(precipitation)}</p>
              <p class="weather-temp">${escapeHtml(low)} / ${escapeHtml(high)}</p>
            </article>
          `;
        }).join("");

        if (loading) {
          loading.hidden = true;
        }

        daysContainer.hidden = false;
      }

      function renderWeatherError(card) {
        const loading = card.querySelector("[data-weather-loading]");
        const daysContainer = card.querySelector("[data-weather-days]");
        const summary = card.querySelector("[data-weather-summary]");

        if (summary) {
          summary.innerHTML = "<span>Forecast unavailable</span>";
        }

        if (daysContainer) {
          daysContainer.hidden = true;
        }

        if (loading) {
          loading.hidden = false;
          loading.className = "weather-error";
          loading.textContent = "Weather forecast could not be loaded right now.";
        }
      }

      await Promise.all(weatherBars.map(async (card) => {
        const latitude = card.getAttribute("data-weather-lat");
        const longitude = card.getAttribute("data-weather-lng");
        const iconSet = readIconSet(card);

        if (!latitude || !longitude) {
          renderWeatherError(card);
          return;
        }

        try {
          const data = await fetchForecast(latitude, longitude);
          renderForecast(card, data, iconSet);
        } catch {
          renderWeatherError(card);
        }
      }));
    </script>
  </body>
</html>
