---
import { sanityClient } from "sanity:client";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(`*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] { "slug": slug.current }`);
  return data.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const query = `*[_type == "trip" && slug.current == $slug][0] {
  title,
  startDate,
  coordinates,
  heroIntro,
  "heroImageUrl": heroImage.asset->url,
  sections[] {
    sectionTitle,
    cityRegion,
    "sectionImageUrl": sectionImage.asset->url,
    sectionIntro,
    layoutStyle,
    places[] {
      placeName,
      time,
      endTime,
      category,
      area,
      shortDescription,
      info,
      practicalInfo,
      costStructure,
      bookingLogistics,
      paymentStatus,
      bookingUrl,
      websiteUrl,
      travelNote,
      "photoUrl": photo.asset->url,
      coordinates,
      transitDetails,
      hotelDetails
    }
  }
}`;

const trip = await sanityClient.fetch(query, { slug });

if (!trip) {
  return Astro.redirect("/404");
}

let weatherForecast = null;
if (trip.coordinates?.lat && trip.coordinates?.lng) {
  try {
    const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${trip.coordinates.lat}&longitude=${trip.coordinates.lng}&daily=weathercode,temperature_2m_max,temperature_2m_min&timezone=auto`;
    const response = await fetch(weatherUrl);
    if (response.ok) {
      const data = await response.json();
      weatherForecast = data.daily?.time.map((dateStr: string, idx: number) => {
        return {
          date: new Date(dateStr).toLocaleDateString("en-GB", { weekday: "short", day: "numeric" }),
          maxTemp: Math.round(data.daily.temperature_2m_max[idx]),
          minTemp: Math.round(data.daily.temperature_2m_min[idx]),
          code: data.daily.weathercode[idx]
        };
      });
    }
  } catch (e) {
    console.error("Failed executing weather matrix endpoint build trigger", e);
  }
}

const getWeatherIcon = (code: number) => {
  if (code === 0) return "☀️ Sunny";
  if (code >= 1 && code <= 3) return "⛅ Partly Cloudy";
  if (code >= 45 && code <= 48) return "🌫️ Foggy";
  if (code >= 51 && code <= 67) return "🌧️ Rain Drizzle";
  if (code >= 71 && code <= 77) return "❄️ Snowing";
  if (code >= 80 && code <= 82) return "🌦️ Showers";
  if (code >= 95) return "⛈️ Thunderstorms";
  return "🌤️ Clear";
};

const EXCHANGE_RATES: Record<string, number> = {
  EUR: 0.85,
  CNY: 0.11,
  JPY: 0.0052,
  CHF: 0.88,
  GBP: 1.0
};

const CURRENCY_SYMBOLS: Record<string, string> = {
  EUR: "€",
  CNY: "¥",
  JPY: "¥",
  CHF: "CHF ",
  GBP: "£"
};

const formatCost = (costObj: any) => {
  if (!costObj) return "";
  const { localAmount, currencyType, textFallback } = costObj;
  
  if (localAmount !== undefined && localAmount !== null) {
    const symbol = CURRENCY_SYMBOLS[currencyType] || "£";
    const localFormatted = `${symbol}${localAmount.toLocaleString("en-GB")}`;
    if (currencyType === "GBP") return localFormatted;
    
    const rate = EXCHANGE_RATES[currencyType] || 1;
    const gbpEquivalent = Math.round(localAmount * rate);
    return `${localFormatted} (£${gbpEquivalent.toLocaleString("en-GB")})`;
  }
  
  return textFallback || "";
};

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const formatInlineDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
};

// Split logic helper: check if an entry belongs in a timeline or a visual card grid
const isTransportItem = (item: any) => item.category === "Transport";
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{trip.title} | Trip Execution Plan</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --purple-bg: #f3e8ff;
        --purple-ink: #6b21a8;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
        --slate-bg: #e2e8f0;
        --slate-ink: #334155;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        color: var(--ink);
        background: var(--page-bg);
      }

      .back-nav { margin-bottom: 2rem; }
      .back-button { text-decoration: none; font-weight: 700; color: var(--muted); font-size: 0.95rem; }
      .back-button:hover { color: var(--ink); }

      /* --- UNIFIED HIERARCHY STYLING MATRIX --- */
      .trip-hero {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        margin-bottom: 3rem;
        border: 1px solid var(--soft);
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
      }

      /* Tier 1 Image: Fixed High-Density Canopy */
      .trip-hero img { 
        width: 100%; 
        aspect-ratio: 21 / 9;
        object-fit: cover; 
        display: block; 
      }
      .trip-header-content { padding: 2rem; }
      .trip-header-content h1 { margin: 0 0 0.75rem; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1; letter-spacing: -0.05em; }
      .trip-date { margin: 0; color: var(--muted); font-weight: 650; }
      .hero-intro { max-width: 760px; margin: 1.25rem 0 0; color: #475569; line-height: 1.7; white-space: pre-line; }

      .weather-section {
        background: #ffffff;
        border: 1px solid var(--soft);
        border-radius: 24px;
        padding: 1.5rem;
        margin-bottom: 3.5rem;
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.03);
      }
      .weather-title { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin: 0 0 1rem; }
      .weather-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 0.75rem; }
      .weather-day-card { background: var(--soft-2); padding: 0.75rem; border-radius: 14px; text-align: center; }
      .weather-day-name { font-size: 0.85rem; font-weight: 700; color: var(--slate-ink); margin-bottom: 0.25rem; }
      .weather-day-icon { font-size: 1.1rem; margin: 0.35rem 0; }
      .weather-day-temps { font-size: 0.85rem; font-weight: 800; }
      .weather-day-temps .min-t { color: var(--muted); font-weight: 500; margin-left: 0.25rem; }

      .city-section { margin-block: 4rem; }
      .city-header { margin-bottom: 1.5rem; }
      .section-location-eyebrow { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--blue-ink); margin: 0 0 0.35rem; }
      .city-header h2 { margin: 0 0 0.5rem; font-size: clamp(1.8rem, 5vw, 2.6rem); letter-spacing: -0.04em; line-height: 1.1; }
      .city-header-summary { font-size: 0.95rem; color: var(--muted); margin: 0; }

      /* Tier 2 Image: Panoramic City Banner Belt */
      .city-hero { 
        width: 100%; 
        aspect-ratio: 16 / 5;
        object-fit: cover; 
        border-radius: 24px; 
        margin: 1rem 0 2rem; 
        border: 1px solid var(--soft); 
        display: block; 
        background: var(--soft-2);
      }

      /* --- NEW COMPOSITIONAL LAYOUT BLOCKS --- */
      
      /* 1. Logistical Timelines (Flights / Rail Connections) */
      .logistics-timeline-container {
        margin-bottom: 2.5rem;
        border-left: 3px solid #cbd5e1;
        padding-left: 1.5rem;
        margin-left: 0.5rem;
      }
      .timeline-card {
        position: relative;
        background: var(--soft-2);
        border: 1px solid var(--soft);
        border-radius: 18px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
      }
      .timeline-card:last-child { margin-bottom: 0; }
      .timeline-card::before {
        content: ""; position: absolute; left: -2.1rem; top: 1.5rem; width: 10px; height: 10px; background: var(--purple-ink); border-radius: 50%; border: 3px solid var(--page-bg);
      }
      .timeline-header-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
      .timeline-card h4 { margin: 0; font-size: 1.2rem; tracking: -0.02em; }

      /* 2. Responsive Card Grids (Attractions / Hotels) */
      .attraction-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
        gap: 1.5rem;
      }
      .attraction-card {
        overflow: hidden;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid var(--soft);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
        display: flex;
        flex-direction: column;
      }

      /* Tier 3 Image: Standard Unified Card Frame */
      .attraction-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        background: var(--soft-2);
        border-bottom: 1px solid var(--soft);
      }
      .attraction-card-content { padding: 1.25rem; flex-grow: 1; display: flex; flex-direction: column; }
      .attraction-card-content h3 { margin: 0.5rem 0; font-size: 1.3rem; line-height: 1.2; letter-spacing: -0.025em; }

      .status-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
      .time-badge, .category-badge, .area-badge, .payment-badge, .booking-badge, .cancellation-badge { display: inline-flex; align-items: center; padding: 0.25rem 0.6rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; line-height: 1; }
      .time-badge { background: var(--blue-bg); color: var(--blue-ink); }
      .category-badge { background: var(--amber-bg); color: var(--amber-ink); }
      .category-badge.transport { background: var(--purple-bg); color: var(--purple-ink); }
      .area-badge { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.paid { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.unpaid { background: var(--rose-bg); color: var(--rose-ink); }
      .booking-badge.to-book { background: var(--amber-bg); color: var(--amber-ink); border: 1px dashed var(--amber-ink); }
      .booking-badge.booked { background: var(--blue-bg); color: var(--blue-ink); }
      .cancellation-badge.free { background: var(--green-bg); color: var(--green-ink); }
      .cancellation-badge.non-refundable { background: var(--slate-bg); color: var(--slate-ink); }

      .short-description { margin: 0.4rem 0; font-weight: 600; font-size: 0.95rem; line-height: 1.5; color: var(--ink); }
      .place-info { margin: 0.75rem 0 0; color: #475569; font-size: 0.9rem; line-height: 1.6; white-space: pre-line; }

      .logistics-grid-inline { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.5rem; font-size: 0.85rem; background: var(--soft-2); padding: 0.75rem; border-radius: 10px; margin: 0.75rem 0; border: 1px solid var(--soft); }
      .detail-list { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--soft); font-size: 0.9rem; }
      .detail-list p { margin: 0.4rem 0; color: #475569; }

      .place-links { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
      .place-links a, .copy-coords-btn { display: inline-flex; align-items: center; padding: 0.5rem 0.85rem; border-radius: 999px; background: var(--ink); color: #ffffff; text-decoration: none; font-weight: 700; font-size: 0.8rem; border: none; cursor: pointer; }
      .place-links a:hover, .copy-coords-btn:hover { background: #334155; }
      .copy-coords-btn { background: transparent; color: var(--ink); border: 1px solid var(--soft); }
      .copy-coords-btn:hover { background: var(--soft-2); }

      @media (max-width: 768px) {
        .trip-hero img { aspect-ratio: 16 / 7; }
        .city-hero { aspect-ratio: 16 / 6; }
        .logistics-timeline-container { margin-left: 0.25rem; padding-left: 1rem; }
        .timeline-card::before { left: -1.45rem; }
      }
    </style>
  </head>
  <body>
    <nav class="back-nav">
      <a href="/" class="back-button">← Back to All Itineraries</a>
    </nav>

    <main class="trip-page">
      <section class="trip-hero">
        {trip.heroImageUrl && (
          <img src={trip.heroImageUrl} alt={`${trip.title} hero banner`} width="1600" height="685" fetchpriority="high" decoding="async" />
        )}
        <div class="trip-header-content">
          <p class="trip-date"><strong>Departure:</strong> {formatDate(trip.startDate)}</p>
          <h1>{trip.title}</h1>
          {trip.heroIntro && <p class="hero-intro">{trip.heroIntro}</p>}
        </div>
      </section>

      {weatherForecast && (
        <div class="weather-section">
          <h4 class="weather-title">🌤️ Live 7-Day Forecast Summary</h4>
          <div class="weather-grid">
            {weatherForecast.map((day: any) => (
              <div class="weather-day-card">
                <div class="weather-day-name">{day.date}</div>
                <div class="weather-day-icon">{getWeatherIcon(day.code)}</div>
                <div class="weather-day-temps">
                  <span class="max-t">{day.maxTemp}°C</span>
                  <span class="min-t">{day.minTemp}°C</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {trip.sections && trip.sections.map((section: any) => {
        const transportItems = section.places?.filter(isTransportItem) || [];
        const destinationItems = section.places?.filter((item: any) => !isTransportItem(item)) || [];
        const actionsRequired = section.places?.filter((p: any) => p.bookingLogistics?.bookingStatus === "to-book").length || 0;

        return (
          <section class="city-section">
            <header class="city-header">
              {section.cityRegion && <p class="section-location-eyebrow">📍 {section.cityRegion}</p>}
              <h2>{section.sectionTitle}</h2>
              <p class="city-header-summary">
                {section.places?.length || 0} items mapped • {actionsRequired} booking action{actionsRequired !== 1 ? 's' : ''} required
              </p>
            </header>

            {section.sectionImageUrl && (
              <img src={section.sectionImageUrl} alt={`${section.cityRegion || section.sectionTitle} location view`} class="city-hero" width="1120" height="350" loading="lazy" decoding="async" />
            )}

            {section.sectionIntro && <p style="color: var(--muted); margin-bottom: 2rem; line-height:1.6;">{section.sectionIntro}</p>}

            {/* --- COMPOSITIONAL SEPARATION TIER 1: THE LOGISTICS TIMELINE --- */}
            {transportItems.length > 0 && (
              <div class="logistics-timeline-container">
                {transportItems.map((place: any) => (
                  <div class="timeline-card">
                    <div class="timeline-header-row">
                      <h4>{place.placeName}</h4>
                      <div class="status-row" style="margin:0;">
                        {place.time && <span class="time-badge">{place.time}{place.endTime ? ` - ${place.endTime}` : ""}</span>}
                        <span class="category-badge transport">Transit</span>
                        {place.paymentStatus === "paid" && <span class="payment-badge paid">✓ Paid</span>}
                        {place.paymentStatus === "unpaid" && <span class="payment-badge unpaid">⚠️ Unpaid</span>}
                      </div>
                    </div>
                    {place.shortDescription && <p class="short-description">{place.shortDescription}</p>}
                    {place.transitDetails && (
                      <div class="logistics-grid-inline">
                        {place.transitDetails.origin && <p><strong>From:</strong> {place.transitDetails.origin}</p>}
                        {place.transitDetails.destination && <p><strong>To:</strong> {place.transitDetails.destination}</p>}
                        {place.transitDetails.carrier && <p><strong>Line:</strong> {place.transitDetails.carrier}</p>}
                        {place.transitDetails.reference && <p><strong>Ref:</strong> {place.transitDetails.reference}</p>}
                      </div>
                    )}
                    {place.transitDetails?.bookingDetailsText && <p class="place-info" style="font-style:italic;"><strong>Booking Dets:</strong> {place.transitDetails.bookingDetailsText}</p>}
                    {place.info && <p class="place-info">{place.info}</p>}
                  </div>
                ))}
              </div>
            )}

            {/* --- COMPOSITIONAL SEPARATION TIER 2: THE CARD GRID --- */}
            {destinationItems.length > 0 && (
              <div class="attraction-grid">
                {destinationItems.map((place: any) => (
                  <article class="attraction-card">
                    {place.photoUrl && (
                      <img src={place.photoUrl} alt={place.placeName} width="400" height="225" loading="lazy" decoding="async" />
                    )}
                    <div class="attraction-card-content">
                      <div class="place-meta">
                        {place.time && <span class="time-badge">{place.time}</span>}
                        {place.category && <span class="category-badge">{place.category}</span>}
                        {place.area && <span class="area-badge">{place.area}</span>}
                        {place.paymentStatus === "paid" && <span class="payment-badge paid">✓ Paid</span>}
                        {place.paymentStatus === "unpaid" && <span class="payment-badge unpaid">⚠️ Unpaid</span>}
                        {place.bookingLogistics?.bookingStatus === "to-book" && <span class="booking-badge to-book">⏳ To Book</span>}
                        {place.bookingLogistics?.bookingStatus === "booked" && <span class="booking-badge booked">✓ Booked</span>}
                      </div>

                      <h3>{place.placeName}</h3>
                      {place.shortDescription && <p class="short-description">{place.shortDescription}</p>}
                      {place.info && <p class="place-info">{place.info}</p>}
                      
                      {place.category === "Hotel" && place.hotelDetails && (
                        <div class="logistics-grid-inline">
                          {place.hotelDetails.bookingRef && <p><strong>Ref:</strong> {place.hotelDetails.bookingRef}</p>}
                          {place.hotelDetails.roomType && <p><strong>Room:</strong> {place.hotelDetails.roomType}</p>}
                        </div>
                      )}

                      {(place.costStructure || place.practicalInfo || place.travelNote) && (
                        <div class="detail-list">
                          {formatCost(place.costStructure) && <p><strong>Price:</strong> {formatCost(place.costStructure)}</p>}
                          {place.costStructure?.cancellationPolicy === "free" && (
                            <p style="color:var(--green-ink); font-size:0.85rem;">
                              ✓ Free cancellation until {formatInlineDate(place.costStructure.cancellationDeadline)}
                            </p>
                          )}
                          {place.practicalInfo && <p><strong>Good to know:</strong> {place.practicalInfo}</p>}
                          {place.travelNote && <p><strong>Transit Note:</strong> {place.travelNote}</p>}
                        </div>
                      )}

                      <div class="place-links">
                        {place.bookingUrl && <a href={place.bookingUrl} target="_blank" rel="noreferrer">Book</a>}
                        {place.websiteUrl && <a href={place.websiteUrl} target="_blank" rel="noreferrer">Website</a>}
                        {place.coordinates && (
                          <button class="copy-coords-btn" onclick={`navigator.clipboard.writeText('${place.coordinates.lat},${place.coordinates.lng}'); this.innerText = 'Copied!'; setTimeout(() => this.innerText = '📋 Coords', 1500);`}>
                            📋 Coords
                          </button>
                        )}
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>
        );
      })}
    </main>
  </body>
</html>
