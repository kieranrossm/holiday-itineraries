---
import { sanityClient } from "sanity:client";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(`*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] { "slug": slug.current }`);
  return data.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const query = `*[_type == "trip" && slug.current == $slug][0] {
  title,
  startDate,
  heroIntro,
  heroWeatherForecast {
    enabled,
    locationName,
    coordinates
  },
  "heroImageUrl": heroImage.asset->url,
  sections[] {
    sectionTitle,
    sectionIntro,
    "sectionImageUrl": sectionImage.asset->url,
    layoutStyle,
    initialLoadState,
    weatherForecast {
      enabled,
      locationName,
      coordinates
    },
    places[] {
      placeName,
      time,
      endTime,
      category,
      area,
      shortDescription,
      info,
      practicalInfo,
      costStructure,
      bookingLogistics,
      paymentStatus,
      bookingUrl,
      websiteUrl,
      travelNote,
      "photoUrl": photo.asset->url,
      coordinates,
      transitDetails,
      hotelDetails
    }
  }
}`;

const trip = await sanityClient.fetch(query, { slug });

if (!trip) {
  return Astro.redirect("/404");
}

const EXCHANGE_RATES: Record<string, number> = {
  EUR: 0.85,
  CNY: 0.11,
  JPY: 0.0052,
  CHF: 0.88,
  GBP: 1.0,
};

const CURRENCY_SYMBOLS: Record<string, string> = {
  EUR: "€",
  CNY: "¥",
  JPY: "¥",
  CHF: "CHF ",
  GBP: "£",
};

const formatCost = (costObj: any) => {
  if (!costObj) return "";
  const { localAmount, currencyType, textFallback } = costObj;

  if (localAmount !== undefined && localAmount !== null) {
    const symbol = CURRENCY_SYMBOLS[currencyType] || "£";
    const localFormatted = `${symbol}${localAmount.toLocaleString("en-GB")}`;

    if (currencyType === "GBP") return localFormatted;

    const rate = EXCHANGE_RATES[currencyType] || 1;
    const gbpEquivalent = Math.round(localAmount * rate);
    return `${localFormatted} (£${gbpEquivalent.toLocaleString("en-GB")})`;
  }

  return textFallback || "";
};

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const formatInlineDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};

const getBookingActionCount = (section: any) => {
  return (section.places || []).filter((place: any) => place.bookingLogistics?.bookingStatus === "to-book").length;
};

const getSectionSummary = (section: any) => {
  const placeCount = section.places?.length || 0;
  const bookingActions = getBookingActionCount(section);

  if (placeCount === 0) return "Plans still taking shape";

  const itemLabel = placeCount === 1 ? "stop" : "stops";
  const bookingSummary = bookingActions === 0
    ? "No booking actions"
    : `${bookingActions} ${bookingActions === 1 ? "booking action" : "booking actions"}`;
  return `${placeCount} ${itemLabel} mapped • ${bookingSummary}`;
};

const getCategoryClass = (category: string | undefined) => {
  if (!category) return "other";
  return category.toLowerCase().replace(/[^a-z0-9]+/g, "-");
};

const isTransitCategory = (category: string | undefined) => {
  return category === "Transport" || category === "Transit";
};

const hasWeatherForecast = (forecast: any) => {
  return Boolean(forecast?.enabled && (forecast.locationName || forecast.coordinates?.lat !== undefined));
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{trip.title} | Trip Execution Plan</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --purple-bg: #f3e8ff;
        --purple-ink: #6b21a8;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
        --slate-bg: #e2e8f0;
        --slate-ink: #334155;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        margin: 0;
        padding: 2rem 1rem 4rem;
        color: var(--ink);
        background: var(--page-bg);
      }

      .back-nav,
      .trip-wrapper {
        max-width: 1120px;
        margin-left: auto;
        margin-right: auto;
      }

      .back-nav { margin-bottom: 2rem; }
      .back-button { text-decoration: none; font-weight: 700; color: var(--muted); font-size: 0.95rem; }
      .back-button:hover { color: var(--ink); }

      .trip-header {
        margin-bottom: 3.5rem;
        border: 1px solid var(--soft);
        border-radius: 28px;
        background: #ffffff;
        box-shadow: 0 15px 40px rgba(15, 23, 42, 0.05);
        overflow: hidden;
      }

      .trip-hero-image {
        width: 100%;
        aspect-ratio: 21 / 9;
        max-height: 460px;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .trip-header-content { padding: clamp(1.5rem, 4vw, 2.25rem); }
      .trip-header h1 { margin: 0 0 0.75rem; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; letter-spacing: -0.05em; }
      .trip-date { margin: 0; color: var(--muted); font-weight: 650; }
      .hero-intro { max-width: 820px; margin: 1.25rem 0 0; color: #475569; line-height: 1.7; white-space: pre-line; }

      .weather-forecast-card {
        margin-top: 1.5rem;
        padding: clamp(1rem, 2vw, 1.25rem);
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 24px;
        background:
          radial-gradient(circle at top left, rgba(219, 234, 254, 0.9), transparent 34%),
          linear-gradient(180deg, #ffffff, #f8fafc);
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
      }

      .hero-weather {
        margin-top: 1.5rem;
      }

      .section-weather {
        margin: 1rem 0 1.25rem;
      }

      .weather-forecast-header {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin-bottom: 1rem;
      }

      .weather-forecast-title {
        display: flex;
        flex-direction: column;
        gap: 0.18rem;
      }

      .weather-eyebrow {
        color: var(--blue-ink);
        font-size: 0.74rem;
        font-weight: 900;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .weather-location {
        color: var(--ink);
        font-size: clamp(1.05rem, 2vw, 1.25rem);
        font-weight: 900;
        letter-spacing: -0.02em;
      }

      .weather-source-note {
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 750;
      }

      .weather-status {
        margin: 0;
        color: var(--muted);
        font-weight: 650;
      }

      .weather-days {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
        gap: 0.85rem;
      }

      .weather-day {
        min-width: 0;
        padding: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.92);
        text-align: center;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
      }

      .weather-day-name {
        display: block;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .weather-icon-frame {
        display: grid;
        place-items: center;
        width: 76px;
        height: 76px;
        margin: 0.75rem auto;
        border-radius: 22px;
        background:
          radial-gradient(circle at 30% 20%, #ffffff, rgba(255, 255, 255, 0.4) 45%, transparent 70%),
          var(--blue-bg);
        box-shadow: inset 0 0 0 1px rgba(29, 78, 216, 0.08);
      }

      .weather-icon {
        display: block;
        font-size: 2.7rem;
        line-height: 1;
      }

      .weather-condition {
        display: block;
        min-height: 2.2em;
        color: #475569;
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1.15;
      }

      .weather-temp {
        display: block;
        margin-top: 0.55rem;
        color: var(--ink);
        font-weight: 950;
        font-size: 1.05rem;
        letter-spacing: -0.03em;
      }

      .weather-rain {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 0.5rem;
        padding: 0.25rem 0.55rem;
        border-radius: 999px;
        background: var(--soft-2);
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 800;
      }

      .section-container {
        margin-bottom: 3rem;
        border: 1px solid var(--soft);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.7);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        padding: 1.25rem;
      }

      .section-static-header {
        padding: 0.25rem 0.25rem 0.75rem;
      }

      .section-static-header h2 {
        margin: 0;
        font-size: clamp(1.45rem, 4vw, 2.1rem);
        letter-spacing: -0.04em;
      }

      .section-kicker {
        display: block;
        margin-top: 0.4rem;
        color: var(--muted);
        font-size: 0.92rem;
        font-weight: 650;
      }

      .section-banner-image {
        width: 100%;
        aspect-ratio: 21 / 7;
        object-fit: cover;
        object-position: center;
        border-radius: 20px;
        margin: 0.25rem 0 1rem;
        border: 1px solid var(--soft);
        background: var(--soft-2);
        display: block;
      }

      .section-drawer {
        margin-top: 0.75rem;
      }

      .section-drawer-summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        font-weight: 800;
      }

      .section-drawer-summary::-webkit-details-marker { display: none; }

      .section-drawer-label {
        font-size: 0.9rem;
      }

      .label-open { display: none; }
      .section-drawer[open] .label-closed { display: none; }
      .section-drawer[open] .label-open { display: inline; }

      .section-chevron {
        width: 1.85rem;
        height: 1.85rem;
        border-radius: 999px;
        display: inline-grid;
        place-items: center;
        color: var(--ink);
        background: var(--soft-2);
        border: 1px solid var(--soft);
        transition: transform 180ms ease, background 180ms ease;
      }

      .section-drawer[open] .section-chevron {
        transform: rotate(90deg);
        background: #ffffff;
      }

      .section-body {
        padding: 1.25rem 0 0;
      }

      .section-intro-panel {
        margin: 0 0 1.5rem;
        padding: 1.2rem 1.35rem;
        border: 1px solid var(--soft);
        border-radius: 18px;
        background: #ffffff;
        color: #475569;
        line-height: 1.7;
        white-space: pre-line;
      }

      .section-intro-panel p { margin: 0; }

      .empty-section-note {
        margin: 0;
        padding: 1rem 1.2rem;
        border: 1px dashed var(--soft);
        border-radius: 16px;
        color: var(--muted);
        background: var(--soft-2);
        font-weight: 650;
      }

      .places-container { width: 100%; }

      .place-card {
        position: relative;
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      .place-image-wrap {
        width: 100%;
        overflow: hidden;
        background: var(--soft-2);
      }

      .place-image {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        object-position: center;
        display: block;
      }

      .place-content { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
      .place-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem; }

      .time-badge,
      .category-badge,
      .area-badge,
      .payment-badge,
      .booking-badge,
      .cancellation-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
        line-height: 1;
      }

      .time-badge { background: var(--blue-bg); color: var(--blue-ink); }
      .category-badge { background: var(--amber-bg); color: var(--amber-ink); }
      .category-badge.transport,
      .category-badge.transit { background: var(--purple-bg); color: var(--purple-ink); }
      .area-badge { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.paid { background: var(--green-bg); color: var(--green-ink); }
      .payment-badge.unpaid { background: var(--rose-bg); color: var(--rose-ink); }
      .booking-badge.to-book { background: var(--amber-bg); color: var(--amber-ink); border: 1px dashed var(--amber-ink); }
      .booking-badge.booked { background: var(--blue-bg); color: var(--blue-ink); }
      .cancellation-badge.free { background: var(--green-bg); color: var(--green-ink); }
      .cancellation-badge.non-refundable { background: var(--slate-bg); color: var(--slate-ink); }

      .place-card h3 { margin: 0.5rem 0; font-size: 1.35rem; line-height: 1.2; letter-spacing: -0.02em; }
      .short-description { margin: 0.5rem 0; font-weight: 600; color: var(--ink); line-height: 1.5; }
      .place-info { margin: 1rem 0 0; color: #475569; line-height: 1.65; white-space: pre-line; }

      .logistics-block { background: var(--soft-2); padding: 1rem; border-radius: 12px; margin: 1rem 0; font-size: 0.9rem; border: 1px solid var(--soft); }
      .logistics-title { font-weight: 800; text-transform: uppercase; font-size: 0.75rem; color: var(--muted); margin-bottom: 0.5rem; letter-spacing: 0.05em; }
      .logistics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem; }
      .logistics-grid p { margin: 0.35rem 0; }

      .detail-list { margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--soft); font-size: 0.95rem; }
      .detail-list p { margin: 0.5rem 0; color: #475569; }

      .place-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
      .place-links a,
      .copy-coords-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: var(--ink);
        color: #ffffff;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        border: none;
        cursor: pointer;
      }

      .place-links a:hover,
      .copy-coords-btn:hover { background: #334155; }
      .copy-coords-btn { background: transparent; color: var(--ink); border: 1px solid var(--soft); }
      .copy-coords-btn:hover { background: var(--soft-2); }

      .layout-grid .places-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .layout-grid .place-card {
        border-radius: 22px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid var(--soft);
      }

      .layout-grid .place-image { height: auto; }

      .layout-timeline .places-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-left: 3px solid #cbd5e1;
        padding-left: 2rem;
        margin-left: 0.5rem;
      }

      .layout-timeline .place-card {
        display: block;
        box-shadow: none;
      }

      .layout-timeline .place-card::before {
        content: "";
        position: absolute;
        left: -2.65rem;
        top: 1.45rem;
        width: 1rem;
        height: 1rem;
        background: #3b82f6;
        border-radius: 50%;
        border: 4px solid var(--page-bg);
        z-index: 2;
      }

      .layout-timeline .category-transport,
      .layout-timeline .category-transit {
        border-left: 4px solid var(--blue-ink);
      }

      .layout-timeline .category-transport .place-image-wrap,
      .layout-timeline .category-transit .place-image-wrap {
        display: none;
      }

      .layout-timeline .category-transport .place-content,
      .layout-timeline .category-transit .place-content {
        padding: 1.25rem;
      }

      .layout-timeline .place-card h3 { margin-top: 0; }

      @media (max-width: 720px) {
        body { padding: 1rem 0.75rem 3rem; }
        .section-container { padding: 1rem; }
        .section-drawer-summary { padding: 0.8rem 1rem; }
        .section-body { padding: 0 1rem 1rem; }
        .section-banner-image { aspect-ratio: 16 / 7; border-radius: 16px; }
        .layout-timeline .places-container { margin-left: 0.25rem; padding-left: 1.25rem; }
        .layout-timeline .place-card::before { left: -1.9rem; }
        .layout-grid .places-container { grid-template-columns: 1fr; }
        .weather-days { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .weather-icon-frame { width: 68px; height: 68px; }
        .weather-icon { font-size: 2.35rem; }
      }
    </style>
  </head>
  <body>
    <nav class="back-nav">
      <a href="/" class="back-button">← Back to All Itineraries</a>
    </nav>

    <main>
      <article class="trip-wrapper">
        <header class="trip-header">
          {trip.heroImageUrl && (
            <img src={trip.heroImageUrl} alt={`${trip.title} hero image`} class="trip-hero-image" />
          )}
          <div class="trip-header-content">
            <h1>{trip.title}</h1>
            {trip.startDate && (
              <p class="trip-date"><strong>Departure:</strong> {formatDate(trip.startDate)}</p>
            )}
            {trip.heroIntro && <p class="hero-intro">{trip.heroIntro}</p>}

            {hasWeatherForecast(trip.heroWeatherForecast) && (
              <section
                class="weather-forecast-card hero-weather"
                data-weather-forecast
                data-weather-location={trip.heroWeatherForecast.locationName || ""}
                data-weather-lat={trip.heroWeatherForecast.coordinates?.lat ?? ""}
                data-weather-lng={trip.heroWeatherForecast.coordinates?.lng ?? ""}
              >
                <div class="weather-forecast-header">
                  <div class="weather-forecast-title">
                    <span class="weather-eyebrow">Weather outlook</span>
                    <span class="weather-location">{trip.heroWeatherForecast.locationName || "Trip weather"}</span>
                  </div>
                  <span class="weather-source-note">7-day live forecast</span>
                </div>
                <p class="weather-status" aria-live="polite">Preparing the outlook…</p>
                <div class="weather-days" aria-live="polite"></div>
              </section>
            )}
          </div>
        </header>

        {trip.sections && trip.sections.map((section: any, index: number) => {
          const placeCount = section.places?.length || 0;
          const shouldOpen = section.initialLoadState === 'open';

          return (
            <section class={`section-container layout-${section.layoutStyle || "timeline"}`}>
              <header class="section-static-header">
                <h2>{section.sectionTitle}</h2>
                <span class={`section-kicker ${placeCount === 0 ? "is-empty" : ""}`}>{getSectionSummary(section)}</span>
              </header>

              {section.sectionImageUrl && (
                <img
                  src={section.sectionImageUrl}
                  alt={`${section.sectionTitle} location view`}
                  class="section-banner-image"
                  loading="lazy"
                />
              )}

              {hasWeatherForecast(section.weatherForecast) && (
                <section
                  class="weather-forecast-card section-weather"
                  data-weather-forecast
                  data-weather-location={section.weatherForecast.locationName || ""}
                  data-weather-lat={section.weatherForecast.coordinates?.lat ?? ""}
                  data-weather-lng={section.weatherForecast.coordinates?.lng ?? ""}
                >
                  <div class="weather-forecast-header">
                    <div class="weather-forecast-title">
                      <span class="weather-eyebrow">Local outlook</span>
                      <span class="weather-location">{section.weatherForecast.locationName || `${section.sectionTitle} weather`}</span>
                    </div>
                    <span class="weather-source-note">7-day live forecast</span>
                  </div>
                  <p class="weather-status" aria-live="polite">Preparing the outlook…</p>
                  <div class="weather-days" aria-live="polite"></div>
                </section>
              )}

              <details class="section-drawer" open={shouldOpen}>
                <summary class="section-drawer-summary">
                  <span class="section-drawer-label">
                    <span class="label-closed">View plans</span>
                    <span class="label-open">Hide plans</span>
                  </span>
                  <span class="section-chevron" aria-hidden="true">›</span>
                </summary>

                <div class="section-body">

                {section.sectionIntro && (
                  <div class="section-intro-panel">
                    <p>{section.sectionIntro}</p>
                  </div>
                )}

                {placeCount > 0 ? (
                  <div class="places-container">
                    {section.places.map((place: any) => (
                      <article class={`place-card category-${getCategoryClass(place.category)}`}>
                        {place.photoUrl && !isTransitCategory(place.category) && (
                          <div class="place-image-wrap">
                            <img
                              src={place.photoUrl}
                              alt={place.placeName || ""}
                              class="place-image"
                              loading="lazy"
                            />
                          </div>
                        )}

                        <div class="place-content">
                          <div class="place-meta">
                            {place.time && (
                              <span class="time-badge">
                                {place.time}{place.endTime ? ` - ${place.endTime}` : ""}
                              </span>
                            )}
                            {place.category && (
                              <span class={`category-badge ${getCategoryClass(place.category)}`}>
                                {place.category}
                              </span>
                            )}
                            {place.area && <span class="area-badge">{place.area}</span>}

                            {place.paymentStatus === "paid" && <span class="payment-badge paid">✓ Paid</span>}
                            {place.paymentStatus === "unpaid" && <span class="payment-badge unpaid">⚠️ Unpaid</span>}

                            {place.bookingLogistics?.bookingStatus === "to-book" && (
                              <span class="booking-badge to-book">
                                ⏳ To Book {place.bookingLogistics.bookOnDate ? `(On ${formatInlineDate(place.bookingLogistics.bookOnDate)})` : ""}
                              </span>
                            )}
                            {place.bookingLogistics?.bookingStatus === "booked" && (
                              <span class="booking-badge booked">✓ Booked</span>
                            )}

                            {place.costStructure?.cancellationPolicy === "free" && (
                              <span class="cancellation-badge free">
                                🟢 Free Cancellation {place.costStructure.cancellationDeadline ? `until ${formatInlineDate(place.costStructure.cancellationDeadline)}` : ""}
                              </span>
                            )}
                            {place.costStructure?.cancellationPolicy === "non-refundable" && (
                              <span class="cancellation-badge non-refundable">❌ Non-refundable</span>
                            )}
                          </div>

                          <h3>{place.placeName}</h3>
                          {place.shortDescription && <p class="short-description">{place.shortDescription}</p>}

                          {isTransitCategory(place.category) && place.transitDetails && (
                            <div class="logistics-block">
                              <div class="logistics-title">Journey Details</div>
                              <div class="logistics-grid">
                                {place.transitDetails.origin && <p><strong>From:</strong> {place.transitDetails.origin}</p>}
                                {place.transitDetails.destination && <p><strong>To:</strong> {place.transitDetails.destination}</p>}
                                {place.transitDetails.carrier && <p><strong>Carrier:</strong> {place.transitDetails.carrier}</p>}
                                {place.transitDetails.reference && <p><strong>Ref:</strong> {place.transitDetails.reference}</p>}
                                {place.transitDetails.seatAssignment && <p><strong>Seat/Class:</strong> {place.transitDetails.seatAssignment}</p>}
                              </div>

                              {place.transitDetails.airportParkingLogistics && place.transitDetails.airportParkingLogistics.status !== "not-needed" && (
                                <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--soft);">
                                  <p>
                                    <strong>Airport Parking:</strong>
                                    {place.transitDetails.airportParkingLogistics.status === "booked" ? " ✅ Booked" : " ⏳ Required / To Book"}
                                    {place.transitDetails.airportParkingLogistics.locationInfo ? ` — ${place.transitDetails.airportParkingLogistics.locationInfo}` : ""}
                                  </p>
                                </div>
                              )}

                              {place.transitDetails.bookingDetailsText && (
                                <div style="margin-top: 0.5rem; font-style: italic; color: var(--muted); font-size: 0.85rem;">
                                  <strong>Booking notes:</strong> {place.transitDetails.bookingDetailsText}
                                </div>
                              )}
                            </div>
                          )}

                          {place.category === "Hotel" && place.hotelDetails && (
                            <div class="logistics-block">
                              <div class="logistics-title">Stay Details</div>
                              <div class="logistics-grid">
                                {place.hotelDetails.bookingRef && <p><strong>Booking Ref:</strong> {place.hotelDetails.bookingRef}</p>}
                                {place.hotelDetails.roomType && <p><strong>Room:</strong> {place.hotelDetails.roomType}</p>}
                                {place.hotelDetails.checkInNotes && <p><strong>Notes:</strong> {place.hotelDetails.checkInNotes}</p>}
                              </div>
                            </div>
                          )}

                          {place.info && <p class="place-info">{place.info}</p>}

                          {(place.costStructure || place.practicalInfo || place.travelNote || place.bookingLogistics) && (
                            <div class="detail-list">
                              {formatCost(place.costStructure) && (
                                <p><strong>Price:</strong> {formatCost(place.costStructure)}</p>
                              )}
                              {place.practicalInfo && <p><strong>Good to know:</strong> {place.practicalInfo}</p>}
                              {place.travelNote && <p><strong>Getting there:</strong> {place.travelNote}</p>}

                              {place.bookingLogistics?.bookingStatus === "to-book" && (
                                <p><strong>Booking:</strong> Required {place.bookingLogistics.bookOnDate ? `- Window opens ${formatInlineDate(place.bookingLogistics.bookOnDate)}` : ""}</p>
                              )}
                              {place.bookingLogistics?.bookingStatus === "booked" && (
                                <p><strong>Booking:</strong> Confirmed</p>
                              )}
                            </div>
                          )}

                          <div class="place-links">
                            {place.bookingUrl && <a href={place.bookingUrl} target="_blank" rel="noreferrer">Book</a>}
                            {place.websiteUrl && <a href={place.websiteUrl} target="_blank" rel="noreferrer">Website</a>}

                            {place.coordinates && (
                              <button
                                class="copy-coords-btn"
                                data-lat={place.coordinates.lat}
                                data-lng={place.coordinates.lng}
                                onclick={`
                                  navigator.clipboard.writeText('${place.coordinates.lat},${place.coordinates.lng}');
                                  this.innerText = 'Copied!';
                                  setTimeout(() => this.innerText = '📋 Copy Coords', 1500);
                                `}
                              >
                                📋 Copy Coords
                              </button>
                            )}
                          </div>
                        </div>
                      </article>
                    ))}
                  </div>
                ) : (
                  <p class="empty-section-note">Plans still taking shape for this section.</p>
                )}
                </div>
              </details>
            </section>
          );
        })}
      </article>
    </main>

    <script is:inline>
      const WEATHER_CODE_LOOKUP = {
        0: ["☀️", "Clear"],
        1: ["🌤️", "Mainly clear"],
        2: ["⛅", "Partly cloudy"],
        3: ["☁️", "Cloudy"],
        45: ["🌫️", "Fog"],
        48: ["🌫️", "Rime fog"],
        51: ["🌦️", "Light drizzle"],
        53: ["🌦️", "Drizzle"],
        55: ["🌧️", "Heavy drizzle"],
        61: ["🌦️", "Light rain"],
        63: ["🌧️", "Rain"],
        65: ["🌧️", "Heavy rain"],
        71: ["🌨️", "Light snow"],
        73: ["🌨️", "Snow"],
        75: ["❄️", "Heavy snow"],
        80: ["🌦️", "Rain showers"],
        81: ["🌧️", "Showers"],
        82: ["⛈️", "Heavy showers"],
        95: ["⛈️", "Thunderstorm"],
        96: ["⛈️", "Thunderstorm"],
        99: ["⛈️", "Thunderstorm"],
      };

      const weatherPanels = document.querySelectorAll("[data-weather-forecast]");

      const getWeatherLabel = (code) => WEATHER_CODE_LOOKUP[code] || ["🌡️", "Forecast"];

      const getCoordinates = async (panel) => {
        const lat = Number(panel.dataset.weatherLat);
        const lng = Number(panel.dataset.weatherLng);

        if (Number.isFinite(lat) && Number.isFinite(lng)) {
          return { lat, lng };
        }

        const location = panel.dataset.weatherLocation?.trim();
        if (!location) throw new Error("Missing forecast location");

        const geocodeUrl = new URL("https://geocoding-api.open-meteo.com/v1/search");
        geocodeUrl.searchParams.set("name", location);
        geocodeUrl.searchParams.set("count", "1");
        geocodeUrl.searchParams.set("language", "en");
        geocodeUrl.searchParams.set("format", "json");

        const response = await fetch(geocodeUrl);
        if (!response.ok) throw new Error("Could not resolve forecast location");

        const data = await response.json();
        const result = data.results?.[0];
        if (!result) throw new Error("Forecast location not found");

        return { lat: result.latitude, lng: result.longitude };
      };

      const renderForecast = (panel, daily) => {
        const daysContainer = panel.querySelector(".weather-days");
        const status = panel.querySelector(".weather-status");
        if (!daysContainer || !status) return;

        daysContainer.innerHTML = "";
        status.hidden = true;

        daily.time.forEach((dateString, index) => {
          const [icon, label] = getWeatherLabel(daily.weather_code[index]);
          const date = new Date(`${dateString}T12:00:00`);
          const day = document.createElement("article");
          day.className = "weather-day";
          day.title = label;

          const name = document.createElement("span");
          name.className = "weather-day-name";
          name.textContent = date.toLocaleDateString("en-GB", { weekday: "short" });

          const iconFrame = document.createElement("span");
          iconFrame.className = "weather-icon-frame";

          const iconEl = document.createElement("span");
          iconEl.className = "weather-icon";
          iconEl.setAttribute("aria-label", label);
          iconEl.textContent = icon;
          iconFrame.appendChild(iconEl);

          const condition = document.createElement("span");
          condition.className = "weather-condition";
          condition.textContent = label;

          const temp = document.createElement("span");
          temp.className = "weather-temp";
          temp.textContent = `${Math.round(daily.temperature_2m_max[index])}° high · ${Math.round(daily.temperature_2m_min[index])}° low`;

          const rain = document.createElement("span");
          rain.className = "weather-rain";
          const rainChance = daily.precipitation_probability_max?.[index];
          rain.textContent = Number.isFinite(rainChance) ? `☔ ${rainChance}%` : "☔ n/a";

          day.append(name, iconFrame, condition, temp, rain);
          daysContainer.appendChild(day);
        });
      };

      const loadForecast = async (panel) => {
        const status = panel.querySelector(".weather-status");

        try {
          const { lat, lng } = await getCoordinates(panel);
          const forecastUrl = new URL("https://api.open-meteo.com/v1/forecast");
          forecastUrl.searchParams.set("latitude", lat);
          forecastUrl.searchParams.set("longitude", lng);
          forecastUrl.searchParams.set("daily", "weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max");
          forecastUrl.searchParams.set("forecast_days", "7");
          forecastUrl.searchParams.set("timezone", "auto");

          const response = await fetch(forecastUrl);
          if (!response.ok) throw new Error("Forecast request failed");

          const data = await response.json();
          renderForecast(panel, data.daily);
        } catch (error) {
          if (status) status.textContent = "Forecast unavailable right now.";
          console.warn(error);
        }
      };

      weatherPanels.forEach(loadForecast);
    </script>
  </body>
</html>
