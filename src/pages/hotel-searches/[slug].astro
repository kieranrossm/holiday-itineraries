---
import { sanityClient } from "sanity:client";
import {
  formatAmenity,
  formatCheckedDate,
  formatDateRange,
  formatMoney,
  formatPerNight,
  formatReview,
  formatWalk,
  getBudgetDeltaLabel,
  getBudgetStatusClass,
  getBudgetStatusLabel,
  getHotelMapPoints,
  getHotelPrimaryUrl,
  getHotelSourceSummary,
  getPropertyTypeLabel,
  getSortedHotels,
  hasNumber,
  type HotelCandidate,
  type HotelSearch,
} from "../../lib/hotelSearch";
import { getCoordinateMapUrl, getStaticMapUrl } from "../../lib/maps";
import { hotelSearchDetailQuery, visibleHotelSearchSlugsQuery } from "../../lib/tripQueries";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(visibleHotelSearchSlugsQuery);
  return data.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const hotelSearch = await sanityClient.fetch<HotelSearch>(hotelSearchDetailQuery, { slug });

if (!hotelSearch) {
  return Astro.redirect("/404");
}

const hotels = getSortedHotels(hotelSearch.hotels || []);
const searchContext = hotelSearch.search || {};
const budget = searchContext.budget || {};
const targetPerNight = budget.targetPerNight;
const flexPerNight = budget.flexPerNight;
const currency = budget.currency || hotels.find((hotel) => hotel.price?.currency)?.price?.currency || "GBP";
const referenceLabel = searchContext.referencePoint?.label || searchContext.location?.label || "reference point";
const locationLabel = [searchContext.location?.label, searchContext.location?.country].filter(Boolean).join(", ") || "Location not specified";
const dateLabel = formatDateRange(searchContext.dateRange) || "Dates not specified";
const guests = searchContext.guests || {};
const guestLabel = [
  hasNumber(guests.adults) ? `${guests.adults} ${guests.adults === 1 ? "adult" : "adults"}` : "",
  hasNumber(guests.children) && guests.children > 0 ? `${guests.children} ${guests.children === 1 ? "child" : "children"}` : "",
  hasNumber(guests.rooms) ? `${guests.rooms} ${guests.rooms === 1 ? "room" : "rooms"}` : "",
].filter(Boolean).join(" / ") || "Guests not specified";
const budgetLabel = [
  hasNumber(targetPerNight) ? `${formatMoney(targetPerNight, currency)} target` : "",
  hasNumber(flexPerNight) ? `${formatMoney(flexPerNight, currency)} flex` : "",
].filter(Boolean).join(" / ") || "Budget not specified";
const checkedDate = formatCheckedDate(hotelSearch.metadata?.searchedAt) || formatCheckedDate(hotels.find((hotel) => hotel.price?.checkedAt)?.price?.checkedAt);
const mapPoints = getHotelMapPoints(hotelSearch);
const googleMapsApiKey = process.env.GOOGLE_MAPS_API_KEY || import.meta.env.PUBLIC_GOOGLE_MAPS_STATIC_API_KEY || "";
const staticMapUrl = getStaticMapUrl(mapPoints, googleMapsApiKey);

const countByBudgetStatus = (status: string) => hotels.filter((hotel) => hotel.price?.budgetStatus === status).length;
const hasText = (value: unknown) => typeof value === "string" && value.trim().length > 0;

const getBudgetRank = (hotel: HotelCandidate) => {
  const status = hotel.price?.budgetStatus;
  if (status === "within") return 0;
  if (status === "flex") return 1;
  if (status === "over") return 2;
  return 3;
};

const getSortValue = (value: unknown, fallback: number) => hasNumber(value) ? value : fallback;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{hotelSearch.title || "Hotel Search"} | Holiday Itineraries</title>

    <style>
      :root {
        --bg-main: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --text-soft: #475569;
        --brand-blue: #2563eb;
        --brand-green: #10b981;
        --brand-yellow: #f59e0b;
        --brand-red: #ef4444;
        --border-color: #e2e8f0;
        --panel-soft: #f1f5f9;
        --shadow-soft: 0 10px 24px rgba(15, 23, 42, 0.06);
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg-main);
        color: var(--text-main);
        font-family: var(--font-stack);
      }

      a {
        color: inherit;
      }

      .hotel-dashboard-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(0, 0.58fr) minmax(360px, 0.42fr);
      }

      .sidebar {
        min-width: 0;
        height: 100vh;
        overflow-y: auto;
        padding: clamp(1rem, 3vw, 2rem);
        border-right: 1px solid var(--border-color);
      }

      .map-container {
        position: sticky;
        top: 0;
        min-width: 0;
        height: 100vh;
        background: #e3eaef;
      }

      .back-nav {
        margin-bottom: 1.25rem;
      }

      .back-nav a {
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 800;
        text-decoration: none;
      }

      .back-nav a:hover {
        color: var(--text-main);
        text-decoration: underline;
      }

      .header {
        margin-bottom: 1.25rem;
      }

      .eyebrow {
        margin: 0 0 0.45rem;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        color: var(--text-main);
        font-size: clamp(1.75rem, 4vw, 2.55rem);
        line-height: 1;
        letter-spacing: -0.045em;
      }

      .search-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.9rem;
      }

      .meta-chip,
      .pill {
        display: inline-flex;
        align-items: center;
        min-height: 1.75rem;
        padding: 0.35rem 0.58rem;
        border-radius: 999px;
        background: var(--panel-soft);
        color: #334155;
        font-size: 0.76rem;
        font-weight: 850;
        line-height: 1.15;
        white-space: nowrap;
      }

      .summary-box {
        margin-bottom: 1.1rem;
        padding: 1rem;
        border-left: 4px solid var(--text-main);
        border-radius: 8px;
        background: var(--panel-soft);
        color: var(--text-soft);
        font-size: 0.93rem;
        line-height: 1.55;
      }

      .summary-box strong {
        color: var(--text-main);
      }

      .quick-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.65rem;
        margin-bottom: 1.25rem;
      }

      .quick-stat {
        min-width: 0;
        padding: 0.8rem;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: var(--bg-card);
      }

      .quick-stat strong {
        display: block;
        color: var(--text-main);
        font-size: 1.25rem;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .quick-stat span {
        display: block;
        margin-top: 0.32rem;
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 850;
        text-transform: uppercase;
      }

      .sort-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1rem;
      }

      .sort-button {
        min-height: 2rem;
        border: 1px solid var(--border-color);
        border-radius: 999px;
        background: #fff;
        color: #334155;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 850;
        cursor: pointer;
        padding: 0.35rem 0.65rem;
      }

      .sort-button[aria-pressed="true"] {
        border-color: #bfdbfe;
        background: #dbeafe;
        color: #1d4ed8;
      }

      .hotel-list {
        display: grid;
        gap: 1rem;
      }

      .hotel-card {
        display: grid;
        grid-template-columns: 128px minmax(0, 1fr);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--bg-card);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
        overflow: hidden;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .hotel-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-soft);
      }

      .hotel-visual {
        position: relative;
        min-height: 100%;
        background:
          linear-gradient(145deg, rgba(15, 23, 42, 0.9), rgba(37, 99, 235, 0.62)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 12px);
      }

      .hotel-card.budget-within .hotel-visual {
        background:
          linear-gradient(145deg, rgba(6, 78, 59, 0.95), rgba(16, 185, 129, 0.7)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 12px);
      }

      .hotel-card.budget-flex .hotel-visual {
        background:
          linear-gradient(145deg, rgba(120, 53, 15, 0.95), rgba(245, 158, 11, 0.72)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.18) 0 1px, transparent 1px 12px);
      }

      .hotel-card.budget-over .hotel-visual {
        background:
          linear-gradient(145deg, rgba(127, 29, 29, 0.95), rgba(239, 68, 68, 0.72)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.17) 0 1px, transparent 1px 12px);
      }

      .rank-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        display: inline-flex;
        align-items: center;
        min-height: 1.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        background: rgba(15, 23, 42, 0.84);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 850;
      }

      .visual-price {
        position: absolute;
        left: 0.75rem;
        right: 0.75rem;
        bottom: 0.75rem;
        color: #fff;
      }

      .visual-price strong {
        display: block;
        font-size: 1.35rem;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .visual-price span {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.72rem;
        font-weight: 800;
        opacity: 0.9;
      }

      .hotel-content {
        min-width: 0;
        padding: 1rem;
      }

      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
      }

      .hotel-title {
        margin: 0;
        color: var(--text-main);
        font-size: 1.08rem;
        font-weight: 760;
        line-height: 1.25;
        letter-spacing: -0.02em;
      }

      .score-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 7px;
        background: #f0fdf4;
        color: #166534;
        padding: 0.28rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .location-distance {
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: 0.84rem;
        font-weight: 700;
        line-height: 1.4;
      }

      .expert-note {
        margin-top: 0.75rem;
        padding: 0.78rem;
        border-radius: 8px;
        background: #f8fafc;
        color: var(--text-soft);
        font-size: 0.86rem;
        line-height: 1.45;
      }

      .expert-note ul {
        margin: 0;
        padding-left: 1.05rem;
      }

      .hotel-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.78rem;
      }

      .pill.within,
      .budget-status.status-within {
        background: #e6fbf1;
        color: #047857;
      }

      .pill.flex,
      .budget-status.status-flex {
        background: #fef3c7;
        color: #b45309;
      }

      .pill.over,
      .budget-status.status-over {
        background: #fee2e2;
        color: #b91c1c;
      }

      .pill.unknown,
      .budget-status.status-unknown {
        background: #f1f5f9;
        color: var(--text-muted);
      }

      .card-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 0.9rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-color);
      }

      .price-block .amount {
        color: var(--text-main);
        font-size: 1.2rem;
        font-weight: 850;
        letter-spacing: -0.03em;
      }

      .price-block .unit {
        color: var(--text-muted);
        font-size: 0.74rem;
        font-weight: 700;
      }

      .budget-status {
        display: inline-flex;
        margin-top: 0.28rem;
        padding: 0.18rem 0.42rem;
        border-radius: 6px;
        font-size: 0.68rem;
        font-weight: 850;
        text-transform: uppercase;
      }

      .links-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.45rem;
      }

      .action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.1rem;
        padding: 0.48rem 0.78rem;
        border-radius: 7px;
        background: var(--text-main);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 760;
        text-decoration: none;
        white-space: nowrap;
      }

      .secondary-link {
        background: #e0f2fe;
        color: #075985;
      }

      .map-canvas {
        position: relative;
        width: 100%;
        height: 100%;
        background:
          radial-gradient(#cbd5e1 1px, transparent 1px),
          linear-gradient(135deg, #dbeafe, #f8fafc 45%, #ccfbf1);
        background-size: 20px 20px, cover;
        overflow: hidden;
      }

      .map-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .map-canvas::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.16), rgba(15, 23, 42, 0.02) 42%, rgba(15, 23, 42, 0.18));
        pointer-events: none;
      }

      .map-overlay {
        position: absolute;
        left: 1rem;
        right: 1rem;
        top: 1rem;
        z-index: 1;
        display: grid;
        gap: 0.65rem;
      }

      .map-title-card,
      .map-legend {
        border: 1px solid rgba(255, 255, 255, 0.58);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.13);
        backdrop-filter: blur(10px);
      }

      .map-title-card {
        padding: 0.95rem;
      }

      .map-title-card h2 {
        margin: 0;
        color: var(--text-main);
        font-size: 1rem;
        line-height: 1.15;
      }

      .map-title-card p {
        margin: 0.35rem 0 0;
        color: var(--text-muted);
        font-size: 0.82rem;
        font-weight: 760;
        line-height: 1.35;
      }

      .map-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        padding: 0.75rem;
      }

      .map-empty {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 2rem;
        color: var(--text-muted);
        font-weight: 760;
        text-align: center;
      }

      .comparison-panel {
        margin-top: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--bg-card);
        overflow: hidden;
      }

      .comparison-panel summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        color: var(--text-main);
        font-size: 1rem;
        font-weight: 850;
        cursor: pointer;
        list-style: none;
      }

      .comparison-panel summary::-webkit-details-marker {
        display: none;
      }

      .comparison-panel summary::after {
        content: "+";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 999px;
        background: var(--panel-soft);
        color: var(--text-muted);
        font-weight: 900;
      }

      .comparison-panel[open] summary {
        border-bottom: 1px solid var(--border-color);
      }

      .comparison-panel[open] summary::after {
        content: "-";
      }

      .table-scroll {
        overflow-x: auto;
      }

      table {
        width: 100%;
        min-width: 980px;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 0.8rem;
        border-bottom: 1px solid var(--border-color);
        text-align: left;
        vertical-align: top;
      }

      th {
        background: #f8fafc;
        color: var(--text-muted);
        font-size: 0.74rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      td {
        color: #1f2937;
        font-size: 0.9rem;
      }

      .property-cell strong {
        display: block;
        color: var(--text-main);
        font-size: 1rem;
        line-height: 1.25;
      }

      .property-sub {
        display: block;
        margin-top: 0.25rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 750;
      }

      .numeric {
        font-weight: 850;
        white-space: nowrap;
      }

      .text-link {
        color: var(--brand-blue);
        font-weight: 800;
        text-decoration: none;
      }

      .text-link:hover {
        text-decoration: underline;
      }

      .empty-state {
        padding: 1.5rem;
        border: 1px dashed var(--border-color);
        border-radius: 14px;
        background: #fff;
        color: var(--text-muted);
        font-weight: 760;
      }

      @media (max-width: 1020px) {
        body {
          overflow: auto;
        }

        .hotel-dashboard-shell {
          min-height: auto;
          grid-template-columns: 1fr;
        }

        .sidebar {
          height: auto;
          overflow: visible;
          border-right: 0;
        }

        .map-container {
          position: relative;
          height: min(70vh, 560px);
          min-height: 380px;
          order: -1;
        }
      }

      @media (max-width: 720px) {
        .quick-stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .hotel-card {
          grid-template-columns: 1fr;
        }

        .hotel-visual {
          min-height: 120px;
        }

        .card-top,
        .card-bottom {
          flex-direction: column;
          align-items: flex-start;
        }

        .links-row {
          justify-content: flex-start;
        }
      }

      @media (max-width: 480px) {
        .sidebar {
          padding: 1rem;
        }

        .quick-stats {
          grid-template-columns: 1fr;
        }

        .search-meta {
          gap: 0.42rem;
        }

        .meta-chip,
        .pill {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <main class="hotel-dashboard-shell">
      <section class="sidebar" aria-label="Hotel shortlist">
        <nav class="back-nav">
          <a href="/">Back to holiday plans</a>
        </nav>

        <header class="header">
          <p class="eyebrow">Hotel Search</p>
          <h1>{hotelSearch.title || "Hotel Search"}</h1>
          <div class="search-meta">
            <span class="meta-chip">{locationLabel}</span>
            <span class="meta-chip">{dateLabel}</span>
            <span class="meta-chip">{guestLabel}</span>
            <span class="meta-chip">{budgetLabel}</span>
          </div>
        </header>

        {(hotelSearch.summary?.headline || checkedDate) && (
          <div class="summary-box">
            {hotelSearch.summary?.headline && <><strong>Curator's Take: </strong>{hotelSearch.summary.headline}</>}
            {checkedDate && <span> Prices and availability checked {checkedDate}; this is a comparison snapshot, not live booking data.</span>}
          </div>
        )}

        <section class="quick-stats" aria-label="Search result summary">
          <div class="quick-stat">
            <strong>{hotels.length}</strong>
            <span>{hotels.length === 1 ? "Option" : "Options"}</span>
          </div>
          <div class="quick-stat">
            <strong>{countByBudgetStatus("within")}</strong>
            <span>Target</span>
          </div>
          <div class="quick-stat">
            <strong>{countByBudgetStatus("flex")}</strong>
            <span>Flex</span>
          </div>
          <div class="quick-stat">
            <strong>{mapPoints.length}</strong>
            <span>Mapped</span>
          </div>
        </section>

        <div class="sort-toolbar" aria-label="Sort hotel options">
          <button class="sort-button" type="button" data-sort-key="rank" data-sort-direction="asc" aria-pressed="true">Recommended</button>
          <button class="sort-button" type="button" data-sort-key="rating" data-sort-direction="desc" aria-pressed="false">Rating</button>
          <button class="sort-button" type="button" data-sort-key="reviews" data-sort-direction="desc" aria-pressed="false">Reviews</button>
          <button class="sort-button" type="button" data-sort-key="price" data-sort-direction="asc" aria-pressed="false">Price</button>
          <button class="sort-button" type="button" data-sort-key="walk" data-sort-direction="asc" aria-pressed="false">Walk</button>
          <button class="sort-button" type="button" data-sort-key="budget" data-sort-direction="asc" aria-pressed="false">Budget</button>
        </div>

        {hotels.length > 0 ? (
          <section class="hotel-list" data-sort-list aria-label="Ranked hotel options">
            {hotels.map((hotel) => {
              const budgetClass = getBudgetStatusClass(hotel.price?.budgetStatus);
              const primaryUrl = getHotelPrimaryUrl(hotel);
              const mapUrl = getCoordinateMapUrl(hotel.coordinates);
              const notes = (hotel.notes || []).filter(hasText);

              return (
                <article
                  class={`hotel-card budget-${budgetClass}`}
                  data-sort-item
                  data-rank={getSortValue(hotel.rank, 9999)}
                  data-rating={getSortValue(hotel.review?.scorePercent, -1)}
                  data-reviews={getSortValue(hotel.review?.reviewCount, -1)}
                  data-price={getSortValue(hotel.price?.perNight, 999999)}
                  data-walk={getSortValue(hotel.distance?.walkingMinutes, 999999)}
                  data-budget={getBudgetRank(hotel)}
                >
                  <div class="hotel-visual" aria-hidden="true">
                    <span class="rank-badge">{hotel.rank ? `Rank ${hotel.rank}` : "Option"}</span>
                    <div class="visual-price">
                      <strong>{formatMoney(hotel.price?.perNight, hotel.price?.currency || currency) || "-"}</strong>
                      <span>per night</span>
                    </div>
                  </div>

                  <div class="hotel-content">
                    <div class="card-top">
                      <h2 class="hotel-title">{hotel.propertyName || "Unnamed property"}</h2>
                      <span class="score-badge">{formatReview(hotel)}</span>
                    </div>

                    <div class="location-distance">
                      {[getPropertyTypeLabel(hotel.propertyType), hotel.area, `${formatWalk(hotel)} walk from ${referenceLabel}`].filter(Boolean).join(" / ")}
                    </div>

                    {notes.length > 0 && (
                      <div class="expert-note">
                        <ul>
                          {notes.map((note) => <li>{note}</li>)}
                        </ul>
                      </div>
                    )}

                    <div class="hotel-tags">
                      <span class={`pill ${budgetClass}`}>{getBudgetStatusLabel(hotel.price?.budgetStatus)}</span>
                      {getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight) && (
                        <span class="pill">{getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight)}</span>
                      )}
                      <span class="pill">{getHotelSourceSummary(hotel)}</span>
                      <span class="pill">Air con: {formatAmenity(hotel.amenities?.airConditioning)}</span>
                      <span class="pill">Pool: {formatAmenity(hotel.amenities?.pool)}</span>
                    </div>

                    <div class="card-bottom">
                      <div class="price-block">
                        <span class="amount">{formatMoney(hotel.price?.perNight, hotel.price?.currency || currency) || "Price not confirmed"}</span>
                        {hasNumber(hotel.price?.perNight) && <span class="unit"> / night</span>}
                        <br />
                        <span class={`budget-status status-${budgetClass}`}>{getBudgetStatusLabel(hotel.price?.budgetStatus)}</span>
                      </div>
                      <div class="links-row">
                        {primaryUrl && <a class="action-link" href={primaryUrl} target="_blank" rel="noreferrer">Open Listing</a>}
                        {mapUrl && <a class="action-link secondary-link" href={mapUrl} target="_blank" rel="noreferrer">Open Map</a>}
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </section>
        ) : (
          <p class="empty-state">No hotel options have been added yet.</p>
        )}

        {hotels.length > 0 && (
          <details class="comparison-panel">
            <summary>Comparison Matrix</summary>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Property</th>
                    <th>Type</th>
                    <th>Sources</th>
                    <th>Review</th>
                    <th>Cost</th>
                    <th>Walk</th>
                    <th>Air con</th>
                    <th>Pool</th>
                    <th>Budget</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody data-sort-list>
                  {hotels.map((hotel) => {
                    const budgetClass = getBudgetStatusClass(hotel.price?.budgetStatus);
                    const primaryUrl = getHotelPrimaryUrl(hotel);
                    const mapUrl = getCoordinateMapUrl(hotel.coordinates);
                    const noteText = (hotel.notes || []).filter(hasText).join(" ");

                    return (
                      <tr
                        data-sort-item
                        data-rank={getSortValue(hotel.rank, 9999)}
                        data-rating={getSortValue(hotel.review?.scorePercent, -1)}
                        data-reviews={getSortValue(hotel.review?.reviewCount, -1)}
                        data-price={getSortValue(hotel.price?.perNight, 999999)}
                        data-walk={getSortValue(hotel.distance?.walkingMinutes, 999999)}
                        data-budget={getBudgetRank(hotel)}
                      >
                        <td class="numeric">{hotel.rank || ""}</td>
                        <td class="property-cell">
                          <strong>{hotel.propertyName || "Unnamed property"}</strong>
                          {hotel.area && <span class="property-sub">{hotel.area}</span>}
                          <div>
                            {primaryUrl && <a class="text-link" href={primaryUrl} target="_blank" rel="noreferrer">Listing</a>}
                            {primaryUrl && mapUrl && " / "}
                            {mapUrl && <a class="text-link" href={mapUrl} target="_blank" rel="noreferrer">Map</a>}
                          </div>
                        </td>
                        <td>{getPropertyTypeLabel(hotel.propertyType)}</td>
                        <td>{getHotelSourceSummary(hotel)}</td>
                        <td class="numeric">{formatReview(hotel)}</td>
                        <td class="numeric">{formatPerNight(hotel, currency)}</td>
                        <td class="numeric">{formatWalk(hotel)}</td>
                        <td>{formatAmenity(hotel.amenities?.airConditioning)}</td>
                        <td>{formatAmenity(hotel.amenities?.pool)}</td>
                        <td>
                          <span class={`pill ${budgetClass}`}>{getBudgetStatusLabel(hotel.price?.budgetStatus)}</span>
                          {getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight) && (
                            <span class="property-sub">{getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight)}</span>
                          )}
                        </td>
                        <td>{noteText || ""}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        )}
      </section>

      <aside class="map-container" aria-label="Hotel map">
        <div class="map-canvas">
          {staticMapUrl ? (
            <img src={staticMapUrl} alt={`${hotelSearch.title || "Hotel search"} map`} class="map-image" loading="eager" />
          ) : (
            <p class="map-empty">Map hidden because the search has no coordinates or the Google Maps API key is not available at build time.</p>
          )}

          <div class="map-overlay">
            <div class="map-title-card">
              <h2>{referenceLabel}</h2>
              <p>{mapPoints.length} mapped points across {locationLabel}</p>
            </div>
            <div class="map-legend" aria-label="Map legend">
              <span class="pill unknown">Black reference</span>
              <span class="pill within">Green within target</span>
              <span class="pill flex">Yellow within flex</span>
              <span class="pill over">Red over budget</span>
            </div>
          </div>
        </div>
      </aside>
    </main>

    <script is:inline>
      const sortLists = Array.from(document.querySelectorAll("[data-sort-list]"));
      const sortButtons = Array.from(document.querySelectorAll("[data-sort-key]"));

      function readNumber(item, key) {
        const value = Number(item.getAttribute(`data-${key}`));
        return Number.isFinite(value) ? value : 0;
      }

      function sortList(list, key, direction) {
        const multiplier = direction === "desc" ? -1 : 1;
        const items = Array.from(list.querySelectorAll("[data-sort-item]"));

        items
          .sort((first, second) => {
            const numericDelta = (readNumber(first, key) - readNumber(second, key)) * multiplier;
            if (numericDelta !== 0) return numericDelta;
            return String(first.textContent || "").localeCompare(String(second.textContent || ""));
          })
          .forEach((item) => list.appendChild(item));
      }

      sortButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const key = button.getAttribute("data-sort-key");
          const direction = button.getAttribute("data-sort-direction") || "asc";
          if (!key) return;

          sortButtons.forEach((item) => item.setAttribute("aria-pressed", "false"));
          button.setAttribute("aria-pressed", "true");
          sortLists.forEach((list) => sortList(list, key, direction));
        });
      });
    </script>
  </body>
</html>
