---
import { sanityClient } from "sanity:client";
import {
  formatAmenity,
  formatCheckedDate,
  formatDateRange,
  formatMoney,
  formatPerNight,
  formatPreviewPrice,
  formatPreviewReview,
  formatPreviewWalk,
  formatReview,
  formatWalk,
  getBudgetDeltaLabel,
  getBudgetStatusClass,
  getBudgetStatusLabel,
  getFlagLabel,
  getHotelImageUrl,
  getHotelMapPoints,
  getHotelPricingTable,
  getHotelSourceLinks,
  getPropertyTypeLabel,
  getSortedHotels,
  hasNumber,
  getWouldReturnLabel,
  type HotelCandidate,
  type HotelExclusion,
  type HotelSearch,
} from "../../lib/hotelSearch";
import { getCoordinateMapUrl } from "../../lib/maps";
import { findHotelPhoto } from "../../lib/googlePlaces";
import { hotelSearchDetailQuery, visibleHotelSearchSlugsQuery } from "../../lib/tripQueries";

export async function getStaticPaths() {
  const data = await sanityClient.fetch(visibleHotelSearchSlugsQuery);
  return data.map((item: any) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;

const hotelSearch = await sanityClient.fetch<HotelSearch>(hotelSearchDetailQuery, { slug });

if (!hotelSearch) {
  return Astro.redirect("/404");
}

const hotels = getSortedHotels(hotelSearch.hotels || []);
const searchContext = hotelSearch.search || {};
const budget = searchContext.budget || {};
const targetPerNight = budget.targetPerNight;
const flexPerNight = budget.flexPerNight;
const currency = budget.currency || hotels.find((hotel) => hotel.price?.currency)?.price?.currency || "GBP";
const referenceLabel = searchContext.referencePoint?.label || searchContext.location?.label || "reference point";
const locationLabel = [searchContext.location?.label, searchContext.location?.country].filter(Boolean).join(", ") || "Location not specified";
const dateLabel = formatDateRange(searchContext.dateRange) || "Dates not specified";
const guests = searchContext.guests || {};
const guestLabel = [
  hasNumber(guests.adults) ? `${guests.adults} ${guests.adults === 1 ? "adult" : "adults"}` : "",
  hasNumber(guests.children) && guests.children > 0 ? `${guests.children} ${guests.children === 1 ? "child" : "children"}` : "",
  hasNumber(guests.rooms) ? `${guests.rooms} ${guests.rooms === 1 ? "room" : "rooms"}` : "",
].filter(Boolean).join(" / ") || "Guests not specified";
const budgetLabel = [
  hasNumber(targetPerNight) ? `${formatMoney(targetPerNight, currency)} target` : "",
  hasNumber(flexPerNight) ? `${formatMoney(flexPerNight, currency)} flex` : "",
].filter(Boolean).join(" / ") || "Budget not specified";
const checkedDate = formatCheckedDate(hotelSearch.metadata?.searchedAt) || formatCheckedDate(hotels.find((hotel) => hotel.price?.checkedAt)?.price?.checkedAt);
const mapPoints = getHotelMapPoints(hotelSearch);

// Google Places photos are a live, build-time-only fallback for hotels no
// other source could image — Google's terms don't allow caching the photo
// reference, so this resolves fresh on every build rather than being stored
// in Sanity like every other image source. See src/lib/googlePlaces.ts.
const googleApiKey = import.meta.env.GOOGLE_MAPS_API_KEY || "";
const googlePhotos = new Map<HotelCandidate, { url: string; attributionName: string; attributionUri: string }>();
if (googleApiKey) {
  await Promise.all(
    hotels
      .filter((hotel) => !hotel.image?.url && hasNumber(hotel.coordinates?.lat) && hasNumber(hotel.coordinates?.lng))
      .map(async (hotel) => {
        const photo = await findHotelPhoto(
          hotel.propertyName || "",
          hotel.coordinates!.lat as number,
          hotel.coordinates!.lng as number,
          googleApiKey,
        );
        if (photo) googlePhotos.set(hotel, photo);
      }),
  );
}
const getHotelPhoto = (hotel: HotelCandidate) => {
  const url = getHotelImageUrl(hotel);
  if (url) return { url, attribution: null as { name: string; uri: string } | null };
  const google = googlePhotos.get(hotel);
  if (google) return { url: google.url, attribution: { name: google.attributionName, uri: google.attributionUri } };
  return { url: "", attribution: null };
};
const availabilityPreview = hotelSearch.availabilityPreview;
const previewDateLabel = formatDateRange(availabilityPreview?.dateRange);
const previewHotels = availabilityPreview?.hotels || [];

const countByBudgetStatus = (status: string) => hotels.filter((hotel) => hotel.price?.budgetStatus === status).length;
const hasText = (value: unknown) => typeof value === "string" && value.trim().length > 0;
const exclusions: HotelExclusion[] = (hotelSearch.exclusions || []).filter((item) => hasText(item?.propertyName) || hasText(item?.reason));
const bookingOutcome = hotelSearch.bookingOutcome;
const bookedHotel = hotels.find((hotel) => hotel.booked);
const stayReview = hotelSearch.stayReview;

const getBudgetRank = (hotel: HotelCandidate) => {
  const status = hotel.price?.budgetStatus;
  if (status === "within") return 0;
  if (status === "flex") return 1;
  if (status === "over") return 2;
  return 3;
};

const getSortValue = (value: unknown, fallback: number) => hasNumber(value) ? value : fallback;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{hotelSearch.title || "Hotel Search"} | Holiday Itineraries</title>

    <style>
      :root {
        --bg-main: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --text-soft: #475569;
        --brand-blue: #2563eb;
        --brand-green: #10b981;
        --brand-yellow: #f59e0b;
        --brand-red: #ef4444;
        --border-color: #e2e8f0;
        --panel-soft: #f1f5f9;
        --shadow-soft: 0 10px 24px rgba(15, 23, 42, 0.06);
        --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg-main);
        color: var(--text-main);
        font-family: var(--font-stack);
      }

      a {
        color: inherit;
      }

      .hotel-page-shell {
        min-height: 100vh;
        display: flex;
        justify-content: center;
      }

      .content-column {
        width: 100%;
        max-width: 900px;
        min-width: 0;
        padding: clamp(1rem, 3vw, 2rem);
      }

      .section-divider {
        height: 1px;
        margin: 1.25rem 0;
        background: linear-gradient(90deg, transparent, var(--border-color) 15%, var(--border-color) 85%, transparent);
      }

      .preview-panel {
        margin-bottom: 0.25rem;
        padding: 1.1rem;
        border: 1px solid #fde68a;
        border-radius: 12px;
        background: #fffbeb;
        scroll-margin-top: 1rem;
      }

      .preview-panel.map-highlight {
        box-shadow: 0 0 0 3px #b45309;
      }

      .preview-eyebrow {
        margin: 0 0 0.5rem;
        color: #b45309;
        font-size: 0.7rem;
        font-weight: 900;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .preview-item.map-highlight {
        box-shadow: 0 0 0 3px #b45309;
      }

      .preview-panel-header h2 {
        margin: 0;
        color: #92400e;
        font-size: 0.92rem;
        font-weight: 850;
      }

      .preview-panel-header p {
        margin: 0.25rem 0 0;
        color: #b45309;
        font-size: 0.78rem;
        font-weight: 750;
      }

      .preview-note {
        margin: 0.75rem 0 0;
        color: #78350f;
        font-size: 0.85rem;
        line-height: 1.5;
      }

      .preview-list {
        margin: 0.75rem 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.5rem;
      }

      .preview-item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.6rem 0.7rem;
        border-radius: 8px;
        background: #fff;
        border: 1px solid #fde68a;
      }

      .preview-name {
        color: var(--text-main);
        font-weight: 800;
        font-size: 0.88rem;
      }

      .preview-meta {
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 700;
      }

      .map-panel {
        margin-bottom: 1.25rem;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        overflow: hidden;
        background: var(--bg-card);
      }

      .map-panel-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--border-color);
      }

      .map-panel-header h2 {
        margin: 0;
        color: var(--text-main);
        font-size: 0.95rem;
        font-weight: 850;
      }

      .map-panel-header p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 750;
      }

      .map-leaflet {
        height: clamp(220px, 32vw, 320px);
        background: #e3eaef;
      }

      .map-panel-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--border-color);
      }

      .hotel-card.map-highlight {
        box-shadow: 0 0 0 3px var(--brand-blue);
      }

      .back-nav {
        margin-bottom: 1.25rem;
      }

      .back-nav a {
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 800;
        text-decoration: none;
      }

      .back-nav a:hover {
        color: var(--text-main);
        text-decoration: underline;
      }

      .header {
        margin-bottom: 1.25rem;
      }

      .eyebrow {
        margin: 0 0 0.45rem;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        color: var(--text-main);
        font-size: clamp(1.75rem, 4vw, 2.55rem);
        line-height: 1;
        letter-spacing: -0.045em;
      }

      .search-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 0.9rem;
      }

      .meta-chip,
      .pill {
        display: inline-flex;
        align-items: center;
        min-height: 1.75rem;
        padding: 0.35rem 0.58rem;
        border-radius: 999px;
        background: var(--panel-soft);
        color: #334155;
        font-size: 0.76rem;
        font-weight: 850;
        line-height: 1.15;
        white-space: nowrap;
      }

      .summary-box {
        margin-bottom: 1.1rem;
        padding: 1rem;
        border-left: 4px solid var(--text-main);
        border-radius: 8px;
        background: var(--panel-soft);
        color: var(--text-soft);
        font-size: 0.93rem;
        line-height: 1.55;
      }

      .summary-box strong {
        color: var(--text-main);
      }

      .quick-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.65rem;
        margin-bottom: 1.25rem;
      }

      .quick-stat {
        min-width: 0;
        padding: 0.8rem;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: var(--bg-card);
      }

      .quick-stat strong {
        display: block;
        color: var(--text-main);
        font-size: 1.25rem;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .quick-stat span {
        display: block;
        margin-top: 0.32rem;
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 850;
        text-transform: uppercase;
      }

      .sort-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 1rem;
      }

      .sort-button {
        min-height: 2rem;
        border: 1px solid var(--border-color);
        border-radius: 999px;
        background: #fff;
        color: #334155;
        font: inherit;
        font-size: 0.78rem;
        font-weight: 850;
        cursor: pointer;
        padding: 0.35rem 0.65rem;
      }

      .sort-button[aria-pressed="true"] {
        border-color: #bfdbfe;
        background: #dbeafe;
        color: #1d4ed8;
      }

      .hotel-list {
        display: grid;
        gap: 1rem;
      }

      .hotel-card {
        display: grid;
        grid-template-columns: minmax(220px, 34%) minmax(0, 1fr);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--bg-card);
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
        overflow: hidden;
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }

      .hotel-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-soft);
      }

      .hotel-visual {
        position: relative;
        min-height: 100%;
        overflow: hidden;
        background:
          linear-gradient(145deg, rgba(15, 23, 42, 0.9), rgba(37, 99, 235, 0.62)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 12px);
      }

      .hotel-photo {
        position: absolute;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .photo-attribution {
        position: absolute;
        z-index: 2;
        right: 0.5rem;
        top: 0.75rem;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        background: rgba(15, 23, 42, 0.65);
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.62rem;
        font-weight: 700;
        text-decoration: none;
        line-height: 1.2;
      }

      .photo-attribution:hover {
        color: #fff;
        text-decoration: underline;
      }

      .hotel-visual::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.12), rgba(15, 23, 42, 0.04) 45%, rgba(15, 23, 42, 0.58));
        pointer-events: none;
      }

      .rank-badge,
      .visual-price {
        z-index: 2;
      }

      .hotel-card.budget-within .hotel-visual {
        background:
          linear-gradient(145deg, rgba(6, 78, 59, 0.95), rgba(16, 185, 129, 0.7)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.16) 0 1px, transparent 1px 12px);
      }

      .hotel-card.budget-flex .hotel-visual {
        background:
          linear-gradient(145deg, rgba(120, 53, 15, 0.95), rgba(245, 158, 11, 0.72)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.18) 0 1px, transparent 1px 12px);
      }

      .hotel-card.budget-over .hotel-visual {
        background:
          linear-gradient(145deg, rgba(127, 29, 29, 0.95), rgba(239, 68, 68, 0.72)),
          repeating-linear-gradient(135deg, rgba(255,255,255,0.17) 0 1px, transparent 1px 12px);
      }

      .rank-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        display: inline-flex;
        align-items: center;
        min-height: 1.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        background: rgba(15, 23, 42, 0.84);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 850;
      }

      .booked-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        min-height: 1.75rem;
        padding: 0.25rem 0.55rem;
        border-radius: 6px;
        background: #b45309;
        color: #fff;
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.02em;
      }

      .hotel-card.is-booked {
        box-shadow: 0 0 0 2px #b45309;
      }

      .outcome-box {
        margin-bottom: 1.1rem;
        padding: 1rem;
        border-left: 4px solid #b45309;
        border-radius: 8px;
        background: #fffbeb;
        color: #78350f;
        font-size: 0.93rem;
        line-height: 1.55;
      }

      .outcome-box strong {
        color: #78350f;
      }

      .outcome-meta {
        margin-top: 0.4rem;
        color: #92400e;
        font-size: 0.78rem;
        font-weight: 750;
      }

      .stay-review {
        margin-top: 0.7rem;
        padding-top: 0.6rem;
        border-top: 1px dashed #fde68a;
      }

      .outcome-eyebrow {
        margin: 0 0 0.3rem;
        color: #b45309;
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .visual-price {
        position: absolute;
        left: 0.75rem;
        right: 0.75rem;
        bottom: 0.75rem;
        color: #fff;
      }

      .visual-price strong {
        display: block;
        font-size: 1.35rem;
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .visual-price span {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.72rem;
        font-weight: 800;
        opacity: 0.9;
      }

      .hotel-content {
        min-width: 0;
        padding: 1rem;
      }

      .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
      }

      .hotel-title {
        margin: 0;
        color: var(--text-main);
        font-size: 1.08rem;
        font-weight: 760;
        line-height: 1.25;
        letter-spacing: -0.02em;
      }

      .score-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 7px;
        background: #f0fdf4;
        color: #166534;
        padding: 0.28rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .location-distance {
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: 0.84rem;
        font-weight: 700;
        line-height: 1.4;
      }

      .address-line {
        margin-top: 0.15rem;
        color: var(--text-muted);
        font-size: 0.74rem;
        font-weight: 550;
        line-height: 1.35;
        opacity: 0.85;
      }

      .expert-note {
        margin-top: 0.75rem;
        padding: 0.78rem;
        border-radius: 8px;
        background: #f8fafc;
        color: var(--text-soft);
        font-size: 0.86rem;
        line-height: 1.45;
      }

      .expert-note ul {
        margin: 0;
        padding-left: 1.05rem;
      }

      .hotel-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.78rem;
      }

      .hotel-flags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.4rem;
      }

      .pill.flag-pill {
        background: #fef9c3;
        color: #854d0e;
      }

      .pill.within,
      .budget-status.status-within {
        background: #e6fbf1;
        color: #047857;
      }

      .pill.flex,
      .budget-status.status-flex {
        background: #fef3c7;
        color: #b45309;
      }

      .pill.over,
      .budget-status.status-over {
        background: #fee2e2;
        color: #b91c1c;
      }

      .pill.unknown,
      .budget-status.status-unknown {
        background: #f1f5f9;
        color: var(--text-muted);
      }

      .pill.preview {
        background: #f3e8ff;
        color: #7e22ce;
      }

      .card-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.9rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-color);
      }

      .sources-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
      }

      .sources-label {
        color: var(--text-muted);
        font-size: 0.72rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .source-link {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--brand-blue);
        font-size: 0.82rem;
        font-weight: 800;
        text-decoration: none;
      }

      .source-link:hover {
        text-decoration: underline;
      }

      .source-plain {
        color: var(--text-muted);
        font-size: 0.82rem;
        font-weight: 750;
      }

      .pricing-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0.6rem;
        font-size: 0.82rem;
      }

      .pricing-table caption {
        text-align: left;
        color: var(--text-muted);
        font-size: 0.68rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.3rem;
      }

      .pricing-table th {
        text-align: left;
        color: var(--text-muted);
        font-size: 0.68rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 0.2rem 0.5rem 0.2rem 0;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
      }

      .pricing-table td {
        padding: 0.28rem 0.5rem 0.28rem 0;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
      }

      .pricing-table tbody tr:last-child td {
        border-bottom: none;
      }

      .region-locked-note {
        display: block;
        margin-top: 0.25rem;
        font-size: 0.66rem;
        font-weight: 800;
        opacity: 0.9;
        color: #fde68a;
      }

      .links-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.45rem;
      }

      .action-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.1rem;
        padding: 0.48rem 0.78rem;
        border-radius: 7px;
        background: var(--text-main);
        color: #fff;
        font-size: 0.82rem;
        font-weight: 760;
        text-decoration: none;
        white-space: nowrap;
      }

      .secondary-link {
        background: #e0f2fe;
        color: #075985;
      }

      .map-empty {
        display: grid;
        place-items: center;
        height: 100%;
        padding: 2rem;
        color: var(--text-muted);
        font-weight: 760;
        text-align: center;
      }

      .comparison-panel {
        margin-top: 1rem;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--bg-card);
        overflow: hidden;
      }

      .comparison-panel summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        color: var(--text-main);
        font-size: 1rem;
        font-weight: 850;
        cursor: pointer;
        list-style: none;
      }

      .comparison-panel summary::-webkit-details-marker {
        display: none;
      }

      .comparison-panel summary::after {
        content: "+";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.6rem;
        height: 1.6rem;
        border-radius: 999px;
        background: var(--panel-soft);
        color: var(--text-muted);
        font-weight: 900;
      }

      .comparison-panel[open] summary {
        border-bottom: 1px solid var(--border-color);
      }

      .comparison-panel[open] summary::after {
        content: "-";
      }

      .table-scroll {
        overflow-x: auto;
      }

      table {
        width: 100%;
        min-width: 980px;
        border-collapse: collapse;
      }

      th,
      td {
        padding: 0.8rem;
        border-bottom: 1px solid var(--border-color);
        text-align: left;
        vertical-align: top;
      }

      th {
        background: #f8fafc;
        color: var(--text-muted);
        font-size: 0.74rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      td {
        color: #1f2937;
        font-size: 0.9rem;
      }

      .property-cell strong {
        display: block;
        color: var(--text-main);
        font-size: 1rem;
        line-height: 1.25;
      }

      .property-sub {
        display: block;
        margin-top: 0.25rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 750;
      }

      .numeric {
        font-weight: 850;
        white-space: nowrap;
      }

      .text-link {
        color: var(--brand-blue);
        font-weight: 800;
        text-decoration: none;
      }

      .text-link:hover {
        text-decoration: underline;
      }

      .exclusion-list {
        margin: 0;
        padding: 1rem;
        list-style: none;
        display: grid;
        gap: 0.55rem;
      }

      .exclusion-item {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.55rem 0.7rem;
        border-radius: 8px;
        background: var(--panel-soft);
      }

      .exclusion-name {
        color: var(--text-main);
        font-weight: 800;
        font-size: 0.86rem;
      }

      .exclusion-reason {
        color: var(--text-muted);
        font-size: 0.82rem;
        font-weight: 700;
      }

      .empty-state {
        padding: 1.5rem;
        border: 1px dashed var(--border-color);
        border-radius: 14px;
        background: #fff;
        color: var(--text-muted);
        font-weight: 760;
      }

      @media (max-width: 720px) {
        .quick-stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .hotel-card {
          grid-template-columns: 1fr;
        }

        .hotel-visual {
          min-height: 200px;
        }

        .card-top,
        .card-bottom {
          flex-direction: column;
          align-items: flex-start;
        }

        .links-row {
          justify-content: flex-start;
        }
      }

      @media (max-width: 480px) {
        .content-column {
          padding: 1rem;
        }

        .quick-stats {
          grid-template-columns: 1fr;
        }

        .search-meta {
          gap: 0.42rem;
        }

        .meta-chip,
        .pill {
          white-space: normal;
        }
      }
    </style>
  </head>
  <body>
    <main class="hotel-page-shell">
      <section class="content-column" aria-label="Hotel shortlist">
        <nav class="back-nav">
          <a href="/">Back to holiday plans</a>
        </nav>

        <header class="header">
          <p class="eyebrow">Hotel Search</p>
          <h1>{hotelSearch.title || "Hotel Search"}</h1>
          <div class="search-meta">
            <span class="meta-chip">{locationLabel}</span>
            <span class="meta-chip">{dateLabel}</span>
            <span class="meta-chip">{guestLabel}</span>
            <span class="meta-chip">{budgetLabel}</span>
          </div>
        </header>

        {bookingOutcome && (bookingOutcome.bookedPropertyName || bookingOutcome.whyNote) && (
          <div class="outcome-box">
            <strong>Booked: </strong>{bookingOutcome.bookedPropertyName || bookedHotel?.propertyName || "Unnamed property"}
            {bookingOutcome.matchedTopPick === false && <span> — diverged from the top-ranked recommendation.</span>}
            {bookingOutcome.whyNote && <div class="outcome-meta">{bookingOutcome.whyNote}</div>}
            {(bookingOutcome.bookedAt || hasNumber(bookingOutcome.actualPricePerNight)) && (
              <div class="outcome-meta">
                {[
                  bookingOutcome.bookedAt ? `Decided ${formatCheckedDate(bookingOutcome.bookedAt)}` : "",
                  hasNumber(bookingOutcome.actualPricePerNight) ? `Actual price: ${formatMoney(bookingOutcome.actualPricePerNight, currency)}/night` : "",
                ].filter(Boolean).join(" · ")}
              </div>
            )}
            {stayReview && (stayReview.whatWorked || stayReview.whatDidnt || stayReview.wouldReturn) && (
              <div class="stay-review">
                <p class="outcome-eyebrow">After the stay</p>
                {stayReview.matchedExpectations === false && <div class="outcome-meta">Didn't match the evidence that won the ranking.</div>}
                {stayReview.whatWorked && <div class="outcome-meta"><strong>Worked:</strong> {stayReview.whatWorked}</div>}
                {stayReview.whatDidnt && <div class="outcome-meta"><strong>Didn't:</strong> {stayReview.whatDidnt}</div>}
                {stayReview.wouldReturn && <div class="outcome-meta">{getWouldReturnLabel(stayReview.wouldReturn)}</div>}
              </div>
            )}
          </div>
        )}

        {(hotelSearch.summary?.headline || checkedDate) && (
          <div class="summary-box">
            {hotelSearch.summary?.headline && <><strong>Curator's Take: </strong>{hotelSearch.summary.headline}</>}
            {checkedDate && <span> Prices and availability checked {checkedDate}; this is a comparison snapshot, not live booking data.</span>}
          </div>
        )}

        {availabilityPreview && (availabilityPreview.note || previewHotels.length > 0) && (
          <>
            <div class="section-divider" aria-hidden="true"></div>
            <section id="availability-preview" class="preview-panel" aria-label="Availability preview">
              <p class="preview-eyebrow">Reference preview — not your travel dates</p>
              <div class="preview-panel-header">
                <h2>Early-search caveat: what's available closer to your dates</h2>
                {previewDateLabel && <p>Reference search for {previewDateLabel}</p>}
              </div>
              {availabilityPreview.note && <p class="preview-note">{availabilityPreview.note}</p>}
              {previewHotels.length > 0 && (
                <ul class="preview-list">
                  {previewHotels.map((hotel, index) => (
                    <li id={`preview-${index}`} class="preview-item">
                      <span class="preview-name">{hotel.propertyName || "Unnamed property"}</span>
                      <span class="preview-meta">
                        {[formatPreviewPrice(hotel, currency), formatPreviewReview(hotel), hotel.distance?.fromReferenceLabel || formatPreviewWalk(hotel)].filter(Boolean).join(" · ")}
                      </span>
                      {hotel.source?.url && <a class="text-link" href={hotel.source.url} target="_blank" rel="noreferrer">{hotel.source?.platform || "View listing"} &#8599;</a>}
                    </li>
                  ))}
                </ul>
              )}
            </section>
            <div class="section-divider" aria-hidden="true"></div>
          </>
        )}

        <section class="map-panel" aria-label="Hotel map">
          <div class="map-panel-header">
            <h2>{referenceLabel}</h2>
            <p>{mapPoints.length} mapped points across {locationLabel} — hover a point for details, click to jump to its card</p>
          </div>

          {mapPoints.length > 0 ? (
            <div id="hotel-map" class="map-leaflet"></div>
          ) : (
            <div class="map-leaflet"><p class="map-empty">Map hidden — this search has no hotel coordinates yet.</p></div>
          )}

          <div class="map-panel-legend" aria-label="Map legend">
            <span class="pill unknown">Black reference</span>
            <span class="pill within">Green within target</span>
            <span class="pill flex">Yellow within flex</span>
            <span class="pill over">Red over budget</span>
            {previewHotels.length > 0 && <span class="pill preview">Purple availability preview (not your dates)</span>}
          </div>
        </section>

        <script is:inline type="application/json" id="hotel-map-points" set:html={JSON.stringify(mapPoints).replace(/</g, "\\u003c")} />

        <section class="quick-stats" aria-label="Search result summary">
          <div class="quick-stat">
            <strong>{hotels.length}</strong>
            <span>{hotels.length === 1 ? "Option" : "Options"}</span>
          </div>
          <div class="quick-stat">
            <strong>{countByBudgetStatus("within")}</strong>
            <span>Target</span>
          </div>
          <div class="quick-stat">
            <strong>{countByBudgetStatus("flex")}</strong>
            <span>Flex</span>
          </div>
          <div class="quick-stat">
            <strong>{mapPoints.length}</strong>
            <span>Mapped</span>
          </div>
        </section>

        <div class="sort-toolbar" aria-label="Sort hotel options">
          <button class="sort-button" type="button" data-sort-key="rank" data-sort-direction="asc" aria-pressed="true">Recommended</button>
          <button class="sort-button" type="button" data-sort-key="rating" data-sort-direction="desc" aria-pressed="false">Rating</button>
          <button class="sort-button" type="button" data-sort-key="reviews" data-sort-direction="desc" aria-pressed="false">Reviews</button>
          <button class="sort-button" type="button" data-sort-key="price" data-sort-direction="asc" aria-pressed="false">Price</button>
          <button class="sort-button" type="button" data-sort-key="walk" data-sort-direction="asc" aria-pressed="false">Walk</button>
          <button class="sort-button" type="button" data-sort-key="budget" data-sort-direction="asc" aria-pressed="false">Budget</button>
        </div>

        {hotels.length > 0 ? (
          <section class="hotel-list" data-sort-list aria-label="Ranked hotel options">
            {hotels.map((hotel, index) => {
              const budgetClass = getBudgetStatusClass(hotel.price?.budgetStatus);
              const photo = getHotelPhoto(hotel);
              const imageUrl = photo.url;
              const sourceLinks = getHotelSourceLinks(hotel);
              const pricingTable = getHotelPricingTable(hotel);
              const unpricedSources = sourceLinks.filter((source) => source.url && !hasNumber(source.nightlyPrice));
              const mapUrl = getCoordinateMapUrl(hotel.coordinates);
              const notes = (hotel.notes || []).filter(hasText);

              return (
                <article
                  id={`hotel-${hotel.rank ?? index}`}
                  class={`hotel-card budget-${budgetClass}${hotel.booked ? " is-booked" : ""}`}
                  data-sort-item
                  data-rank={getSortValue(hotel.rank, 9999)}
                  data-rating={getSortValue(hotel.review?.scorePercent, -1)}
                  data-reviews={getSortValue(hotel.review?.reviewCount, -1)}
                  data-price={getSortValue(hotel.price?.perNight, 999999)}
                  data-walk={getSortValue(hotel.distance?.walkingMinutes, 999999)}
                  data-budget={getBudgetRank(hotel)}
                >
                  <div class="hotel-visual">
                    {imageUrl && (
                      <img
                        class="hotel-photo"
                        src={imageUrl}
                        alt={hotel.image?.alt || hotel.propertyName || "Hotel photo"}
                        loading="lazy"
                      />
                    )}
                    {photo.attribution && (
                      <a class="photo-attribution" href={photo.attribution.uri || undefined} target="_blank" rel="noreferrer">
                        Photo: {photo.attribution.name} / Google
                      </a>
                    )}
                    <span class="rank-badge">{hotel.rank ? `Rank ${hotel.rank}` : "Option"}</span>
                    {hotel.booked && <span class="booked-badge">✓ Booked</span>}
                    <div class="visual-price">
                      <strong>{formatMoney(hotel.price?.perNight, hotel.price?.currency || currency) || "-"}</strong>
                      <span>per night{hotel.price?.source ? ` · ${hotel.price.source}` : ""}</span>
                      {hotel.price?.sourceRegionLocked && (
                        <span class="region-locked-note">Region-locked price — may need a VPN/region switch to book</span>
                      )}
                    </div>
                  </div>

                  <div class="hotel-content">
                    <div class="card-top">
                      <h2 class="hotel-title">{hotel.propertyName || "Unnamed property"}</h2>
                      <span class="score-badge">{formatReview(hotel)}</span>
                    </div>

                    <div class="location-distance">
                      {[getPropertyTypeLabel(hotel.propertyType), hotel.area, `${formatWalk(hotel)} walk from ${referenceLabel}`].filter(Boolean).join(" / ")}
                    </div>
                    {hasText(hotel.address) && <div class="address-line">{hotel.address}</div>}

                    {notes.length > 0 && (
                      <div class="expert-note">
                        <ul>
                          {notes.map((note) => <li>{note}</li>)}
                        </ul>
                      </div>
                    )}

                    <div class="hotel-tags">
                      <span class={`pill ${budgetClass}`}>{getBudgetStatusLabel(hotel.price?.budgetStatus)}</span>
                      {getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight) && (
                        <span class="pill">{getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight)}</span>
                      )}
                      <span class="pill">Air con: {formatAmenity(hotel.amenities?.airConditioning)}</span>
                      <span class="pill">Pool: {formatAmenity(hotel.amenities?.pool)}</span>
                      <span class="pill">Fridge: {formatAmenity(hotel.amenities?.fridge)}</span>
                    </div>

                    {(hotel.flags?.length ?? 0) > 0 && (
                      <div class="hotel-flags">
                        {hotel.flags!.map((flag) => (
                          <span class="pill flag-pill">{getFlagLabel(flag)}</span>
                        ))}
                      </div>
                    )}

                    <div class="card-bottom">
                      {pricingTable.length > 0 ? (
                        <table class="pricing-table">
                          <caption>Price by source, cheapest first</caption>
                          <thead>
                            <tr><th>Source</th><th>Price</th><th>Note</th></tr>
                          </thead>
                          <tbody>
                            {pricingTable.map((source) => (
                              <tr>
                                <td>
                                  {source.url ? (
                                    <a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.platform} &#8599;</a>
                                  ) : source.platform}
                                </td>
                                <td>{formatMoney(source.nightlyPrice, source.priceCurrency || hotel.price?.currency || currency)}</td>
                                <td>{source.regionLocked ? "Region-locked — needs VPN/region switch" : ""}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      ) : <span class="source-plain">No priced source confirmed</span>}
                      {unpricedSources.length > 0 && (
                        <div class="sources-row">
                          <span class="sources-label">Also seen on</span>
                          {unpricedSources.map((source) => (
                            <a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.platform} &#8599;</a>
                          ))}
                        </div>
                      )}
                      <div class="links-row">
                        {mapUrl && <a class="action-link secondary-link" href={mapUrl} target="_blank" rel="noreferrer">Open Map</a>}
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </section>
        ) : (
          <p class="empty-state">No hotel options have been added yet.</p>
        )}

        {hotels.length > 0 && (
          <details class="comparison-panel">
            <summary>Comparison Matrix</summary>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Property</th>
                    <th>Type</th>
                    <th>Sources</th>
                    <th>Review</th>
                    <th>Cost</th>
                    <th>Walk</th>
                    <th>Air con</th>
                    <th>Pool</th>
                    <th>Fridge</th>
                    <th>Budget</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody data-sort-list>
                  {hotels.map((hotel) => {
                    const budgetClass = getBudgetStatusClass(hotel.price?.budgetStatus);
                    const sourceLinks = getHotelSourceLinks(hotel);
                    const mapUrl = getCoordinateMapUrl(hotel.coordinates);
                    const noteText = (hotel.notes || []).filter(hasText).join(" ");

                    return (
                      <tr
                        data-sort-item
                        data-rank={getSortValue(hotel.rank, 9999)}
                        data-rating={getSortValue(hotel.review?.scorePercent, -1)}
                        data-reviews={getSortValue(hotel.review?.reviewCount, -1)}
                        data-price={getSortValue(hotel.price?.perNight, 999999)}
                        data-walk={getSortValue(hotel.distance?.walkingMinutes, 999999)}
                        data-budget={getBudgetRank(hotel)}
                      >
                        <td class="numeric">{hotel.rank || ""}</td>
                        <td class="property-cell">
                          <strong>{hotel.booked && "✓ "}{hotel.propertyName || "Unnamed property"}</strong>
                          {hotel.area && <span class="property-sub">{hotel.area}</span>}
                          {mapUrl && <div><a class="text-link" href={mapUrl} target="_blank" rel="noreferrer">Map</a></div>}
                        </td>
                        <td>{getPropertyTypeLabel(hotel.propertyType)}</td>
                        <td>
                          {sourceLinks.length > 0 ? sourceLinks.map((source, index) => (
                            <>
                              {index > 0 && " / "}
                              {source.url ? (
                                <a class="text-link" href={source.url} target="_blank" rel="noreferrer">{source.platform}</a>
                              ) : (
                                <span>{source.platform}</span>
                              )}
                            </>
                          )) : "Source not confirmed"}
                        </td>
                        <td class="numeric">{formatReview(hotel)}</td>
                        <td class="numeric">{formatPerNight(hotel, currency)}</td>
                        <td class="numeric">{formatWalk(hotel)}</td>
                        <td>{formatAmenity(hotel.amenities?.airConditioning)}</td>
                        <td>{formatAmenity(hotel.amenities?.pool)}</td>
                        <td>{formatAmenity(hotel.amenities?.fridge)}</td>
                        <td>
                          <span class={`pill ${budgetClass}`}>{getBudgetStatusLabel(hotel.price?.budgetStatus)}</span>
                          {getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight) && (
                            <span class="property-sub">{getBudgetDeltaLabel(hotel, targetPerNight, flexPerNight)}</span>
                          )}
                        </td>
                        <td>{noteText || ""}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {exclusions.length > 0 && (
          <details class="comparison-panel">
            <summary>Excluded Properties ({exclusions.length})</summary>
            <ul class="exclusion-list">
              {exclusions.map((item) => (
                <li class="exclusion-item">
                  <span class="exclusion-name">{item.propertyName || "Unnamed property"}</span>
                  <span class="exclusion-reason">{item.reason || "Reason not recorded"}</span>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    </main>

    <script is:inline>
      const sortLists = Array.from(document.querySelectorAll("[data-sort-list]"));
      const sortButtons = Array.from(document.querySelectorAll("[data-sort-key]"));

      function readNumber(item, key) {
        const value = Number(item.getAttribute(`data-${key}`));
        return Number.isFinite(value) ? value : 0;
      }

      function sortList(list, key, direction) {
        const multiplier = direction === "desc" ? -1 : 1;
        const items = Array.from(list.querySelectorAll("[data-sort-item]"));

        items
          .sort((first, second) => {
            const numericDelta = (readNumber(first, key) - readNumber(second, key)) * multiplier;
            if (numericDelta !== 0) return numericDelta;
            return String(first.textContent || "").localeCompare(String(second.textContent || ""));
          })
          .forEach((item) => list.appendChild(item));
      }

      sortButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const key = button.getAttribute("data-sort-key");
          const direction = button.getAttribute("data-sort-direction") || "asc";
          if (!key) return;

          sortButtons.forEach((item) => item.setAttribute("aria-pressed", "false"));
          button.setAttribute("aria-pressed", "true");
          sortLists.forEach((list) => sortList(list, key, direction));
        });
      });
    </script>

    <script>
      import L from "leaflet";
      import "leaflet/dist/leaflet.css";
      import type { MapPoint } from "../../lib/maps";

      const container = document.getElementById("hotel-map");
      if (container) {
        const dataEl = document.getElementById("hotel-map-points");
        const points: MapPoint[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

        if (points.length > 0) {
          const map = L.map(container, { scrollWheelZoom: false });
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19,
          }).addTo(map);

          const bounds: [number, number][] = [];

          points.forEach((point) => {
            const marker = L.circleMarker([point.lat, point.lng], {
              radius: 9,
              weight: 2,
              color: "#ffffff",
              fillColor: point.markerColor || "blue",
              fillOpacity: 0.95,
            }).addTo(map);

            const tooltip = document.createElement("div");
            const nameEl = document.createElement("strong");
            nameEl.textContent = point.name || "Hotel";
            tooltip.appendChild(nameEl);
            const subText = point.priceLabel || point.type;
            if (subText) {
              const subEl = document.createElement("div");
              subEl.textContent = subText;
              tooltip.appendChild(subEl);
            }
            marker.bindTooltip(tooltip, { direction: "top", offset: [0, -6] });

            if (point.hotelRank != null) {
              marker.on("click", () => {
                const card = document.getElementById(`hotel-${point.hotelRank}`);
                if (!card) return;
                card.scrollIntoView({ behavior: "smooth", block: "center" });
                card.classList.add("map-highlight");
                window.setTimeout(() => card.classList.remove("map-highlight"), 1600);
              });
            } else if (point.previewKey != null) {
              marker.on("click", () => {
                const item = document.getElementById(`preview-${point.previewKey}`);
                const panel = document.getElementById("availability-preview");
                const target = item || panel;
                if (!target) return;
                target.scrollIntoView({ behavior: "smooth", block: "center" });
                target.classList.add("map-highlight");
                window.setTimeout(() => target.classList.remove("map-highlight"), 1600);
              });
            }

            bounds.push([point.lat, point.lng]);
          });

          if (bounds.length === 1) {
            map.setView(bounds[0], 15);
          } else {
            map.fitBounds(bounds, { padding: [28, 28] });
          }
        }
      }
    </script>
  </body>
</html>
