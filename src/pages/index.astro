---
import { sanityClient } from "sanity:client";
import { formatDateRange, formatMoney } from "../lib/hotelSearch";
import { getTripStatusInfo } from "../lib/itineraryLabels";
import { getTripStats } from "../lib/itineraryStats";

const query = `*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] | order(startDate asc) {
  title,
  "slug": slug.current,
  startDate,
  heroIntro,
  "heroImageUrl": heroImage.asset->url,
  sections[] {
    sectionTitle,
    places[] {
      category,
      coordinates,
      countAsStop,
      bookingLogistics,
      paymentStatus
    },
    foodShortlist[] {
      coordinates,
      bookingStatus
    }
  }
}`;

const hotelSearchesQuery = `*[_type == "hotelSearch" && (!defined(status) || status != "archived")] | order(metadata.searchedAt desc) {
  title,
  "slug": slug.current,
  status,
  search {
    location {
      label,
      country
    },
    dateRange {
      checkIn,
      checkOut,
      nights
    },
    budget {
      currency,
      targetPerNight,
      flexPerNight
    }
  },
  summary {
    headline
  },
  "hotelCount": count(hotels),
  "withinBudgetCount": count(hotels[price.budgetStatus == "within"]),
  "flexBudgetCount": count(hotels[price.budgetStatus == "flex"]),
  metadata {
    searchedAt
  }
}`;

const [trips, hotelSearches] = await Promise.all([
  sanityClient.fetch(query) as Promise<any[]>,
  sanityClient.fetch(hotelSearchesQuery) as Promise<any[]>,
]);

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  return new Date(`${dateString}T12:00:00`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const getDaysUntil = (dateString: string) => {
  if (!dateString) return null;

  const today = new Date();
  const target = new Date(`${dateString}T12:00:00`);
  today.setHours(12, 0, 0, 0);

  return Math.round((target.getTime() - today.getTime()) / 86400000);
};

const getTripStatus = (trip: any) => {
  const stats = getTripStats(trip);
  const daysUntil = getDaysUntil(trip.startDate);

  return getTripStatusInfo({ bookingActions: stats.bookingActions, daysUntil });
};

const plural = (count: number, singular: string, pluralLabel: string) => {
  return `${count} ${count === 1 ? singular : pluralLabel}`;
};

const getHotelSearchBudgetLabel = (search: any) => {
  const budget = search?.search?.budget || {};
  const currency = budget.currency || "GBP";
  const target = typeof budget.targetPerNight === "number" ? `${formatMoney(budget.targetPerNight, currency)} target` : "";
  const flex = typeof budget.flexPerNight === "number" ? `${formatMoney(budget.flexPerNight, currency)} flex` : "";

  return [target, flex].filter(Boolean).join(" / ");
};

const getDateContext = (trip: any) => {
  const daysUntil = getDaysUntil(trip.startDate);

  if (daysUntil === null) return "";
  if (daysUntil === 0) return "Starts today";
  if (daysUntil === 1) return "Starts tomorrow";
  if (daysUntil > 1) return `Starts in ${daysUntil} days`;
  if (daysUntil === -1) return "Started yesterday";

  return `Started ${Math.abs(daysUntil)} days ago`;
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Holiday Itineraries</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(219, 234, 254, 0.75), transparent 38rem),
          radial-gradient(circle at bottom right, rgba(220, 252, 231, 0.55), transparent 30rem),
          var(--page-bg);
      }

      .site-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.25rem;
        align-items: end;
        margin-bottom: 2.5rem;
      }

      .site-eyebrow {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .site-title {
        margin: 0;
        font-size: clamp(2.4rem, 7vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      .site-intro {
        max-width: 680px;
        margin: 1rem 0 0;
        color: #475569;
        font-size: 1.06rem;
        line-height: 1.6;
      }

      .site-actions {
        display: flex;
        gap: 0.65rem;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .site-action {
        display: inline-flex;
        align-items: center;
        min-height: 2.35rem;
        padding: 0.55rem 0.9rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .grid-directory {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.25rem;
      }

      .directory-section {
        margin-top: 3rem;
      }

      .directory-section:first-child {
        margin-top: 0;
      }

      .section-heading {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: end;
        margin-bottom: 1rem;
      }

      .section-heading h2 {
        margin: 0;
        color: var(--ink);
        font-size: 1.35rem;
        letter-spacing: -0.02em;
      }

      .section-heading p {
        margin: 0.35rem 0 0;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .directory-card {
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
      }

      .directory-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
      }

      .card-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        background: var(--soft-2);
      }

      .card-body {
        padding: 1.25rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }

      .card-topline {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.7rem;
      }

      .card-date {
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        min-height: 1.65rem;
        padding: 0.3rem 0.55rem;
        border-radius: 999px;
        background: var(--blue-bg);
        color: var(--blue-ink);
        font-size: 0.72rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .status-pill.open-actions {
        background: var(--amber-bg);
        color: var(--amber-ink);
      }

      .status-pill.coming-soon {
        background: var(--green-bg);
        color: var(--green-ink);
      }

      .status-pill.in-archive {
        background: var(--soft-2);
        color: var(--muted);
      }

      .card-title {
        margin: 0 0 0.65rem;
        color: var(--ink);
        font-size: 1.45rem;
        letter-spacing: -0.03em;
        line-height: 1.12;
      }

      .card-desc {
        margin: 0;
        color: #475569;
        font-size: 0.94rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .card-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 1rem;
      }

      .card-metric {
        display: inline-flex;
        align-items: center;
        min-height: 1.75rem;
        padding: 0.34rem 0.58rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: var(--soft-2);
        color: #334155;
        font-size: 0.75rem;
        font-weight: 800;
        white-space: nowrap;
      }

      .view-link {
        margin-top: auto;
        padding-top: 1.1rem;
        color: var(--blue-ink);
        font-size: 0.9rem;
        font-weight: 850;
      }

      .empty-state {
        padding: 3rem;
        border: 2px dashed var(--soft);
        border-radius: 20px;
        text-align: center;
        background: #fff;
      }

      @media (max-width: 720px) {
        body { padding: 1rem; }

        .site-header {
          grid-template-columns: 1fr;
          align-items: start;
        }

        .site-actions {
          justify-content: flex-start;
        }

        .section-heading {
          align-items: flex-start;
          flex-direction: column;
        }

        .grid-directory {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div>
        <p class="site-eyebrow">Travel plans</p>
        <h1 class="site-title">Holiday Itineraries</h1>
        <p class="site-intro">Upcoming trips, food shortlists, booking actions, maps, and the practical details that make each holiday easier to run.</p>
      </div>
      <nav class="site-actions" aria-label="Project shortcuts">
        <a class="site-action" href="/admin#/structure">Open CMS</a>
      </nav>
    </header>

    <main>
      <section class="directory-section" aria-labelledby="trip-directory-title">
        <div class="section-heading">
          <div>
            <h2 id="trip-directory-title">Trips</h2>
            <p>Confirmed and in-progress itinerary pages.</p>
          </div>
        </div>

        {trips && trips.length > 0 ? (
          <div class="grid-directory">
            {trips.map((trip) => {
              const stats = getTripStats(trip);
              const status = getTripStatus(trip);

              return (
                <a href={`/trips/${trip.slug}`} class="directory-card">
                  {trip.heroImageUrl && (
                    <img src={trip.heroImageUrl} alt="" class="card-image" loading="lazy" />
                  )}
                  <div class="card-body">
                    <div class="card-topline">
                      {trip.startDate && <div class="card-date">{formatDate(trip.startDate)}</div>}
                      <span class={`status-pill ${status.className}`}>{status.label}</span>
                    </div>
                    <h2 class="card-title">{trip.title}</h2>
                    {getDateContext(trip) && <p class="card-desc">{getDateContext(trip)}</p>}
                    {trip.heroIntro && <p class="card-desc">{trip.heroIntro}</p>}
                    <div class="card-metrics" aria-label={`${trip.title} quick stats`}>
                      <span class="card-metric">{plural(stats.sections, "section", "sections")}</span>
                      <span class="card-metric">{plural(stats.stops, "stop", "stops")}</span>
                      <span class="card-metric">{plural(stats.food, "food option", "food options")}</span>
                      <span class="card-metric">{stats.mapped} mapped</span>
                      {stats.bookingActions > 0 && <span class="card-metric">{plural(stats.bookingActions, "action", "actions")}</span>}
                    </div>
                    <div class="view-link">Open itinerary -></div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No visible itineraries yet</h2>
            <p style="color: var(--muted)">Add a trip in Sanity and set its visibility to show on website.</p>
          </div>
        )}
      </section>

      <section class="directory-section" aria-labelledby="hotel-search-directory-title">
        <div class="section-heading">
          <div>
            <h2 id="hotel-search-directory-title">Hotel Searches</h2>
            <p>Snapshot comparisons generated from a specific brief.</p>
          </div>
        </div>

        {hotelSearches && hotelSearches.length > 0 ? (
          <div class="grid-directory">
            {hotelSearches.map((search) => {
              const budgetLabel = getHotelSearchBudgetLabel(search);
              const dateLabel = formatDateRange(search.search?.dateRange);
              const locationLabel = [search.search?.location?.label, search.search?.location?.country].filter(Boolean).join(", ");

              return (
                <a href={`/hotel-searches/${search.slug}`} class="directory-card">
                  <div class="card-body">
                    <div class="card-topline">
                      <div class="card-date">{dateLabel || "Dates not set"}</div>
                      <span class="status-pill">{search.status || "completed"}</span>
                    </div>
                    <h2 class="card-title">{search.title}</h2>
                    {locationLabel && <p class="card-desc">{locationLabel}</p>}
                    {search.summary?.headline && <p class="card-desc">{search.summary.headline}</p>}
                    <div class="card-metrics" aria-label={`${search.title} hotel search stats`}>
                      <span class="card-metric">{plural(search.hotelCount || 0, "option", "options")}</span>
                      <span class="card-metric">{search.withinBudgetCount || 0} within target</span>
                      <span class="card-metric">{search.flexBudgetCount || 0} within flex</span>
                      {budgetLabel && <span class="card-metric">{budgetLabel}</span>}
                    </div>
                    <div class="view-link">Open comparison -></div>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <h2>No hotel searches yet</h2>
            <p style="color: var(--muted)">When Claude writes a hotelSearch document to Sanity, it will appear here.</p>
          </div>
        )}
      </section>
    </main>
  </body>
</html>
