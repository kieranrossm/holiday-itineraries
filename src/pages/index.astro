---
import { sanityClient } from "sanity:client";

const query = `*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] | order(startDate asc) {
  title,
  "slug": slug.current,
  startDate,
  heroIntro,
  "heroImageUrl": heroImage.asset->url
}`;

const trips = await sanityClient.fetch(query);

const formatDate = (dateString) => {
  if (!dateString) return "";
  return new Date(dateString).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Holiday Itineraries Hub</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-ink: #1d4ed8;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--ink);
        background: radial-gradient(circle at top left, rgba(219, 234, 254, 0.7), transparent 40rem), var(--page-bg);
      }

      .site-header { margin-bottom: 4rem; }
      .site-eyebrow { margin: 0 0 0.5rem; color: var(--muted); font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.14em; }
      .site-title { margin: 0; font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 0.95; letter-spacing: -0.07em; }
      .site-intro { max-width: 650px; margin: 1rem 0 0; color: var(--muted); font-size: 1.1rem; line-height: 1.6; }

      .grid-directory {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 2rem;
      }

      .directory-card {
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
      }

      .directory-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
      }

      .card-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background: var(--soft-2);
      }

      .card-body { padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column; }
      .card-date { font-size: 0.85rem; color: var(--muted); font-weight: 700; text-transform: uppercase; margin: 0 0 0.5rem; }
      .card-title { margin: 0 0 0.75rem; font-size: 1.5rem; tracking: -0.03em; line-height: 1.1; color: var(--ink); }
      .card-desc { margin: 0; color: #475569; font-size: 0.95rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      
      .view-link { margin-top: auto; padding-top: 1.25rem; font-weight: 700; color: var(--blue-ink); font-size: 0.9rem; display: flex; align-items: center; gap: 0.25rem; }

      .empty-state { padding: 3rem; border: 2px dashed var(--soft); border-radius: 24px; text-align: center; background: #fff; }

      @media (max-width: 640px) {
        body { padding: 1rem; }
        .grid-directory { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <p class="site-eyebrow">Manual travel plans</p>
      <h1 class="site-title">Holiday Itineraries</h1>
      <p class="site-intro">Select an isolated route schedule to review detailed timelines, chronological map tracking, and logical connection matrices.</p>
    </header>

    <main>
      {trips && trips.length > 0 ? (
        <div class="grid-directory">
          {trips.map((trip) => (
            <a href={`/trips/${trip.slug}`} class="directory-card">
              {trip.heroImageUrl && (
                <img src={trip.heroImageUrl} alt="" class="card-image" loading="lazy" />
              )}
              <div class="card-body">
                {trip.startDate && <div class="card-date">{formatDate(trip.startDate)}</div>}
                <h2 class="card-title">{trip.title}</h2>
                {trip.heroIntro && <p class="card-desc">{trip.heroIntro}</p>}
                <div class="view-link">View Itinerary →</div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>No Active Itineraries Located</h2>
          <p style="color: var(--muted)">Ensure itineraries are logged in your Sanity studio and configured as 'visible'.</p>
        </div>
      )}
    </main>
  </body>
</html>
