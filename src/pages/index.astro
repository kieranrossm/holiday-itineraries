---
import { sanityClient } from "sanity:client";

const query = `*[_type == "trip" && (!defined(displayStatus) || displayStatus == "visible")] | order(startDate asc) {
  title,
  "slug": slug.current,
  startDate,
  heroIntro,
  "heroImageUrl": heroImage.asset->url,
  sections[] {
    places[] {
      category,
      coordinates,
      countAsStop,
      bookingLogistics,
      paymentStatus
    },
    foodShortlist[] {
      coordinates,
      bookingStatus
    }
  }
}`;

const trips = await sanityClient.fetch(query);

const formatDate = (dateString) => {
  if (!dateString) return "";
  return new Date(`${dateString}T12:00:00`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};

const getDaysUntil = (dateString) => {
  if (!dateString) return null;

  const today = new Date();
  const target = new Date(`${dateString}T12:00:00`);
  today.setHours(12, 0, 0, 0);

  return Math.round((target.getTime() - today.getTime()) / 86400000);
};

const isTransitCategory = (category) => {
  return category === "Transport" || category === "Transit";
};

const countsAsStop = (place) => {
  if (place?.countAsStop === true) return true;
  if (place?.countAsStop === false) return false;

  return !isTransitCategory(place?.category);
};

const hasCoordinates = (item) => {
  return typeof item?.coordinates?.lat === "number" && typeof item?.coordinates?.lng === "number";
};

const getTripStats = (trip) => {
  const sections = trip.sections || [];
  const places = sections.flatMap((section) => section.places || []);
  const foods = sections.flatMap((section) => section.foodShortlist || []);
  const bookingActions = [
    ...places.filter((place) => place.bookingLogistics?.bookingStatus === "to-book"),
    ...foods.filter((food) => food.bookingStatus === "consider-booking"),
  ];
  const mappedItems = [
    ...places.filter(hasCoordinates),
    ...foods.filter(hasCoordinates),
  ];

  return {
    sections: sections.length,
    stops: places.filter(countsAsStop).length,
    food: foods.length,
    bookingActions: bookingActions.length,
    mapped: mappedItems.length,
  };
};

const getTripStatus = (trip) => {
  const stats = getTripStats(trip);
  const daysUntil = getDaysUntil(trip.startDate);

  if (stats.bookingActions > 0) return "Open actions";
  if (daysUntil !== null && daysUntil < 0) return "In archive";
  if (daysUntil !== null && daysUntil <= 30) return "Coming soon";

  return "Planning";
};

const plural = (count, singular, pluralLabel) => {
  return `${count} ${count === 1 ? singular : pluralLabel}`;
};

const getDateContext = (trip) => {
  const daysUntil = getDaysUntil(trip.startDate);

  if (daysUntil === null) return "";
  if (daysUntil === 0) return "Starts today";
  if (daysUntil === 1) return "Starts tomorrow";
  if (daysUntil > 1) return `Starts in ${daysUntil} days`;
  if (daysUntil === -1) return "Started yesterday";

  return `Started ${Math.abs(daysUntil)} days ago`;
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Holiday Itineraries</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
        --rose-bg: #ffe4e6;
        --rose-ink: #9f1239;
      }

      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(219, 234, 254, 0.75), transparent 38rem),
          radial-gradient(circle at bottom right, rgba(220, 252, 231, 0.55), transparent 30rem),
          var(--page-bg);
      }

      .site-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.25rem;
        align-items: end;
        margin-bottom: 2.5rem;
      }

      .site-eyebrow {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .site-title {
        margin: 0;
        font-size: clamp(2.4rem, 7vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.06em;
      }

      .site-intro {
        max-width: 680px;
        margin: 1rem 0 0;
        color: #475569;
        font-size: 1.06rem;
        line-height: 1.6;
      }

      .site-actions {
        display: flex;
        gap: 0.65rem;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .site-action {
        display: inline-flex;
        align-items: center;
        min-height: 2.35rem;
        padding: 0.55rem 0.9rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: #ffffff;
        color: var(--ink);
        text-decoration: none;
        font-size: 0.84rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .grid-directory {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 1.25rem;
      }

      .directory-card {
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
      }

      .directory-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
      }

      .card-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        background: var(--soft-2);
      }

      .card-body {
        padding: 1.25rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }

      .card-topline {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.7rem;
      }

      .card-date {
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        min-height: 1.65rem;
        padding: 0.3rem 0.55rem;
        border-radius: 999px;
        background: var(--blue-bg);
        color: var(--blue-ink);
        font-size: 0.72rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .status-pill.open-actions {
        background: var(--amber-bg);
        color: var(--amber-ink);
      }

      .status-pill.coming-soon {
        background: var(--green-bg);
        color: var(--green-ink);
      }

      .status-pill.in-archive {
        background: var(--soft-2);
        color: var(--muted);
      }

      .card-title {
        margin: 0 0 0.65rem;
        color: var(--ink);
        font-size: 1.45rem;
        letter-spacing: -0.03em;
        line-height: 1.12;
      }

      .card-desc {
        margin: 0;
        color: #475569;
        font-size: 0.94rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .card-metrics {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: 1rem;
      }

      .card-metric {
        display: inline-flex;
        align-items: center;
        min-height: 1.75rem;
        padding: 0.34rem 0.58rem;
        border: 1px solid var(--soft);
        border-radius: 999px;
        background: var(--soft-2);
        color: #334155;
        font-size: 0.75rem;
        font-weight: 800;
        white-space: nowrap;
      }

      .view-link {
        margin-top: auto;
        padding-top: 1.1rem;
        color: var(--blue-ink);
        font-size: 0.9rem;
        font-weight: 850;
      }

      .empty-state {
        padding: 3rem;
        border: 2px dashed var(--soft);
        border-radius: 20px;
        text-align: center;
        background: #fff;
      }

      @media (max-width: 720px) {
        body { padding: 1rem; }

        .site-header {
          grid-template-columns: 1fr;
          align-items: start;
        }

        .site-actions {
          justify-content: flex-start;
        }

        .grid-directory {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div>
        <p class="site-eyebrow">Travel plans</p>
        <h1 class="site-title">Holiday Itineraries</h1>
        <p class="site-intro">Upcoming trips, food shortlists, booking actions, maps, and the practical details that make each holiday easier to run.</p>
      </div>
      <nav class="site-actions" aria-label="Project shortcuts">
        <a class="site-action" href="/admin#/structure">Open CMS</a>
      </nav>
    </header>

    <main>
      {trips && trips.length > 0 ? (
        <div class="grid-directory">
          {trips.map((trip) => {
            const stats = getTripStats(trip);
            const status = getTripStatus(trip);
            const statusClass = status.toLowerCase().replace(/[^a-z0-9]+/g, "-");

            return (
              <a href={`/trips/${trip.slug}`} class="directory-card">
                {trip.heroImageUrl && (
                  <img src={trip.heroImageUrl} alt="" class="card-image" loading="lazy" />
                )}
                <div class="card-body">
                  <div class="card-topline">
                    {trip.startDate && <div class="card-date">{formatDate(trip.startDate)}</div>}
                    <span class={`status-pill ${statusClass}`}>{status}</span>
                  </div>
                  <h2 class="card-title">{trip.title}</h2>
                  {getDateContext(trip) && <p class="card-desc">{getDateContext(trip)}</p>}
                  {trip.heroIntro && <p class="card-desc">{trip.heroIntro}</p>}
                  <div class="card-metrics" aria-label={`${trip.title} quick stats`}>
                    <span class="card-metric">{plural(stats.sections, "section", "sections")}</span>
                    <span class="card-metric">{plural(stats.stops, "stop", "stops")}</span>
                    <span class="card-metric">{plural(stats.food, "food option", "food options")}</span>
                    <span class="card-metric">{stats.mapped} mapped</span>
                    {stats.bookingActions > 0 && <span class="card-metric">{plural(stats.bookingActions, "action", "actions")}</span>}
                  </div>
                  <div class="view-link">Open itinerary -></div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="empty-state">
          <h2>No visible itineraries yet</h2>
          <p style="color: var(--muted)">Add a trip in Sanity and set its visibility to show on website.</p>
        </div>
      )}
    </main>
  </body>
</html>
