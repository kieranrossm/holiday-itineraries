---
import { sanityClient } from "sanity:client";

const query = `*[_type == "trip"] | order(startDate asc) {
  title,
  startDate,
  sections[] {
    sectionTitle,
    sectionIntro,
    layoutStyle,
    places[] {
      placeName,
      time,
      endTime,
      category,
      area,
      shortDescription,
      info,
      practicalInfo,
      priceGuide,
      bookingRequired,
      bookingUrl,
      websiteUrl,
      travelNote,
      "photoUrl": photo.asset->url
    }
  }
}`;

const trips = await sanityClient.fetch(query);

const formatDate = (dateString) => {
  if (!dateString) return "";

  return new Date(dateString).toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Holiday Itineraries</title>

    <style>
      :root {
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --ink: #111827;
        --muted: #64748b;
        --soft: #e2e8f0;
        --soft-2: #f1f5f9;
        --blue-bg: #dbeafe;
        --blue-ink: #1d4ed8;
        --amber-bg: #fef3c7;
        --amber-ink: #92400e;
        --green-bg: #dcfce7;
        --green-ink: #166534;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(219, 234, 254, 0.7), transparent 30rem),
          var(--page-bg);
      }

      main {
        display: flex;
        flex-direction: column;
        gap: 5rem;
      }

      .site-header {
        margin-bottom: 3rem;
      }

      .site-eyebrow {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.14em;
      }

      .site-title {
        margin: 0;
        font-size: clamp(2.4rem, 7vw, 5rem);
        line-height: 0.95;
        letter-spacing: -0.07em;
      }

      .site-intro {
        max-width: 700px;
        margin: 1rem 0 0;
        color: var(--muted);
        font-size: 1.1rem;
        line-height: 1.7;
      }

      .trip-wrapper {
        padding-bottom: 4rem;
        border-bottom: 4px dashed var(--soft);
      }

      .trip-wrapper:last-child {
        border-bottom: none;
      }

      .trip-header {
        margin-bottom: 3rem;
        padding: 1.5rem;
        border: 1px solid var(--soft);
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);
        backdrop-filter: blur(10px);
      }

      .trip-header h1 {
        margin: 0 0 0.75rem;
        font-size: clamp(2.1rem, 6vw, 4.2rem);
        line-height: 0.98;
        letter-spacing: -0.06em;
      }

      .trip-date {
        margin: 0;
        color: var(--muted);
        font-weight: 650;
      }

      .section-container {
        margin-bottom: 4rem;
      }

      .section-container:last-child {
        margin-bottom: 0;
      }

      .section-header {
        margin-bottom: 1.5rem;
      }

      .section-header h2 {
        margin: 0 0 0.5rem;
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        line-height: 1;
        letter-spacing: -0.04em;
      }

      .section-header p {
        max-width: 760px;
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .places-container {
        width: 100%;
      }

      .place-card {
        position: relative;
        background: var(--card-bg);
        border: 1px solid var(--soft);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
      }

      .place-image {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        display: block;
        background: var(--soft-2);
      }

      .place-content {
        padding: 1.25rem;
      }

      .place-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }

      .time-badge,
      .category-badge,
      .area-badge {
        display: inline-flex;
        align-items: center;
        width: fit-content;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1.1;
      }

      .time-badge {
        background: var(--blue-bg);
        color: var(--blue-ink);
      }

      .category-badge {
        background: var(--amber-bg);
        color: var(--amber-ink);
      }

      .area-badge {
        background: var(--green-bg);
        color: var(--green-ink);
      }

      .place-card h3 {
        margin: 0.5rem 0;
        font-size: 1.25rem;
        line-height: 1.2;
        letter-spacing: -0.025em;
      }

      .short-description {
        margin: 0.55rem 0;
        color: var(--ink);
        font-weight: 680;
        line-height: 1.55;
      }

      .place-info {
        margin: 0.75rem 0 0;
        color: #475569;
        line-height: 1.65;
        white-space: pre-line;
      }

      .detail-list {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--soft);
      }

      .detail-list p {
        margin: 0.45rem 0;
        color: #475569;
        line-height: 1.55;
      }

      .place-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
      }

      .place-links a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.6rem 0.95rem;
        border-radius: 999px;
        background: var(--ink);
        color: #ffffff;
        text-decoration: none;
        font-weight: 800;
        font-size: 0.9rem;
      }

      .place-links a:hover {
        background: #334155;
      }

      .layout-grid .places-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
        gap: 1.5rem;
      }

      .layout-timeline .places-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        border-left: 3px solid #cbd5e1;
        padding-left: 2rem;
        margin-left: 1rem;
      }

      .layout-timeline .place-card::before {
        content: "";
        position: absolute;
        left: -2.6rem;
        top: 1.5rem;
        width: 1rem;
        height: 1rem;
        background: #3b82f6;
        border-radius: 50%;
        border: 4px solid var(--page-bg);
      }

      .empty-state {
        max-width: 680px;
        padding: 2rem;
        border: 1px solid var(--soft);
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
      }

      .empty-state h1 {
        margin-top: 0;
      }

      @media (max-width: 720px) {
        body {
          padding: 1rem;
        }

        main {
          gap: 3rem;
        }

        .site-header {
          margin-bottom: 2rem;
        }

        .trip-header {
          padding: 1.1rem;
          border-radius: 18px;
        }

        .layout-grid .places-container {
          grid-template-columns: 1fr;
        }

        .layout-timeline .places-container {
          margin-left: 0.5rem;
          padding-left: 1.5rem;
        }

        .layout-timeline .place-card::before {
          left: -2.1rem;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <p class="site-eyebrow">Manual travel plans</p>
      <h1 class="site-title">Holiday Itineraries</h1>
      <p class="site-intro">
        Rich trip notes, day plans, places to eat, big hitters, side quests and useful travel details.
      </p>
    </header>

    {trips && trips.length > 0 ? (
      <main>
        {trips.map((trip) => (
          <article class="trip-wrapper">
            <header class="trip-header">
              <h1>{trip.title}</h1>

              {trip.startDate && (
                <p class="trip-date">
                  <strong>Departure:</strong> {formatDate(trip.startDate)}
                </p>
              )}
            </header>

            {trip.sections && trip.sections.map((section) => (
              <section class={`section-container layout-${section.layoutStyle || "timeline"}`}>
                <header class="section-header">
                  <h2>{section.sectionTitle}</h2>
                  {section.sectionIntro && <p>{section.sectionIntro}</p>}
                </header>

                {section.places && section.places.length > 0 && (
                  <div class="places-container">
                    {section.places.map((place) => (
                      <article class="place-card">
                        {place.photoUrl && (
                          <img
                            src={place.photoUrl}
                            alt={place.placeName}
                            class="place-image"
                            loading="lazy"
                          />
                        )}

                        <div class="place-content">
                          <div class="place-meta">
                            {place.time && (
                              <span class="time-badge">
                                {place.time}{place.endTime ? ` - ${place.endTime}` : ""}
                              </span>
                            )}

                            {place.category && (
                              <span class="category-badge">{place.category}</span>
                            )}

                            {place.area && (
                              <span class="area-badge">{place.area}</span>
                            )}
                          </div>

                          <h3>{place.placeName}</h3>

                          {place.shortDescription && (
                            <p class="short-description">{place.shortDescription}</p>
                          )}

                          {place.info && (
                            <p class="place-info">{place.info}</p>
                          )}

                          {(place.priceGuide ||
                            place.practicalInfo ||
                            place.travelNote ||
                            place.bookingRequired) && (
                            <div class="detail-list">
                              {place.priceGuide && (
                                <p><strong>Price:</strong> {place.priceGuide}</p>
                              )}

                              {place.practicalInfo && (
                                <p><strong>Good to know:</strong> {place.practicalInfo}</p>
                              )}

                              {place.travelNote && (
                                <p><strong>Getting there:</strong> {place.travelNote}</p>
                              )}

                              {place.bookingRequired && (
                                <p><strong>Booking:</strong> Recommended</p>
                              )}
                            </div>
                          )}

                          {(place.bookingUrl || place.websiteUrl) && (
                            <div class="place-links">
                              {place.bookingUrl && (
                                <a href={place.bookingUrl} target="_blank" rel="noreferrer">
                                  Book
                                </a>
                              )}

                              {place.websiteUrl && (
                                <a href={place.websiteUrl} target="_blank" rel="noreferrer">
                                  Website
                                </a>
                              )}
                            </div>
                          )}
                        </div>
                      </article>
                    ))}
                  </div>
                )}
              </section>
            ))}
          </article>
        ))}
      </main>
    ) : (
      <main>
        <section class="empty-state">
          <h1>No Data Found</h1>
          <p>Ensure you have published a trip document in the Sanity admin dashboard.</p>
        </section>
      </main>
    )}
  </body>
</html>
